FROM oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6 AS web-builder

ARG NEW_API_SOURCE_URL=https://codeload.github.com/QuantumNous/new-api/tar.gz/refs/tags/v1.0.0-rc.41
ARG NEW_API_SOURCE_SHA256

WORKDIR /build
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*
RUN test -n "$NEW_API_SOURCE_SHA256" \
    && wget -q "$NEW_API_SOURCE_URL" -O new-api.tar.gz \
    && echo "$NEW_API_SOURCE_SHA256  new-api.tar.gz" | sha256sum -c - \
    && mkdir source \
    && tar -xzf new-api.tar.gz -C source --strip-components=1

WORKDIR /build/source/web
RUN bun install --frozen-lockfile
COPY brand/home.tsx ./src/features/home/index.tsx
COPY brand/auth-layout.tsx ./src/features/auth/auth-layout.tsx
COPY brand/auth-layout.test.tsx ./src/features/auth/__tests__/pikno-auth-layout.test.tsx
COPY brand/root-route.tsx ./src/routes/index.tsx
COPY brand/entry.test.ts ./src/routes/__tests__/-pikno-entry.test.ts
COPY brand/about.tsx ./src/features/about/index.tsx
COPY brand/pikno-brand.css ./src/styles/pikno-brand.css
COPY brand/apply-brand.mjs ./scripts/apply-brand.mjs
COPY brand/pikno-logo.png ./public/pikno-logo.png
RUN mkdir -p public/open-source \
    && cp ../LICENSE public/open-source/LICENSE.txt \
    && cp ../NOTICE public/open-source/NOTICE.txt \
    && cp ../THIRD-PARTY-LICENSES.md public/open-source/THIRD-PARTY-LICENSES.txt
RUN bun scripts/apply-brand.mjs
COPY brand/apply-fixed-cny.mjs ./scripts/apply-fixed-cny.mjs
COPY brand/fixed-cny.ts ./src/features/wallet/lib/fixed-cny.ts
COPY brand/fixed-cny.test.tsx ./src/features/wallet/__tests__/fixed-cny.test.tsx
RUN bun scripts/apply-fixed-cny.mjs /build/source
RUN bunx oxfmt --write src/features/wallet/components/recharge-form-card.tsx src/features/wallet/components/dialogs/payment-confirm-dialog.tsx src/features/wallet/components/dialogs/billing-history-dialog.tsx src/features/wallet/hooks/use-payment.ts src/features/wallet/hooks/use-topup-info.ts src/features/wallet/index.tsx src/features/wallet/lib/fixed-cny.ts src/features/wallet/types.ts src/features/wallet/__tests__/fixed-cny.test.tsx
RUN bunx oxfmt --check src/features/wallet/components/recharge-form-card.tsx src/features/wallet/components/dialogs/payment-confirm-dialog.tsx src/features/wallet/components/dialogs/billing-history-dialog.tsx src/features/wallet/hooks/use-payment.ts src/features/wallet/hooks/use-topup-info.ts src/features/wallet/index.tsx src/features/wallet/lib/fixed-cny.ts src/features/wallet/types.ts src/features/wallet/__tests__/fixed-cny.test.tsx
RUN DISABLE_ESLINT_PLUGIN='true' VITE_REACT_APP_VERSION=v1.0.0-rc.41-pikno.7 bun run build
RUN bun run typecheck && bun run test src/routes/__tests__/-pikno-entry.test.ts src/features/auth/__tests__/pikno-auth-layout.test.tsx
RUN bun run test src/features/wallet/__tests__/fixed-cny.test.tsx
RUN bunx oxlint -c .oxlintrc.json src/features/wallet/components/recharge-form-card.tsx src/features/wallet/components/dialogs/payment-confirm-dialog.tsx src/features/wallet/components/dialogs/billing-history-dialog.tsx src/features/wallet/hooks/use-payment.ts src/features/wallet/hooks/use-topup-info.ts src/features/wallet/index.tsx src/features/wallet/lib/fixed-cny.ts src/features/wallet/types.ts
RUN rm -rf node_modules

FROM golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS go-builder
ENV GO111MODULE=on CGO_ENABLED=0 GOWORK=off GOOS=linux GOARCH=amd64 GOEXPERIMENT=greenteagc

WORKDIR /build
COPY --from=web-builder /build/source/go.mod /build/source/go.sum ./
COPY --from=web-builder /build/source/relaykit/go.mod ./relaykit/go.mod
RUN go mod download
COPY --from=web-builder /build/source ./
COPY --from=web-builder /build/source/web/dist ./web/dist
COPY brand/pikno_fixed_cny.go ./controller/pikno_fixed_cny.go
COPY brand/pikno_fixed_cny_test.go ./controller/pikno_fixed_cny_test.go
COPY brand/pikno_topup_snapshot.go ./model/pikno_topup_snapshot.go
RUN gofmt -w controller/topup.go controller/pikno_fixed_cny.go controller/pikno_fixed_cny_test.go model/topup.go model/pikno_topup_snapshot.go
RUN --mount=type=cache,target=/root/.cache/go-build go test ./controller -run '^TestPiknoFixedCNY$' -count=1
RUN --mount=type=cache,target=/root/.cache/go-build go build -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=v1.0.0-rc.41-pikno.7'" -o new-api

FROM debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata libasan8 wget \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

COPY --from=go-builder /build/new-api /
COPY --from=web-builder /build/source/LICENSE /build/source/NOTICE /build/source/THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]
