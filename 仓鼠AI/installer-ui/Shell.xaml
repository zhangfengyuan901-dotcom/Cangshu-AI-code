<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="仓鼠AI 安装" Width="960" Height="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#243B32"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#16775D" />
    <SolidColorBrush x:Key="AccentHover" Color="#10674F" />
    <SolidColorBrush x:Key="AccentPressed" Color="#0B5944" />
    <SolidColorBrush x:Key="Muted" Color="#66786B" />
    <SolidColorBrush x:Key="Line" Color="#E2EAE5" />

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="22,0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="FocusRing" Margin="-4" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent" />
              <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentHover}" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentPressed}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="#73B7A1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#536A5F" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" CornerRadius="9" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#F1F6F3" />
                <Setter TargetName="Surface" Property="BorderBrush" Value="#C9DCD1" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#E6F0EA" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#718279" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="19" />
    </Style>

    <Style x:Key="QuietLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LineHeight" Value="43" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="#213B2F" />
    </Style>

    <Style x:Key="ProgressTrack" TargetType="ProgressBar">
      <Setter Property="Height" Value="6" />
      <Setter Property="Background" Value="#E4EDE7" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True">
              <Border CornerRadius="3" Background="{TemplateBinding Background}" />
              <Border x:Name="PART_Track" Background="Transparent">
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
              </Border>
              <Border x:Name="MovingIndicator" Visibility="Collapsed" Width="124" HorizontalAlignment="Left" CornerRadius="3" Background="{TemplateBinding Foreground}">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="MovingTransform" X="-124" />
                </Border.RenderTransform>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="MovingIndicator" Property="Visibility" Value="Visible" />
                <Trigger.EnterActions>
                  <BeginStoryboard x:Name="ProgressMotion">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="MovingTransform" Storyboard.TargetProperty="X" From="-124" To="520" Duration="0:0:1.7" RepeatBehavior="Forever" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <RemoveStoryboard BeginStoryboardName="ProgressMotion" />
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Border CornerRadius="22" Background="White" IsHitTestVisible="False">
      <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.13" Color="#173B2C" /></Border.Effect>
    </Border>
    <Border x:Name="Shell" CornerRadius="22" Background="White" BorderBrush="#E1E8E3" BorderThickness="1" RenderOptions.ClearTypeHint="Enabled">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

      <Border Grid.Column="0" CornerRadius="21,0,0,21" ClipToBounds="True">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#173F34" Offset="0" />
            <GradientStop Color="#1C5142" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid Margin="30,29,30,27">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="11" Background="#F5FAF6">
              <Image x:Name="BrandLogo" Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="仓鼠AI" />
            </Border>
            <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
              <TextBlock Text="仓鼠AI" FontSize="22" FontWeight="SemiBold" Foreground="White" />
              <TextBlock Text="桌面创作工作台" FontSize="10" Margin="1,3,0,0" Foreground="#A6C7B5" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,39,0,0">
            <TextBlock Text="让灵感，" FontSize="26" FontWeight="Light" Foreground="#F5FAF6" />
            <TextBlock Text="自然发生。" FontSize="26" FontWeight="Light" Margin="0,5,0,0" Foreground="#F5FAF6" />
            <TextBlock Text="对话 · 生成 · 画布" FontSize="12" Margin="2,19,0,0" Foreground="#ADCEBB" />
          </StackPanel>

          <Viewbox Grid.Row="2" Stretch="Uniform" Margin="-7,23,-12,18" VerticalAlignment="Center" IsHitTestVisible="False">
            <Canvas Width="260" Height="208">
              <Ellipse Width="204" Height="138" Fill="#0DFFFFFF" Canvas.Left="25" Canvas.Top="37" />
              <Border Width="202" Height="142" CornerRadius="14" Background="#376E59" BorderBrush="#538F72" BorderThickness="1" Canvas.Left="24" Canvas.Top="29" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="-10" /></Border.RenderTransform>
              </Border>
              <Border Width="208" Height="146" CornerRadius="14" Background="#F3F8F2" Canvas.Left="27" Canvas.Top="24">
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="8" Opacity="0.17" Color="#08271B" /></Border.Effect>
                <Grid Margin="13">
                  <Grid.RowDefinitions><RowDefinition Height="13" /><RowDefinition Height="*" /><RowDefinition Height="13" /></Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <Ellipse Width="4" Height="4" Fill="#91A999" />
                    <Ellipse Width="4" Height="4" Fill="#BECBC1" Margin="4,0,0,0" />
                    <Ellipse Width="4" Height="4" Fill="#D6DED8" Margin="4,0,0,0" />
                    <Border Width="45" Height="3" CornerRadius="1.5" Background="#D8E2DA" Margin="103,0,0,0" />
                  </StackPanel>
                  <Border Grid.Row="1" CornerRadius="8" Background="#DEEADC" ClipToBounds="True">
                    <Canvas>
                      <Ellipse Width="29" Height="29" Fill="#EAF1DD" Canvas.Left="119" Canvas.Top="14" />
                      <Path Data="M-5,91 C25,46 53,41 80,69 C99,32 124,30 153,65 C169,55 183,61 198,80 L198,110 L-5,110 Z" Fill="#A9C7AE" />
                      <Path Data="M-5,92 C28,69 51,74 77,92 C108,56 144,60 193,90 L193,110 L-5,110 Z" Fill="#78A58B" />
                    </Canvas>
                  </Border>
                  <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Border Width="68" Height="3" CornerRadius="1.5" Background="#BDCFBF" />
                    <Border Width="27" Height="3" CornerRadius="1.5" Background="#D9E3DB" Margin="7,0,0,0" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Width="91" Height="62" CornerRadius="12" Background="White" BorderBrush="#EDF3ED" BorderThickness="1" Canvas.Left="154" Canvas.Top="138" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><RotateTransform Angle="5" /></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.14" Color="#08271B" /></Border.Effect>
                <Grid>
                  <Path Data="M19,31 L29,31 M24,26 L24,36" Stroke="#87AB95" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  <Path Data="M42,31 L50,31" Stroke="#B7CEC0" StrokeThickness="1.5" />
                  <Border Width="18" Height="18" CornerRadius="5" Background="#E4F0E6" Margin="46,0,0,0">
                    <Path Data="M5,9 L8,12 L13,6" Stroke="#26785B" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  </Border>
                </Grid>
              </Border>
              <Path Data="M15,15 L15,25 M10,20 L20,20" Stroke="#8DB99C" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              <Ellipse Width="4" Height="4" Stroke="#80AC90" StrokeThickness="1" Canvas.Left="241" Canvas.Top="80" />
            </Canvas>
          </Viewbox>

          <StackPanel Grid.Row="3">
            <Border Height="1" Background="#365F4D" Margin="0,0,0,17" />
            <TextBlock Text="把专注，留给创作。" FontSize="12" Foreground="#BDD5C5" />
            <TextBlock Text="仓鼠AI · 桌面创作空间" FontSize="10" Foreground="#7EAA92" Margin="0,8,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="Transparent" Margin="8,9,16,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="−" ToolTip="最小化" AutomationProperties.Name="最小化" KeyboardNavigation.TabIndex="20" />
            <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Content="×" Margin="3,0,0,0" ToolTip="关闭" AutomationProperties.Name="关闭安装器" KeyboardNavigation.TabIndex="21" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="40,5,40,32">
          <Grid x:Name="PageReady">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="#EDF5EF" CornerRadius="6" Padding="9,4" HorizontalAlignment="Left">
              <TextBlock x:Name="VersionText" Text="版本 1.7.86" FontFamily="Segoe UI" FontSize="11" Foreground="#52745F" />
            </Border>
            <TextBlock x:Name="ReadyTitle" Grid.Row="1" Style="{StaticResource Heading}" Text="创作，从这里开始" Margin="0,20,0,8" />
            <TextBlock x:Name="ReadySubtitle" Grid.Row="2" Text="安装仓鼠AI，把想法变成作品。" Foreground="#66786B" FontSize="14" LineHeight="23" TextWrapping="Wrap" />

            <Grid Grid.Row="3" Margin="0,23,0,20" VerticalAlignment="Top">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Border Width="26" Height="26" Background="#F0F5F1" CornerRadius="7">
                  <Path Data="M7,7 L19,7 L19,16 L13,16 L9,19 L9,16 L7,16 Z" Stroke="#6B9880" StrokeThickness="1.3" StrokeLineJoin="Round" />
                </Border>
                <TextBlock Text="灵感对话" FontSize="11" Foreground="#61776A" Margin="7,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="26" Height="26" Background="#F0F5F1" CornerRadius="7">
                  <Path Data="M7,7 L19,7 L19,19 L7,19 Z M8,17 L12,13 L15,16 L18,12" Stroke="#6B9880" StrokeThickness="1.3" StrokeLineJoin="Round" />
                </Border>
                <TextBlock Text="图像视频" FontSize="11" Foreground="#61776A" Margin="7,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Width="26" Height="26" Background="#F0F5F1" CornerRadius="7">
                  <Path Data="M6,8 L12,8 L12,14 L6,14 Z M15,13 L21,13 L21,19 L15,19 Z M12,11 L17,11 L17,13" Stroke="#6B9880" StrokeThickness="1.3" StrokeLineJoin="Round" />
                </Border>
                <TextBlock Text="创作画布" FontSize="11" Foreground="#61776A" Margin="7,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>

            <StackPanel Grid.Row="4">
              <TextBlock Text="安装位置" Foreground="#526B5B" FontSize="12" Margin="0,0,0,9" />
              <Border CornerRadius="9" Background="#F8FAF8" BorderBrush="#E0E8E1" BorderThickness="1" Padding="10,5,5,5">
                <Border.Style>
                  <Style TargetType="Border"><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#74AA8B" /></Trigger></Style.Triggers></Style>
                </Border.Style>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="DirectoryBox" Background="Transparent" BorderThickness="0" Padding="2,7" VerticalContentAlignment="Center" FontSize="12" Foreground="#415D4B" SelectionBrush="#BBD6C5" CaretBrush="#16775D" KeyboardNavigation.TabIndex="0" AutomationProperties.Name="安装位置" AutomationProperties.HelpText="选择或输入仓鼠AI的安装目录" />
                  <Button x:Name="BrowseButton" Grid.Column="1" Content="更改" Height="34" Padding="13,0" Margin="8,0,0,0" FontSize="12" Style="{StaticResource SecondaryButton}" KeyboardNavigation.TabIndex="1" AutomationProperties.Name="更改安装位置" />
                </Grid>
              </Border>
            </StackPanel>
            <TextBlock x:Name="InstallInfo" Grid.Row="5" Style="{StaticResource QuietLabel}" Text="离线完成安装 · 自动创建快捷方式" TextWrapping="Wrap" Margin="0,9,0,17" />
            <TextBlock x:Name="ReadyError" Grid.Row="6" Visibility="Collapsed" Foreground="#AF6550" FontSize="12" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,10" />
            <Button x:Name="StartButton" Grid.Row="7" Content="安装仓鼠AI" Style="{StaticResource PrimaryButton}" IsDefault="True" KeyboardNavigation.TabIndex="2" />
          </Grid>

          <Grid x:Name="PageInstalling" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="正在安装" FontSize="12" Foreground="#649376" Margin="0,6,0,20" />
            <StackPanel Grid.Row="1">
              <TextBlock Style="{StaticResource Heading}" Text="准备你的创作空间" />
              <TextBlock Text="一切就绪后，即可开启新的创作。" Foreground="#66786B" FontSize="13" Margin="0,11,0,0" />
            </StackPanel>
            <Border Grid.Row="2" Background="#F7FAF7" BorderBrush="#E9EFE9" BorderThickness="1" CornerRadius="14" Padding="20,16" Margin="0,27,0,28" VerticalAlignment="Center">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="43" /><RowDefinition Height="43" /><RowDefinition Height="43" /></Grid.RowDefinitions>
                <Border Width="22" Height="22" CornerRadius="11" Background="#E7F0E8" VerticalAlignment="Center"><TextBlock Text="1" FontFamily="Segoe UI" FontSize="11" Foreground="#739981" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock x:Name="StepPrepare" Grid.Column="1" Text="准备安装文件" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#67816F" />
                <Border Grid.Row="1" Width="22" Height="22" CornerRadius="11" Background="#E7F0E8" VerticalAlignment="Center"><TextBlock Text="2" FontFamily="Segoe UI" FontSize="11" Foreground="#739981" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock x:Name="StepInstall" Grid.Row="1" Grid.Column="1" Text="安装主程序" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#67816F" />
                <Border Grid.Row="2" Width="22" Height="22" CornerRadius="11" Background="#E7F0E8" VerticalAlignment="Center"><TextBlock Text="3" FontFamily="Segoe UI" FontSize="11" Foreground="#739981" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock x:Name="StepRuntime" Grid.Row="2" Grid.Column="1" Text="配置工作台环境" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#67816F" />
              </Grid>
            </Border>
            <TextBlock x:Name="StageText" Grid.Row="3" Text="正在准备安装文件…" FontSize="13" Foreground="#466650" Margin="0,0,0,13" TextWrapping="Wrap" />
            <ProgressBar x:Name="ProgressBar" Grid.Row="4" Style="{StaticResource ProgressTrack}" Minimum="0" Maximum="100" Value="0" />
            <StackPanel Grid.Row="5" Margin="0,10,0,0">
              <TextBlock x:Name="ProgressCaption" Text="请保持安装窗口打开" Style="{StaticResource QuietLabel}" TextWrapping="Wrap" />
              <TextBlock x:Name="InstallStatusHint" Text="安装过程保持离线，请稍候。" FontSize="11" Foreground="#66786B" Margin="0,13,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <Grid x:Name="PageComplete" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,0,24">
              <Border Width="60" Height="60" CornerRadius="30" Background="#EDF6EF" HorizontalAlignment="Left" Margin="0,0,0,24">
                <Path Data="M18,30 L26,38 L43,21" Stroke="#2F8B60" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Border>
              <TextBlock x:Name="FinishTitle" Text="安装完成" Style="{StaticResource Heading}" />
              <TextBlock x:Name="FinishSubtitle" Text="仓鼠AI已准备就绪，开始你的下一次创作。" Foreground="#66786B" FontSize="14" LineHeight="24" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
              <Button x:Name="LaunchButton" Content="立即启动仓鼠AI" Style="{StaticResource PrimaryButton}" IsDefault="True" KeyboardNavigation.TabIndex="0" />
              <Button x:Name="DoneButton" Grid.Column="2" Content="完成" Height="48" Style="{StaticResource SecondaryButton}" KeyboardNavigation.TabIndex="1" />
            </Grid>
          </Grid>

          <Grid x:Name="PageError" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,0,22">
              <Border Width="60" Height="60" CornerRadius="30" Background="#FBF0E9" HorizontalAlignment="Left" Margin="0,0,0,24">
                <TextBlock Text="!" FontFamily="Segoe UI" FontSize="30" FontWeight="Light" Foreground="#B77B57" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
              </Border>
              <TextBlock x:Name="ErrorTitle" Text="安装未完成" Style="{StaticResource Heading}" />
              <TextBlock x:Name="ErrorText" Text="请检查安装位置与磁盘空间后重新尝试。" Foreground="#66786B" FontSize="14" TextWrapping="Wrap" LineHeight="24" Margin="0,12,0,0" />
              <TextBlock Text="个人设置与已有作品会保留。" FontSize="12" Foreground="#66786B" TextWrapping="Wrap" Margin="0,22,0,0" />
            </StackPanel>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
              <Button x:Name="RetryButton" Content="重新尝试" Style="{StaticResource PrimaryButton}" IsDefault="True" KeyboardNavigation.TabIndex="0" />
              <Button x:Name="ErrorCloseButton" Grid.Column="2" Content="关闭安装器" Height="48" Style="{StaticResource SecondaryButton}" KeyboardNavigation.TabIndex="1" />
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
    </Border>
  </Grid>
</Window>
