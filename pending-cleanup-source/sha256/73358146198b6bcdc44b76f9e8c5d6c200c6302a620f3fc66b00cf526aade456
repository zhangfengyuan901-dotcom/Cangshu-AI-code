'use strict';
const fs=require('node:fs'),path=require('node:path'),assert=require('node:assert/strict');
const root=__dirname,baseline=path.resolve(root,'../browser-shell-1.7.80-current');
assert(fs.existsSync(path.join(baseline,'verification.json')));
for(const name of ['dev','source','resource-inputs','build-inputs']){
 const target=path.join(root,name);assert(!fs.existsSync(target));
 fs.cpSync(path.join(baseline,name),target,{recursive:true,filter:source=>{
  if(fs.lstatSync(source).isSymbolicLink())return false;
  const relative=path.relative(path.join(baseline,name),source).split(path.sep);
  return !relative.includes('node_modules')||name==='source';
 }});
}
const replace=value=>typeof value==='string'?value.replaceAll(baseline,root):Array.isArray(value)?value.map(replace):value&&typeof value==='object'?Object.fromEntries(Object.entries(value).map(([k,v])=>[k,replace(v)])):value;
const config=replace(JSON.parse(fs.readFileSync(path.join(baseline,'builder.json'),'utf8')));
fs.writeFileSync(path.join(root,'builder.json'),JSON.stringify(config,null,2)+'\n');
for(const name of ['stage-candidate.cjs','verify-package.cjs','qa-helpers.cjs','qa-installed.cjs','qa-installation.ps1','node-failure-audit-reporter.cjs']){
 const contents=fs.readFileSync(path.join(baseline,name),'utf8').replaceAll('1.7.80','1.7.81');
 fs.writeFileSync(path.join(root,name),contents);
}
for(const name of ['node_modules','canvas/node_modules','build/hypit-host/node_modules']){
 const original=path.join(baseline,'dev',name),target=path.join(root,'dev',name);
 assert(fs.existsSync(original));fs.mkdirSync(path.dirname(target),{recursive:true});
 fs.symlinkSync(fs.realpathSync(original),target,'junction');
}
console.log(JSON.stringify({version:'1.7.81',baseline:'1.7.80',isolated:true}));
