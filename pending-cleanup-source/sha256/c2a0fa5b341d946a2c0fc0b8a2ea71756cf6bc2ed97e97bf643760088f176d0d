import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs';
import vm from 'node:vm';
import {quoteValid} from '../public/canvas-pricing.mjs';

const source=fs.readFileSync(new URL('../canvas/src/main.jsx',import.meta.url),'utf8');
const section=(start,end)=>source.slice(source.indexOf(start),source.indexOf(end,source.indexOf(start)));
const functions=section('const isInsufficientBalance=','function canvasPreview(')
  +section('  function chooseModel(','  function nodeQuote(')
  +section('  async function requestQuote(','  useEffect(()=>{const clock=')
  +section('  function executionQuoteCurrent(','  function job(');
const flush=async()=>{for(let i=0;i<20;i++)await Promise.resolve();};
function fixture({execute=()=>({}),runs=[]}={}){
  const document={id:'project',nodes:[{id:'node',type:'generation',data:{channel:'main',model:'a',options:{}}}],runs:[]},calls=[],saved=[],messages=[],notices=[];
  const models={main:[{id:'a'},{id:'b'}]},states={},requests=new Map();let resolve,reject;
  const pending=new Promise((done,fail)=>{resolve=done;reject=fail;});
  const relayState={current:{revision:1,relayMode:true}};
  const context={models,current:{current:document},assetRef:{current:[]},relayState,quoteRequests:{current:requests},quoteStates:{current:states},
    submittedRuns:{current:new Map()},submittingRun:{current:false},crypto:{randomUUID:()=> 'request-1'},setExecuting:()=>{},
    setBalanceNotice:value=>notices.push(value),notify:error=>messages.push(error.message),
    defaultVideoOptions:model=>({duration:model.id==='a'?4:5}),defaultImageOptions:()=>({}),
    edit:(id,value)=>{Object.assign(document.nodes.find(n=>n.id===id).data,value);},
    nodeQuote:id=>states[id],nodeInputError:()=>'',canvasQuoteSignature:doc=>JSON.stringify(doc.nodes[0].data),
    storeQuote:(id,value)=>states[id]=value,enqueue:fn=>Promise.resolve().then(fn),
    checkRelayState:async()=>relayState.current,flush:async()=>{saved.push(document.nodes[0].data.model);},
    post:async(url,body)=>{calls.push({url,body:{...body}});return url.endsWith('/quote')?pending:execute();},
    api:async()=>({runs}),replace:value=>{context.current.current=value;},quoteValid};
  vm.createContext(context);vm.runInContext(functions,context);
  return {context,document,calls,saved,messages,notices,resolve,reject};
}
const response={revision:1,balance_checked:true,quote:{id:'opaque_quote_123',model:'a',name:'Current published name',currency:'CNY',price_version:1,unit:'second',unit_price_cny:'0.1',units:4,reference_surcharge_cny:'0',per_item_cny:'0.4',quantity:1,total_cny:'0.4',expires_at:Math.floor(Date.now()/1000)+60}};
const paymentError=code=>Object.assign(Error('safe payment guidance'),{status:402,code});

test('twenty canvas model changes issue zero quotes; explicit execution preparation has one shared quote',async()=>{
  const f=fixture();for(let i=0;i<20;i++){f.context.chooseModel('node','main',i%2?'a':'b');await flush();}
  assert.equal(f.calls.length,0);assert.equal(f.saved.length,0);
  const first=f.context.requestQuote('node'),second=f.context.requestQuote('node');await flush();assert.equal(f.calls.length,1);
  f.resolve(response);assert.equal((await first).quote.id,response.quote.id);assert.equal((await second).quote.id,response.quote.id);
  assert.doesNotMatch(source,/activeQuoteNode|activateQuote|setTimeout\(\(\)=>\{void requestQuote/);
});
test('canvas pending or unknown original run is rejected before quote or save',async()=>{
  for(const status of ['preparing','submitted','submitting','queued','processing','unknown']){
    const f=fixture();f.document.runs=[{nodeId:'node',status}];await assert.rejects(f.context.requestQuote('node'),/原任务/);
    assert.equal(f.calls.length,0);assert.equal(f.saved.length,0);
  }
});
test('canvas changing the model during a signed quote cannot accept its late response or start another quote',async()=>{
  const f=fixture(),pending=f.context.requestQuote('node');await flush();f.context.chooseModel('node','main','b');f.resolve(response);
  await assert.rejects(pending,/失效|变更/);assert.equal(f.calls.length,1);
});
test('one canvas click checks the balance and submits once without a fee confirmation dialog',async()=>{
  const f=fixture(),first=f.context.execute('node'),duplicate=f.context.execute('node');
  await flush();assert.deepEqual(f.calls,[{url:'/canvas/projects/project/quote',body:{nodeId:'node',revision:1,check_balance:true}}]);
  f.resolve(response);await Promise.all([first,duplicate]);
  assert.deepEqual(f.calls[1],{url:'/canvas/projects/project/execute',body:{nodeId:'node',requestId:'request-1',revision:1,quote_id:response.quote.id,confirmed:true}});
  assert.equal(f.calls.length,2);assert.deepEqual(f.notices,[]);
  assert.doesNotMatch(source,/确认本节点生成费用|QuoteDialog/);
  assert.match(source,/postMessage\(\{type:'hamster-generation-recharge'\}/);
});
test('canvas blocks submission when the wallet is insufficient or the relay cannot verify it',async()=>{
  const low=fixture(),pending=low.context.execute('node');await flush();low.reject(paymentError('insufficient_balance'));await pending;
  assert.equal(low.calls.length,1);assert.deepEqual(low.notices,[true]);
  const unchecked=fixture(),waiting=unchecked.context.execute('node');await flush();unchecked.resolve({...response,balance_checked:undefined});await waiting;
  assert.equal(unchecked.calls.length,1);assert.deepEqual(unchecked.notices,[]);assert.match(unchecked.messages[0],/无法核对账户余额/);
});
test('canvas suppresses balance notices from stale accounts and unrelated payment errors',async()=>{
  const stale=fixture(),pending=stale.context.execute('node');await flush();stale.context.relayState.current.revision=2;stale.reject(paymentError('insufficient_balance'));await pending;
  assert.equal(stale.calls.length,1);assert.deepEqual(stale.notices,[]);
  const unrelated=fixture(),waiting=unrelated.context.execute('node');await flush();unrelated.reject(paymentError('token_limit'));await waiting;
  assert.equal(unrelated.calls.length,1);assert.deepEqual(unrelated.notices,[]);assert.deepEqual(unrelated.messages,['safe payment guidance']);
});
test('canvas shows balance changes on submission and observes a current asynchronous failure once',async()=>{
  const direct=fixture({execute(){throw paymentError('insufficient_balance');}}),directRun=direct.context.execute('node');
  await flush();direct.resolve(response);await directRun;
  assert.equal(direct.calls.length,2);assert.deepEqual(direct.notices,[true]);
  const asyncRun=fixture(),accepted=asyncRun.context.execute('node');await flush();asyncRun.resolve(response);await accepted;
  const failed={nodeId:'node',status:'failed',failureCode:'insufficient_balance'};
  asyncRun.context.showRunBalanceNotice([{...failed,requestId:'old-request'}]);assert.deepEqual(asyncRun.notices,[]);
  asyncRun.context.showRunBalanceNotice([{...failed,requestId:'request-1'}]);assert.deepEqual(asyncRun.notices,[true]);
  asyncRun.context.showRunBalanceNotice([{...failed,requestId:'request-1'}]);assert.deepEqual(asyncRun.notices,[true]);assert.equal(asyncRun.calls.length,2);
});
