FOLDER = Path("/opt/piknoai-relay/checkout73-20261113")
PRIVATE = FOLDER / "private"
APP = base.APP
APP_OLD = "sha256:98dcba86d96d71298718cdd26c9fe8f556f204b28853275359b0af5a09c55d02"
BINARY_OLD = "a5446a7a68b060289c39ce8893db84a481fe8fa89aa4ba98c25f25fa1c4d13e7"
BRIDGE_OLD = "sha256:10be445fd089bf325edb46323d7e99d0d6c968d332d63cae88460fc024ccd240"
JS_OLD = "31654814e4423c6cb43ab613781d6ad32ad8c35d4549fc4375a10f0fd1a33120"
APP_REF = "hamster-modelgif72-release:local"
BRIDGE_REF = "hamster-lanjing71-release:local"
APP_NEW = "hamster-checkout73-release:local"
BRIDGE_NEW = "hamster-lanjing73-release:local"
VERSION = "v1.0.0-rc.41-hamster.73"
base.STAGE, base.PRIVATE = FOLDER, PRIVATE
stage.STAGE, stage.PRIVATE = FOLDER, PRIVATE
