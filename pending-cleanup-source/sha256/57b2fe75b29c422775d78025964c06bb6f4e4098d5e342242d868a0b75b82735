import assert from 'node:assert/strict';
import { existsSync, readFileSync } from 'node:fs';
import test from 'node:test';
import { publishedDownload } from '../website/src/download-handler.js';

const read = path => readFileSync(new URL('../website/public/' + path, import.meta.url), 'utf8');
const page = read('tutorials/index.html');
const downloadPath=read('index.html').match(/href="(\/download\/HamsterAI-Portable-(\d+\.\d+\.\d+)\.exe)"/);
assert.ok(downloadPath&&publishedDownload(downloadPath[1]),'Homepage must link an allowed published download');
const publishedVersion=downloadPath[2];

test('默认教程对应当前公开下载版本，展示本地账户启用、报价、批次和手动画布', () => {
  const sections = [...page.matchAll(/<section class="tutorial-chapter reveal" id="([a-z]+)"/g)].map(match => match[1]);
  assert.deepEqual(sections, ['account', 'quote', 'batch', 'canvas', 'reverse']);
  assert.match(page, /<aside class="tutorial-sidebar" aria-label="教程目录">/);
  for (const id of sections) assert.match(page, new RegExp(`<a href="#${id}">`));
  assert.ok(page.includes('适用于仓鼠AI正式版 '+publishedVersion));
  assert.match(page, /本地账户主页/);
  assert.match(page, /点击「继续支付」进入独立安全收银台/);
  assert.match(page, /按需手动充值/);
  assert.match(page, /点击「开通并启用」/);
  assert.match(page, /已有 Key 可点击「使用已有 Key」或「更换 Key」，明确选择后启用/);
  assert.match(page, /无需一次开通四类/);
  assert.match(page, /应用只查找原操作，不会重新创建 Key/);
  assert.doesNotMatch(page, /tutorial-1749-account\.png/);
  assert.match(page, /图片 Key、视频 Key、工具 Key、对话 Key 必须来自同一账户，共用账户余额/);
  assert.match(page, /工具 Key 供数字人和黑白深度共用/);
  assert.match(page, /留空表示保留原 Key/);
  assert.match(page, /失效项可单独移除/);
  assert.match(page, /检测不创建生成任务，不扣费/);
  assert.match(page, /连接检测通过只表示认证及当前可用线路已确认/);
});

