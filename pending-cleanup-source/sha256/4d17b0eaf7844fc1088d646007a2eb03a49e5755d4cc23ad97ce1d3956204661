function pendingFixture(){
 const f=fixture({id:mediaId,name:'本地图片.png',kind:'image',mime:'image/png',size:1024,label:'@图片1',url:'https://untrusted.invalid/image.png'});
 const counts={mount:0,refresh:0,hide:0},controller={refresh(){counts.refresh++;},hide(){counts.hide++;}};
 let options;
 f.context.mountMaterialPreview=(container,value)=>{assert.equal(container,f.nodes['#attachments']);counts.mount++;options=value;return controller;};
 vm.runInContext(source.slice(source.indexOf('function renderAttachments()'),source.indexOf('function richText(')),f.context);
 f.context.pending=[mediaId];f.context.renderAttachments();
 return {...f,counts,controller,options:()=>options,tray:f.nodes['#attachments']};
}

test('pending image cards resolve only local current-session media and reuse the existing click-preview dialog',()=>{
 const f=pendingFixture(),card=f.tray.children[0],button=card.children.find(node=>'materialPreview' in node.dataset),options=f.options();
 assert.equal(card.className,'file-card attachment-tile attachment-image');
 assert.equal(button.attributes['aria-label'],'预览附件：本地图片.png');assert.equal(button.onclick,undefined,'shared delegate owns the image click');
 const item=options.resolve(button);assert.equal(item.src,`/chat-api/sessions/${session}/media/${mediaId}`);assert.equal(item.name,'本地图片.png');
 options.onOpen(item,button);assert.equal(f.nodes['#mediaPreviewDialog'].open,true);assert.equal(f.nodes['#mediaPreviewBody'].children[0].src,item.src);
