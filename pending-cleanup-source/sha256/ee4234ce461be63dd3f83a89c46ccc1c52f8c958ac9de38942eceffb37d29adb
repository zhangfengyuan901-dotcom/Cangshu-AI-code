    if (!asset) return;
    uploading = true;
    controls();
    await ensureSession();
    const id=current.id,selected=selection,epoch=configurationEpoch;
    const media = await api(`/sessions/${id}/assets/${asset.id}`, {
      method: "POST",
    });
