test('native image multipart streams above 128 MiB while each source stays within its published file limit',async t=>{
  const {Readable}=require('node:stream');
  const size=22*1024*1024,chunk=Buffer.alloc(1024*1024);
  let received=0,parts=0,largest=0;
  const client=createPiknoClient({fetchImpl:async(_target,options)=>{
    assert.equal(options.duplex,'half');
    assert(Number(options.headers.get('Content-Length'))>128*1024*1024);
    for await(const bytes of options.body){
      received+=bytes.length;largest=Math.max(largest,bytes.length);
      if(bytes.length<1024&&bytes.includes(Buffer.from('name="image[]"')))parts++;
    }
    assert.equal(received,Number(options.headers.get('Content-Length')));
    return json({data:[]});
  }});
  t.after(()=>client.stop());
  const images=[];
  for(let index=0;index<6;index++){
    async function* source(){yield png;for(let left=size-png.length;left>0;left-=chunk.length)yield chunk.subarray(0,Math.min(left,chunk.length));}
    images.push({url:(await client.upload(imageCfg,Readable.from(source()),{kind:'image',contentType:'image/png',contentLength:size})).url});
  }
  await client.submit(imageCfg,{...image,max_images:20,max_media_total:20},{images});
  assert.equal(parts,6);assert(largest<=1024*1024);assert(received>6*size);
});
test('tool input uploads binary once without media tickets or R2 and binds returned reference to its account',async()=>{
  const calls=[],tools={...imageCfg,piknoToolKey:'tool-only'},expires_at=Math.floor(Date.now()/1000)+3600;
  const claims={v:1,aud:'pikno-tool-input',uid:7,id,mime:'image/png',size:png.length,exp:expires_at};
  let responseUid=7;
  const client=createPiknoClient({fetchImpl:async(target,options)=>{
    calls.push({target,options});
    const ticket=Buffer.from(JSON.stringify({...claims,uid:responseUid})).toString('base64url')+'.synthetic';
    return json({url:endpoint+'/media/v1/tool-inputs/'+id+'?ticket='+ticket,expires_at});
  }});
  const ready=await client.upload(tools,png,{kind:'tool',contentType:'image/png'});
  assert.equal(calls.length,1);assert.equal(calls[0].target,endpoint+'/v1/media/direct-uploads');
  assert.equal(calls[0].options.headers.get('Authorization'),'Bearer tool-only');
