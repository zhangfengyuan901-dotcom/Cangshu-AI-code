test('quote and submission use the balance header only for opted-in checks',async()=>{
  const calls=[],payload={size:'1024x1024',concurrency:2};
  let checked=false;
  const client=createPiknoClient({fetchImpl:async(target,init)=>{
    calls.push({target,headers:init.headers,body:JSON.parse(init.body)});
    if(!target.endsWith('/quote'))return json({data:[]});
    const data=syntheticQuote(quoteParameters(image,payload));
    return json({data:{...data,...(checked?{balance_checked:true}:{})}});
  }});
  const quote=await client.quote(cfg,image,payload);
  assert.equal(calls[0].headers.get('X-Pikno-Check-Balance'),null);
  await assert.rejects(client.quote(cfg,image,{...payload,check_balance:true}),error=>error.statusCode===503);
  checked=true;
  assert.equal((await client.quote(cfg,image,{...payload,check_balance:true})).balance_checked,true);
  assert.equal(calls[2].headers.get('X-Pikno-Check-Balance'),'1');
  assert.deepEqual(calls[2].body,calls[0].body);
  await client.submit(cfg,image,{...payload,check_balance:true},{quote_id:quote.quote_id,index:0});
  await client.submit(cfg,image,payload,{quote_id:quote.quote_id,index:1,balanceChecked:true});
  assert.equal(calls[3].headers.get('X-Pikno-Check-Balance'),null);
  assert.equal(calls[4].headers.get('X-Pikno-Check-Balance'),'1');
  assert.equal(calls[4].headers.get('X-PIKNO-Quote-Index'),'1');
});

test('opted-in balance check distinguishes wallet shortage from generic 402 and Key limits',async()=>{
  let status=402,code='insufficient_balance';
  const client=createPiknoClient({fetchImpl:async()=>Response.json({error:{code,message:'private text'}},{status})});
  const quote=()=>client.quote(cfg,image,{size:'1024x1024',check_balance:true});
  await assert.rejects(quote(),error=>error.statusCode===402&&error.code==='insufficient_balance'&&!error.ambiguous&&!error.message.includes('private'));
  code='some_provider_limit';
  await assert.rejects(quote(),error=>error.statusCode===402&&error.code===undefined);
  status=403;code='insufficient_user_quota';
  await assert.rejects(quote(),error=>error.statusCode===403&&error.code===undefined);
});

