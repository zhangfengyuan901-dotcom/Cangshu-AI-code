test('PUT response cleanup cannot prevent completion or hide a failed upload status',async()=>{
  for(const status of [200,503]){
    const calls=[],expires=Math.floor(Date.now()/1000)+600;
    const client=createPiknoClient({fetchImpl:async(target,init)=>{
      calls.push({target:String(target),method:init.method});
      if(String(target).endsWith('/v1/media/uploads'))return json({id,method:'PUT',upload_url:url,upload_ticket:'upload-only',headers:{Authorization:'Bearer upload-only','Content-Type':'image/png'},expires_at:expires});
      if(init.method==='PUT')return new Response(new ReadableStream({cancel(){throw Error('private cleanup detail');}}),{status});
      return json({id,status:'ready',url:url+'?ticket=read-only',expires_at:expires});
    }});
    if(status===200)assert.equal((await client.upload(cfg,Buffer.alloc(16),{contentType:'image/png',kind:'video'})).url,url+'?ticket=read-only');
    else await assert.rejects(client.upload(cfg,Buffer.alloc(16),{contentType:'image/png',kind:'video'}),error=>error.statusCode===502&&error.message==='素材上传失败，请重新上传');
    assert.equal(calls.filter(call=>call.method==='PUT').length,1,'cleanup never repeats the file transfer');
    assert.equal(calls.length,status===200?3:2);
  }
});
