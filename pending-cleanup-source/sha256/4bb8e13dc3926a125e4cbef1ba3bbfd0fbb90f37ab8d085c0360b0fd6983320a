  assert.doesNotThrow(()=>client.validateReferences({id:'pikno-tool-digital',kind:'video'},{images:[{url:ready.url}]},{cfg:tools}));
  assert.throws(()=>client.validateReferences({id:'pikno-tool-digital',kind:'video'},{images:[{url:ready.url}]},{cfg:{...tools,piknoUserId:8}}));
  responseUid=8;
  await assert.rejects(client.upload(tools,png,{kind:'tool',contentType:'image/png'}));
});
