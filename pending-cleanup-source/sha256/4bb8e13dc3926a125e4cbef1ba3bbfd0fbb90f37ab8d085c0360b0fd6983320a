test('same-content images reuse an account-bound local reference before the distinct-file capacity check',async t=>{
  const client=createPiknoClient({fetchImpl:()=>assert.fail('local staging never contacts a network')});
  t.after(()=>client.stop());
  const metadata={kind:'image',contentType:'image/png',revision:11};
  const first=await client.upload(imageCfg,png,metadata);
  const again=await client.upload(imageCfg,Buffer.from(png),metadata);
  assert.equal(first.url,again.url);
  const otherAccount=await client.upload({...imageCfg,piknoUserId:8},png,metadata);
  const otherRevision=await client.upload(imageCfg,png,{...metadata,revision:12});
  assert.notEqual(first.url,otherAccount.url);assert.notEqual(first.url,otherRevision.url);
  const distinct=[];
  for(let index=0;index<125;index++){
    const bytes=Buffer.concat([png,Buffer.from([index])]);
    distinct.push(await client.upload(imageCfg,bytes,metadata));
  }
  await assert.rejects(client.upload(imageCfg,Buffer.concat([png,Buffer.from([255])]),metadata),error=>error.statusCode===429);
  assert.equal((await client.upload(imageCfg,png,metadata)).url,first.url);
  assert.doesNotThrow(()=>client.validateReferences(image,{images:[{url:first.url}]},{cfg:imageCfg,revision:11}));
});
