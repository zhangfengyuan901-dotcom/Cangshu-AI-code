for(const [name,raw,allowed,blocked] of [
  ['A',line(),media(30,10,10),media(31)],
  ['B',line(30,0,10,40),media(30,0,10),media(1,1)],
  ['Kling',line(10,5,3,15),media(10,5),media(10,5,1)],
  ['bamboo A',line(9,3,3,12),media(9,3),media(9,3,1)],
  ['bamboo B',line(9,3,3,15),media(9,3,3),media(10)],
  ['Wan',line(10,5,5,20),media(10,5,5),media(10,6)],
]){
  test(`${name}: main/canvas upload counts, quote, estimate and one submit agree with published limits`,async()=>{
    const m=model(raw),f=clientFixture(raw);
    assert.equal(mediaLimitError(m,allowed),'');
    assert.notEqual(mediaLimitError(m,blocked),'');
    assert.equal(canvasMediaError(m,allowed.map(asset=>({asset}))), '');
    assert.equal(canvasMediaError(m,blocked.map(asset=>({asset}))),mediaLimitError(m,blocked));
    assert.equal(estimatePrice(m,{...base,media_counts:counts(allowed)}).total_cny,'0.450000');
    assert.equal(estimatePrice(m,{...base,media_counts:counts(blocked)}).known,false);
    assert.equal(quoteParameters(raw,{...base,media_counts:counts(allowed)}).reference_images,counts(allowed).images);
    assert.throws(()=>quoteParameters(raw,{...base,media_counts:counts(blocked)}));
    await f.client.quote(cfg,raw,{...base,media_counts:counts(allowed)});
    await f.client.submit(cfg,raw,payload(allowed));
    const before=f.calls.length;assert.throws(()=>f.client.submit(cfg,raw,payload(blocked)));
    assert.equal(f.calls.length,before,'over-limit references do not enter transport');
    const body=f.calls.find(c=>c.route==='/v1/videos').body;
    assert.deepEqual([body.image_urls.length,body.video_urls.length,body.audio_urls.length],[counts(allowed).images,counts(allowed).videos,counts(allowed).audios]);
    assert.equal(body.image_urls[0].expires_at,undefined,'local expiry metadata is not forwarded');
  });
}

