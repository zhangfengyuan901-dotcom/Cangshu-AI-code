const reply=(data,status=200)=>({ok:status>=200&&status<300,status,headers:{get:()=>null},json:async()=>data});
function fixture(t,{fetchImpl,loadImpl,statusLoadImpl,appUrl=APP,...options}={}){
  const calls=[],windows=[],handlers=new Map(),session=new EventEmitter();
  session.setPermissionRequestHandler=handler=>session.requestPermission=handler;
  session.setPermissionCheckHandler=handler=>session.checkPermission=handler;
  session.fetch=async(url,init)=>{calls.push({url,init});return fetchImpl?fetchImpl(url,init):reply({success:false},401);};
  class Contents extends EventEmitter{
    constructor(url=''){super();this.url=url;this.mainFrame={url};this.sent=[];this.destroyed=false;}
    getURL(){return this.url;}
    setURL(url){this.url=url;this.mainFrame.url=url;}
    isDestroyed(){return this.destroyed;}
    send(...values){this.sent.push(values);}
    stop(){this.stops=(this.stops||0)+1;}
    setWindowOpenHandler(handler){this.popup=handler;}
  }
  class Window extends EventEmitter{
    constructor(prefs={}){super();this.options=prefs;this.webContents=new Contents();this.destroyed=false;windows.push(this);}
    async loadURL(url,options){this.webContents.setURL(url);this.loaded=url;this.navigation=options?{...options,postData:options.postData?.map(row=>({...row,bytes:Buffer.from(row.bytes)}))}:null;return loadImpl?.(this,url,options);}
    async loadFile(file,options){this.statusLoads??=[];this.statusLoads.push({file,options});this.webContents.setURL(pathToFileURL(file).href+(options?.query?'?'+new URLSearchParams(options.query):''));return statusLoadImpl?.(this,file,options);}
    isDestroyed(){return this.destroyed;}
    show(){this.shown=true;}
    focus(){this.focused=true;}
    close(){if(this.destroyed)return;this.destroyed=true;this.webContents.destroyed=true;this.emit('closed');}
    destroy(){this.close();}
  }
  const win=new EventEmitter();win.destroyed=false;win.webContents=new Contents(APP);win.isDestroyed=()=>win.destroyed;win.focus=()=>{win.focused=true;};
  const electron={BrowserWindow:Window,session:{fromPartition:partition=>{assert.equal(partition,PARTITION);return session;}},ipcMain:{handle:(name,handler)=>handlers.set(name,handler),removeHandler:name=>handlers.delete(name)}};
  const journalFile=path.join(os.tmpdir(),`hamster-desktop-boundary-${randomUUID()}.json`);
  const controller=createDesktopAccount({window:win,electron,appUrl,journalFile,connectCreatedKey:async()=>{throw Error('Unexpected key import');},...options});
  t.after(()=>{controller.dispose();for(const suffix of ['', '.payment','.auth']){const target=path.resolve(journalFile+suffix);assert.equal(path.dirname(target),path.resolve(os.tmpdir()));fs.rmSync(target,{force:true});}});
  const event=()=>({sender:win.webContents,senderFrame:win.webContents.mainFrame});
  const invoke=(action,value={},senderEvent=event())=>handlers.get(CHANNEL)(senderEvent,action,value);
  return {calls,windows,handlers,session,win,Window,Contents,controller,invoke,event};
}
const flush=()=>new Promise(resolve=>setImmediate(resolve));
function fakeTimers(){
  const pending=new Map();let next=0;
  return {pending,setTimeout(fn,ms){const id=++next;pending.set(id,{fn,ms});return id;},clearTimeout(id){pending.delete(id);},fire(){const callbacks=[...pending.values()];pending.clear();for(const {fn} of callbacks)fn();}};
}
function navigation(contents,url,{main=true,eventName='will-frame-navigate'}={}){
  let prevented=false;contents.emit(eventName,{url,isMainFrame:main,preventDefault(){prevented=true;}},url,false,main);return !prevented;
}
const signedFetch=async(url,init={})=>{
  const route=new URL(url).pathname;
  if(route==='/api/user/auth/refresh')return reply({success:true,data:{access_token:'fixture-private-access',access_expires_at:Date.now()/1000+120,user:{id:12},session:{sid:'fixture-private-session'}}});
  if(route==='/api/user/self')return reply({success:true,data:{id:12,username:'fixture',email:'fixture@example.test',quota:1000,used_quota:10,request_count:3,key:'private-should-not-cross'}});
  if(route==='/api/status')return reply({success:true,data:{quota_per_unit:100,usd_exchange_rate:1}});
  if(route==='/api/user/self/groups')return reply({success:true,data:{'image-standard':{},'chat-standard':{}}});
  if(route==='/api/user/topup/info')return reply({success:true,data:{fixed_cny_topup:true,enable_online_topup:true,payment_compliance_confirmed:true,amount_options:[50,100,200],pay_methods:[{type:'alipay'},{type:'wxpay'}]}});
  if(route==='/api/user/amount')return reply({message:'success',data:JSON.parse(init.body).amount.toFixed(2)});
  if(route==='/api/user/pay'){const body=JSON.parse(init.body);return reply({message:'success',url:BRIDGE,data:{pid:'2347637',type:body.payment_method,out_trade_no:'USR12NOSYNTHETIC1',notify_url:REMOTE+'/api/user/epay/notify',return_url:REMOTE+'/account-lite/index.html',name:'TUC'+body.amount,money:body.amount.toFixed(2),sign:'c'.repeat(32),sign_type:'MD5'}});}
  if(route==='/api/user/topup/self')return reply({success:true,data:{total:1,items:[{user_id:12,trade_no:'USR12NOSYNTHETIC1',money:50,payment_method:'alipay',status:'pending',create_time:1700000000}]}});
  if(route==='/api/user/auth/logout')return reply({success:true});
  throw Error('Unexpected request');
};
const cashierFixture=(t,options={})=>fixture(t,{fetchImpl:signedFetch,...options});
async function prepareCashier(f){
  const quote=await f.invoke('payment-quote',{accountId:12,amount:50,method:'alipay'});assert.equal(quote.ok,true);
  const created=await f.invoke('payment-create',{accountId:12,quoteId:quote.quoteId,confirmed:true});assert.equal(created.ok,true);
  return quote;
}
async function openCashier(f){
  await prepareCashier(f);const result=await f.invoke('payment-open',{accountId:12});assert.deepEqual(result,{ok:true,pending:true,paymentOpened:true});return result;
}

