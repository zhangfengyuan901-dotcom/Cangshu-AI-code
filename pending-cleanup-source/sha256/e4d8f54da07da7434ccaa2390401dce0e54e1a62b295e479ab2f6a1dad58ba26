test('provider return restores the app and quietly checks only the original order until it settles',async t=>{
  const timers=fakeTimers();
  const trade='USR12NOSYNTHETIC1';
  let checks=0;
  const f=cashierFixture(t,{timers,fetchImpl:async(url,init)=>{
    const target=new URL(url);
    if(target.pathname==='/api/user/topup/info'){
      const original=await signedFetch(url,init).then(r=>r.json());
      original.data.payment_cancel_supported=true;
      return reply(original);
    }
    if(target.pathname==='/api/user/topup/status'){
      assert.equal(target.searchParams.get('trade_no'),trade);
      return reply({success:true,data:{trade_no:trade,money:50,payment_method:'alipay',status:++checks===1?'pending':'success'}});
    }
    return signedFetch(url,init);
  }});
  await openCashier(f);await flush();
  const cashier=f.windows[0];
  assert.equal(navigation(cashier.webContents,REMOTE+'/pay/lanjing/return?fixture=1',{eventName:'will-redirect'}),true);
  assert.equal(cashier.isDestroyed(),false);
  assert.equal(navigation(cashier.webContents,REMOTE+'/account-lite/index.html?tab=topup&payment_return=1&trade_no=untrusted',{eventName:'will-redirect'}),false);
  await Promise.resolve();
  assert.equal(cashier.isDestroyed(),true);assert.equal(f.win.focused,true);
  await f.invoke('snapshot');
  assert.equal(checks,1);assert.deepEqual(f.win.webContents.sent,[['hamster-payment-updated']]);
  assert.deepEqual([...timers.pending.values()].map(row=>row.ms),[2000]);
  timers.fire();await f.invoke('snapshot');
  assert.equal(checks,2);assert.equal(timers.pending.size,0);
  assert.deepEqual(f.win.webContents.sent,[['hamster-payment-updated'],['hamster-payment-updated']]);
  assert.equal(f.calls.filter(row=>new URL(row.url).pathname==='/api/user/pay').length,1);
  assert.equal(f.calls.some(row=>new URL(row.url).pathname==='/api/user/topup/cancel'),false);
  assert.equal((await f.invoke('payment-options',{accountId:12})).pending,null);
});

