    def test_review_uses_one_fresh_config_for_both_private_values(self):
        with patch.object(self.chat, 'keys', return_value={
                'MODEL_AGENT_API_KEY':'synthetic-api-private', 'LLM_ENDPOINT_ID':'synthetic-endpoint-private'}) as keys:
            self.assertEqual(self.chat.review('synthetic-api-private')[0], SAFE_REPLY)
            self.assertEqual(keys.call_count, 1)
            self.assertEqual(self.chat.review('synthetic-endpoint-private')[0], SAFE_REPLY)
