    async def test_account_switch_during_upload_or_poll_never_submits_response(self):
        for stage in ('create', 'wait_for_processing'):
            with self.subTest(stage=stage):
                config = {'MODEL_AGENT_API_KEY':'hamster-cloud-session','EXECUTION_SCOPE':'a'*64,'CONFIG_REVISION':1}
                self.chat.keys = lambda: dict(config)
                self.client = fake_client()
                self.item = self.chat.get(self.chat.create()['id'])
                media = await self.chat.upload(self.item, b'%PDF-1.7\nfixture', '说明.pdf')
                async def changed(**kwargs):
                    config.update(EXECUTION_SCOPE='b'*64, CONFIG_REVISION=2)
                    return NS(id='old-file', status='active')
                async def polled(*args, **kwargs):
                    return await changed(**kwargs)
                getattr(self.client.files, stage).side_effect = changed if stage == 'create' else polled
                await self.turn(self.request('概括', [media['id']]))
                self.client.responses.create.assert_not_called()
                self.assertIn('账户配置已变化', self.item['stage'])

    async def test_account_switch_during_response_submission_and_stream_does_not_publish(self):
        for phase in ('submission', 'stream'):
            with self.subTest(phase=phase):
                config = {'MODEL_AGENT_API_KEY':'hamster-cloud-session','EXECUTION_SCOPE':'a'*64,'CONFIG_REVISION':1}
                self.chat.keys = lambda: dict(config)
                self.client = fake_client()
                self.item = self.chat.get(self.chat.create()['id'])
                class ChangedStream(Stream):
                    async def __aiter__(stream):
                        if phase == 'stream':
                            config.update(EXECUTION_SCOPE='b'*64, CONFIG_REVISION=2)
                        async for event in super(ChangedStream, stream).__aiter__():
                            yield event
                async def submitted(**kwargs):
                    if phase == 'submission':
                        config.update(EXECUTION_SCOPE='b'*64, CONFIG_REVISION=2)
                    return ChangedStream('旧账户的未审核文本')
                self.client.responses.create.side_effect = submitted
                await self.turn()
                self.assertEqual(self.client.responses.create.call_count, 1)
                self.assertEqual(self.item['messages'][-1]['text'], '')
                self.assertIsNone(self.item['chain'])
                self.assertIn('账户配置已变化', self.item['stage'])

