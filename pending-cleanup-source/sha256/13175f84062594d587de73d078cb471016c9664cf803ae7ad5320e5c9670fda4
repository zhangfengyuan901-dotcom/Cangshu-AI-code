    def test_history_100_answers_share_one_config_but_all_are_reviewed(self):
        self.review_history_messages(100)
        with patch.object(self.chat, 'keys', return_value={}) as keys, patch('chat.review_output', wraps=review_output) as review:
            public = self.chat.public(self.item)
        self.assertEqual(keys.call_count, 1)
        self.assertEqual(review.call_count, 100)
        self.assertEqual(len(public['messages']), 100)
        self.assertTrue(all(message['text'] == '可展示的历史回答。' for message in public['messages']))

    def test_history_without_reviewable_text_does_not_read_config(self):
