func TestPiknoSyncUpgradeRetainsExistingPublication(t *testing.T) {
	channel, now := setupPiknoSyncTest(t)
	_, err := applySyncTest(t, channel, now, syncModelBody("a", "b", "c"), true)
	require.NoError(t, err)
	syncOpenDraft(t, "pikno-video-cs-a")
	before, err := GetPiknoLineAdmin("pikno-video-cs-a", 0)
	require.NoError(t, err)
	old := *before.Published
	old.SyncHash = ""
	old.AdapterVersion = ""
	raw, err := encodePiknoLineConfig(&old)
	require.NoError(t, err)
	require.NoError(t, DB.Model(&PiknoLine{}).Where("public_model = ?", old.PublicModel).Update("published_config", raw).Error)
	require.NoError(t, DB.Where("provider = ?", "canseedream").Delete(&PiknoLineSyncState{}).Error)
	require.NoError(t, DB.Model(&PiknoSyncProvider{}).Where("provider = ?", "canseedream").Updates(map[string]any{"snapshot_hash": "", "last_verified_at": 0, "adapter_models": "", "plugin_version": "", "started_at": now, "next_attempt_at": 0, "lease_until": 0}).Error)
	require.NoError(t, MigratePiknoLineSync(DB))
	require.NoError(t, MigratePiknoLineSync(DB))
	line, err := GetPublishedPiknoLine(old.PublicModel)
	require.NoError(t, err)
	require.Equal(t, old.DisplayName, line.DisplayName)
	require.Equal(t, old.Prices, line.Prices)
	require.True(t, line.Enabled)
	for i := 1; i <= 2; i++ {
		_, err = applySyncTest(t, channel, now+int64(i*60), syncModelBody("b", "c"), true)
		require.NoError(t, err)
		_, err = GetPublishedPiknoLine(old.PublicModel)
		require.NoError(t, err)
		require.Equal(t, i, PiknoLineSyncAdmin(old.PublicModel).MissingCount)
	}
	require.NoError(t, DB.Model(&PiknoSyncProvider{}).Where("provider = ?", "canseedream").Updates(map[string]any{"last_verified_at": 0, "started_at": time.Now().Unix() - 601}).Error)
	require.NoError(t, MigratePiknoLineSync(DB))
	_, err = GetPublishedPiknoLine(old.PublicModel)
	require.Error(t, err, "restart cannot reset the unverified catalogue deadline")
}
