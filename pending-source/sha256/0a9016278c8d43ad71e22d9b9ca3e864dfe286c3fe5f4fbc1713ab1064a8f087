      canvasLauncher.open(url.searchParams.get('project')||'').then(data=>{res.writeHead(200,{'Content-Type':'application/json'});res.end(JSON.stringify(data));}).catch(fail(res));
    } else if (p === '/api/canvas/models') {
      import('./legacy-routes.mjs').then(({VIDEO_ROUTES,OFFICIAL_VIDEO_ROUTE,IMAGE_ROUTES})=>{res.writeHead(200,{'Content-Type':'application/json'});res.end(JSON.stringify({data:[...VIDEO_ROUTES.map(m=>({...m,type:'video'})),OFFICIAL_VIDEO_ROUTE,...IMAGE_ROUTES.map(m=>({...m,type:'image',max_images:9,max_media_files:9}))]}));}).catch(fail(res));
    } else if (p.startsWith('/api/canvas/')) {
      canvas.handle(req,res,url).catch(fail(res));
    } else if (p === '/api/error-report') {
      if(req.method!=='POST' || !req.headers['content-type']?.startsWith('application/json') ||
        !/^127\.0\.0\.1:\d+$/.test(req.headers.host || '') ||
        (req.headers.origin && req.headers.origin!==`http://${req.headers.host}`)) {res.writeHead(403);res.end();return;}
      (async()=>{
        let size=0;const chunks=[];
        for await(const chunk of req){size+=chunk.length;if(size>4096){res.writeHead(413);res.end();return;}chunks.push(chunk);}
        const value=require('./report-schema.cjs').normalizeReport(JSON.parse(Buffer.concat(chunks).toString('utf8')));
        report(value.module,{},value);res.writeHead(202);res.end();
      })().catch(()=>{if(!res.headersSent)res.writeHead(400);res.end();});
    } else if (p === '/api/diagnostics/status' || p === '/api/diagnostics/export') {
      const exportRequested=p.endsWith('/export');
      if(req.method!==(exportRequested?'POST':'GET')){res.writeHead(405);res.end();return;}
      (async()=>{
        const checks=await activeSmartVideoLauncher.diagnose?.() || {service:'unknown'};
        if(exportRequested){
          const exported=diagnosticStore.exportReport(checks);
          res.writeHead(200,{'Content-Type':'application/json; charset=utf-8','Cache-Control':'no-store'});
          res.end(JSON.stringify({ok:true,fileName:exported.fileName,localPath:exported.localPath}));
        }else{
          res.writeHead(200,{'Content-Type':'application/json; charset=utf-8','Cache-Control':'no-store'});
          res.end(JSON.stringify({...diagnosticStore.snapshot(),checks:safeDiagnosticData(checks)}));
        }
      })().catch(fail(res));
    } else if (p === '/api/ui-preferences') {
      void handleUiPreferences(req,res,uiPreferences,`127.0.0.1:${server.address().port}`);
    } else if (p === '/api/startup') {
      if (req.method !== 'GET') { res.writeHead(405,{'Cache-Control':'no-store'}); res.end('Method Not Allowed'); return; }
      const light=url.searchParams.get('light')==='1';
      if(light && (req.headers.host!==`127.0.0.1:${server.address().port}` || req.headers.origin && req.headers.origin!==`http://${req.headers.host}` || req.headers['sec-fetch-site']==='cross-site')){res.writeHead(403,{'Content-Type':'application/json','Cache-Control':'no-store'});res.end(JSON.stringify({error:'请求来源无效'}));return;}
      res.writeHead(200, { 'Content-Type':'application/json; charset=utf-8', 'Cache-Control':'no-store' });
      res.end(JSON.stringify(light?{config:activeConfigStatus(),uiPreferences:uiPreferences.get()}:{config:activeConfigStatus(),assets:getAssets().summary()}));
    } else if (p === '/api/tasks' || p.startsWith('/api/tasks/')) {
      try { taskStore().handle(req,res,url).catch(fail(res)); } catch (error) { fail(res)(error); }
    } else if (p === '/api/assets' || p.startsWith('/api/assets/')) {
      getAssets()(req,res,url).catch(fail(res));
    } else if (p === '/api/public-models') {
      handlePublicModels(req, res, upstream).catch(fail(res));
    } else if (p === '/api/save-result') {
      handleSaveResult(req, res, resultDir, resultDownloadTimeoutMs).catch(fail(res));
    } else if (p === '/api/workbench/prepare') {
      handleSmartVideo(req, res, activeSmartVideoLauncher, 'prepare').catch(fail(res));
    } else if (p === '/api/chat/open') {
      handleSmartVideo(req, res, activeSmartVideoLauncher, 'open', 'chat').catch(fail(res));
    } else if (p === '/api/chat/status') {
      handleSmartVideo(req, res, activeSmartVideoLauncher, 'status', 'chat').catch(fail(res));
    } else if (p === '/api/creative/open' || p === '/api/creative/status') {
      res.writeHead(410,{'Content-Type':'application/json; charset=utf-8','Cache-Control':'no-store'});
      res.end(JSON.stringify({error:'反推改写工作台已停用，请使用对话功能'}));
    } else if (p === '/api/config') {
      if(wallet){res.writeHead(req.method==='GET'?200:405,{'Content-Type':'application/json','Cache-Control':'no-store'});res.end(JSON.stringify(req.method==='GET'?activeConfigStatus():{error:'请通过邮箱登录管理账户'}));}
      else handleConfig(req, res, configPath).catch(fail(res));
    } else if (p === '/api/inference/context') {
      if(req.method!=='GET'){res.writeHead(405);res.end();return;}
      const context=relayMode?wallet.executionContext():null;
      res.writeHead(200,{'Content-Type':'application/json; charset=utf-8','Cache-Control':'no-store'});
      res.end(JSON.stringify(context?{scope:context.scope,revision:context.revision,configured:Boolean(wallet.status().llmConfigured)}:{scope:'',revision:0,configured:false}));
    } else if (p === '/api/inference/status' || p.startsWith('/api/inference/api/v3/') || /^\/api\/inference\/requests\/[a-f0-9]{32}$/.test(p)) {
      try {
        const context=relayMode?wallet.executionContext():null;
        const assertCurrent=()=>{
          if(context)wallet.inferenceKey(context);
        };
        if(context && p!=='/api/inference/status' &&
          (req.headers['x-hamster-execution-scope']!==context.scope || String(req.headers['x-hamster-config-revision'])!==String(context.revision)))
          throw Object.assign(new Error('账户配置已变化，请重新发送本次对话'),{statusCode:409,...(p==='/api/inference/api/v3/responses'?{code:'llm_not_submitted',submissionState:'not_submitted'}:{})});
        const key=relayMode?wallet.inferenceKey(context):wallet?String(loadConfig(configPath).billingApiKey||''):resolveInferenceKey(req,configPath);
        cloudInference.handle(req,res,url,key,{assertCurrent}).catch(fail(res,true));
      } catch(error) { fail(res,true)(error); }
    } else if (p === '/api/official-videos') {
      forward(req, res, { target:officialVideoUpstream + '/v1/video/generations', apiKey:resolveOfficialVideoKey(req,configPath), dualHeader:false, taskStore }).catch(fail(res));
    } else if (p === '/rh' || p.startsWith('/rh/')) {
      forward(req, res, { target: dhTarget(url), apiKey: resolveDhKey(req, configPath), dualHeader: false, taskStore }).catch(fail(res));
    } else if (req.method === 'GET' && p === '/api/uploads/status') {
      (async () => {
        const kind=url.searchParams.has('kind')?url.searchParams.get('kind'):undefined;
        if(kind!==undefined&&!['image','video','tool','chat'].includes(kind))throw Object.assign(new Error('检测类型无效'),{statusCode:400});
        const status = await checkObjects(kind===undefined?{}:{kind});
        const httpStatus=Number.isInteger(status.httpStatus)&&status.httpStatus>=400&&status.httpStatus<=599?status.httpStatus:status.connected?200:503;
        const retryAfterMs=Number.isFinite(status.retryAfterMs)&&status.retryAfterMs>0?Math.min(3600000,status.retryAfterMs):0;
        res.writeHead(httpStatus, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store',...(retryAfterMs?{'Retry-After':String(Math.ceil(retryAfterMs/1000))}:{}) });
        res.end(JSON.stringify(status));
      })().catch(fail(res));
    } else if (req.method === 'POST' && p === '/api/uploads/direct') {
      if(wallet){wallet.upload(req,{contentType:cleanContentType(req.headers['content-type']),contentLength:Number(req.headers['content-length']),...(relayMode?{kind:'image',revision:req.headers['x-hamster-config-revision']}:{})}).then(data=>{res.writeHead(201,{'Content-Type':'application/json'});res.end(JSON.stringify(data));}).catch(fail(res));return;}
      const kind = url.searchParams.get('kind');
      const mime = cleanContentType(req.headers['content-type']);
      if (kind !== 'image' || !mime.startsWith('image/')) {
        res.writeHead(415, { 'Content-Type':'application/json; charset=utf-8' });
        res.end(JSON.stringify({ error: '图片生成仅支持直接上传图片素材' }));
        return;
      }
      const length = Number(req.headers['content-length']);
      const limit = MIME_LIMITS.get(mime);
      if (!limit) {
        res.writeHead(415, { 'Content-Type':'application/json; charset=utf-8' });
        res.end(JSON.stringify({ error: '不支持此图片格式' }));
        return;
      }
      if (!Number.isSafeInteger(length) || length < 1) {
        res.writeHead(411, { 'Content-Type':'application/json; charset=utf-8' });
        res.end(JSON.stringify({ error: '上传请求缺少有效的文件大小' }));
        return;
      }
      if (length > limit) {
        res.writeHead(413, { 'Content-Type':'application/json; charset=utf-8' });
        res.end(JSON.stringify({ error: '图片最大支持30MB' }));
        return;
      }
      const target = upstream + '/openapi/v1/uploads/raw' + url.search;
      forwardStream(req, res, { target, apiKey:resolveGenKey(req, configPath), dualHeader:true }).catch(fail(res));
    } else if (req.method === 'POST' && p === '/api/uploads/raw') {
      const contentType = cleanContentType(req.headers['content-type']);
      if(wallet){
        const upload=relayMode?uploadObject:wallet.upload;
        upload(req,{contentType,contentLength:Number(req.headers['content-length']),fileName:url.searchParams.get('fileName')||'media',...(relayMode?{revision:req.headers['x-hamster-config-revision'],...(url.searchParams.has('use')?{kind:url.searchParams.get('use')}:{})}:{})}).then(data=>{res.writeHead(201,{'Content-Type':'application/json'});res.end(JSON.stringify(data));}).catch(fail(res));return;
      }
      const cfg = loadConfig(configPath);
      handleMediaUpload(req, res, url, mediaUploader ? {
        endpoint: 'https://local.test/upload',
        token: 'injected',
        fetchImpl: async (_target, init) => {
          const payload = await mediaUploader(init.body, {
            contentType: init.headers['Content-Type'],
            contentLength: Number(init.headers['Content-Length']),
            fileName: url.searchParams.get('fileName') || 'media',
          });
          return new Response(JSON.stringify(payload), { status: 201, headers: { 'content-type': 'application/json' } });
        },
      } : {
        endpoint: String(cfg.mediaUploadEndpoint || process.env.HAMSTER_MEDIA_UPLOAD_ENDPOINT || DEFAULT_MEDIA_ENDPOINT),
        token: String(cfg.mediaUploadToken || process.env.HAMSTER_MEDIA_UPLOAD_TOKEN || ''),
      }).catch(fail(res));
    } else if (req.method === 'DELETE' && p === '/api/uploads/raw') {
      (async () => {
        let payload;
        try { payload = JSON.parse((await readBody(req))?.toString('utf8') || '{}'); }
        catch { payload = {}; }
        const objects = [
          ...(Array.isArray(payload.urls) ? payload.urls : []),
          ...(Array.isArray(payload.keys) ? payload.keys : []),
        ];
        const result = await deleteObjects(objects);
        res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' });
        res.end(JSON.stringify(result));
      })().catch(fail(res));
    } else if (p === '/api' || p.startsWith('/api/')) {
      if(wallet){res.writeHead(404,{'Content-Type':'application/json'});res.end('{"error":"服务接口未开放"}');return;}
      forward(req, res, { target: genTarget(url), apiKey: resolveGenKey(req, configPath), dualHeader: true, taskStore }).catch(fail(res));
    } else {
      serveStatic(req, res, publicDir, p, hypitOptions.enabled!==false);
    }
  });
  server.on('listening', () => { if (fs.existsSync(taskDir)) taskStore(); });
  // Native-only capability. No HTTP route accepts this remote credential handoff.
  server.getConnectedRelayAccountId=()=>{
    const owner=relayMode?wallet?.owner?.():'';
    const id=typeof owner==='string'&&/^pikno:[1-9]\d*$/.test(owner)?Number(owner.slice(6)):null;
    return Number.isSafeInteger(id)&&id>0?id:null;
  };
  server.connectCreatedRelayKey=async(value,{assertCurrent}={})=>{
    if(!relayMode||!wallet?.configure)return {ok:false,code:'KEY_STORAGE_UNAVAILABLE'};
    const kind=({'image-standard':'image','video-standard':'video','tool-standard':'tool','chat-standard':'chat'})[value?.group];
    if(!['image','video','tool','chat'].includes(kind)||!Number.isSafeInteger(value.userId)||value.userId<1||typeof value.key!=='string'||!/^sk-[a-zA-Z0-9]{20,128}$/.test(value.key))return {ok:false,code:'KEY_INVALID'};
    const field=({image:'piknoImageKey',video:'piknoVideoKey',tool:'piknoToolKey',chat:'piknoChatKey'})[kind];
    try{
      await wallet.configure({[field]:value.key},{expectedUserId:value.userId,assertCurrent,requireProtected:true});
    }catch(error){
      const status=[error?.statusCode,error?.status].find(value=>Number.isInteger(value)&&value>=100&&value<=599);
      const metadata=status===undefined?{}:{httpStatus:status};
      if(assertCurrent?.()===false)return {ok:false,code:'ACCOUNT_CHANGED',...metadata};
      if(status===429)return {ok:false,code:'RATE_LIMITED',httpStatus:429,retryAfterMs:Number.isFinite(error?.retryAfterMs)?Math.max(1000,Math.min(3600000,error.retryAfterMs)):60000};
      return {ok:false,code:error?.code==='KEY_STORAGE_UNAVAILABLE'?'KEY_STORAGE_UNAVAILABLE':({400:'KEY_INVALID',401:'KEY_INVALID',403:'KEY_FORBIDDEN',409:'ACCOUNT_MISMATCH'})[status]||'CONNECT_FAILED',...metadata};
    }
    let connected=false,limited;
    try{const result=await wallet.connection({kind});connected=result?.[kind]?.state==='ready';if(result?.[kind]?.httpStatus===429)limited={httpStatus:429,retryAfterMs:result[kind].retryAfterMs};}catch{}
    return {ok:true,code:connected?'CONNECTED':'SAVED_CHECK_PENDING',connected,...limited};
  };
  server.on('close', () => { reverse?.stop(); localCodex?.close(); wallet?.stop?.(); tasks?.stop(); activeSmartVideoLauncher.stop?.(); canvasLauncher.stop(); hypit?.stop(); chatcut?.stop(); });
  return server;
}

function openBrowser(url) {
  const cmd = process.platform === 'win32' ? `start "" "${url}"`
    : process.platform === 'darwin' ? `open "${url}"`
    : `xdg-open "${url}"`;
  exec(cmd, (err) => { if (err) console.log('请手动打开浏览器访问:', url); });
}

if (require.main === module) {
  const PORT = Number(process.env.PORT || 8787);
  const relayMode=process.env.HAMSTER_PIKNO_MODE!=='0';
  const app = createApp({walletMode:!relayMode,relayMode});
  app.listen(PORT, '127.0.0.1', () => {
    const url = `http://127.0.0.1:${PORT}`;
    console.log(`仓鼠AI 本地服务已启动: ${url}`);
    openBrowser(url);
  });
}

module.exports = { createApp, createSmartVideoLauncher, findSmartVideoDir };
