  };
  const canvas = require('./canvas.cjs').createCanvas({dir:path.join(path.dirname(configPath),'canvas-data'),getAssets,taskStore,
    baseUrl:()=>`http://127.0.0.1:${server.address().port}`,dhUpstream,walletMode:walletMode||relayMode,relayMode,getExecutionContext:()=>wallet?.executionContext?.()||{owner:'',revision:0},getRhKey:()=>walletMode||relayMode?'':String(loadConfig(configPath).rhApiKey||'')});
  const canvasLauncher = require('./canvas-launcher.cjs').createCanvasLauncher({baseUrl:()=>`http://127.0.0.1:${server.address().port}`});
