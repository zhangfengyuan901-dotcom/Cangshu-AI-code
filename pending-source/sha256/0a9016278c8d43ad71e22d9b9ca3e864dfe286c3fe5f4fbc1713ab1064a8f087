function readBody(req) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    req.on('data', (c) => chunks.push(c));
    req.on('end', () => resolve(chunks.length ? Buffer.concat(chunks) : undefined));
    req.on('error', reject);
  });
}

function readPreferenceBody(req) {
  return new Promise((resolve,reject)=>{
    let size=0,done=false;const chunks=[];
    const finish=(error,value)=>{if(done)return;done=true;req.off('data',data);req.off('end',end);req.off('aborted',aborted);req.off('error',failed);error?reject(error):resolve(value);};
    const data=chunk=>{size+=chunk.length;if(size>UI_PREFERENCES_MAX_BYTES){req.resume();finish({statusCode:413});}else chunks.push(chunk);};
    const end=()=>{try{finish(null,JSON.parse(Buffer.concat(chunks).toString('utf8')));}catch{finish({statusCode:400});}};
    const aborted=()=>finish({statusCode:400});
    const failed=()=>finish({statusCode:400});
    req.on('data',data);req.once('end',end);req.once('aborted',aborted);req.once('error',failed);
  });
}

async function handleUiPreferences(req,res,store,expectedHost) {
  const send=(status,data)=>{res.writeHead(status,{'Content-Type':'application/json; charset=utf-8','Cache-Control':'no-store'});res.end(JSON.stringify(data));};
  if(req.headers.host!==expectedHost || req.headers.origin && req.headers.origin!==`http://${expectedHost}` || req.headers['sec-fetch-site']==='cross-site')return send(403,{error:'请求来源无效'});
  if(req.method==='GET')return send(200,{uiPreferences:store.get()});
  if(req.method!=='POST')return send(405,{error:'操作不支持'});
  if(!/^application\/json(?:\s*;|$)/i.test(req.headers['content-type']||''))return send(415,{error:'请求格式无效'});
  if(Number(req.headers['content-length'])>UI_PREFERENCES_MAX_BYTES){req.resume();return send(413,{error:'请求过大'});}
  let value;
  try {value=await readPreferenceBody(req);} catch(error) {return send(error.statusCode===413?413:400,{error:'页面偏好无效'});}
  if(!validPreference(value))return send(400,{error:'页面偏好无效'});
  try {return send(200,{uiPreferences:await store.set(value)});} catch {return send(503,{error:'页面偏好暂时无法保存'});}
}

const OUTPUT_EXTENSIONS = new Set(['png', 'jpg', 'jpeg', 'webp', 'gif', 'mp4', 'webm', 'mov', 'mp3', 'wav', 'm4a']);
const CONTENT_TYPE_EXTENSIONS = {
  'image/png': 'png', 'image/jpeg': 'jpg', 'image/webp': 'webp', 'image/gif': 'gif',
  'video/mp4': 'mp4', 'video/webm': 'webm', 'video/quicktime': 'mov',
  'audio/mpeg': 'mp3', 'audio/wav': 'wav', 'audio/mp4': 'm4a',
};

function safeOutputExtension(outputType, url, contentType) {
  const requested = String(outputType || '').replace(/^\./, '').toLowerCase();
  if (OUTPUT_EXTENSIONS.has(requested)) return requested;
  const fromUrl = path.extname(new URL(url).pathname).slice(1).toLowerCase();
  if (OUTPUT_EXTENSIONS.has(fromUrl)) return fromUrl;
  return CONTENT_TYPE_EXTENSIONS[String(contentType || '').split(';')[0].toLowerCase()] || 'bin';
}

async function handleSaveResult(req, res, resultDir, timeoutMs) {
  if (req.method !== 'POST') { res.writeHead(405); res.end('Method Not Allowed'); return; }
  const body = await readBody(req);
  let payload;
  try { payload = JSON.parse(body?.toString('utf8') || '{}'); }
  catch { payload = {}; }
  let remoteUrl;
  try {
    remoteUrl = new URL(String(payload.url || ''));
    if (!['http:', 'https:'].includes(remoteUrl.protocol)) throw new Error('unsupported protocol');
  } catch {
    res.writeHead(400, { 'Content-Type': 'application/json; charset=utf-8' });
    res.end(JSON.stringify({ error: 'invalid-result-url', message: '结果链接无效' }));
    return;
  }

  if (res.destroyed) return;
  const controller = new AbortController();
  const disconnected = () => { if (!res.writableFinished) controller.abort(); };
  res.once('close', disconnected);
  const timer = setTimeout(() => controller.abort(), timeoutMs);
  timer.unref?.();
  let download, localPath, created = false, completed = false;
  try {
    download = await fetch(remoteUrl, { signal: controller.signal });
    if (!download.ok || !download.body) {
      res.writeHead(502, { 'Content-Type': 'application/json; charset=utf-8' });
      res.end(JSON.stringify({ error: 'result-download-failed', message: `下载结果失败 (${download.status})` }));
      return;
    }

    fs.mkdirSync(resultDir, { recursive: true });
    const ext = safeOutputExtension(payload.outputType, remoteUrl, download.headers.get('content-type'));
    const taskId = String(payload.taskId || 'result').replace(/[^a-zA-Z0-9_-]/g, '').slice(-48) || 'result';
    const timestamp = new Date().toISOString().replace(/[-:TZ.]/g, '').slice(0, 17);
    const fileName = `仓鼠-${timestamp}-${taskId}.${ext}`;
    localPath = path.join(resultDir, fileName);
    const source = Readable.fromWeb(download.body);
    const output = fs.createWriteStream(localPath, { flags: 'wx' });
    output.once('open', () => { created = true; });
    await pipeline(source, output, { signal: controller.signal });
    completed = true;
    if (res.destroyed) return;
    res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
    res.end(JSON.stringify({ ok: true, fileName, localPath }));
  } catch (err) {
    // An exclusive-open failure must never remove an existing result.
    if (created && !completed) {
      try { fs.unlinkSync(localPath); } catch { /* 未生成完整文件 */ }
    }
    if (res.destroyed) return;
    if (controller.signal.aborted) {
      res.writeHead(504, { 'Content-Type': 'application/json; charset=utf-8' });
      res.end(JSON.stringify({ error: 'result-download-timeout', message: '下载结果超时，请稍后重试' }));
      return;
    }
    throw err;
  } finally {
    clearTimeout(timer);
    res.off('close', disconnected);
    controller.abort();
    if (download?.body && !download.body.locked) await download.body.cancel().catch(() => {});
  }
}

function findSmartVideoDir(explicitDir) {
  const samplePath = path.join('agentkit-samples', 'python', '02-use-cases', 'ad_video_gen_seq');
  const candidates = [
    explicitDir,
    process.env.HAMSTER_SMART_VIDEO_DIR,
    process.resourcesPath && path.join(process.resourcesPath, 'smart-video-agent'),
    path.join(path.dirname(process.execPath), 'smart-video-agent'),
    path.join(__dirname, 'smart-video-agent'),
    path.join(__dirname, samplePath),
    path.join(__dirname, '..', samplePath),
  ].filter(Boolean);
  return candidates.find((dir) => (
    fs.existsSync(path.join(dir, 'pyproject.toml'))
    && fs.existsSync(path.join(dir, 'web.py'))
    && fs.existsSync(path.join(dir, 'studio.py'))
  )) || '';
}

function createSmartVideoLauncher({
  workflowDir,
  url = SMART_VIDEO_URL,
  fetchImpl = fetch,
  spawnImpl = spawn,
  envProvider = () => ({}),
  diagnostics,
  portProbe = inspectPort,
  allocatePort = freeLocalPort,
  dynamicPorts = true,
  runtimeProvider,
  requireIdentity = false,
  startupTimeoutMs = 120000,
} = {}) {
  const initialUrl = new URL(url);
  if(initialUrl.protocol!=='http:' || initialUrl.hostname!=='127.0.0.1' || !initialUrl.port || initialUrl.username || initialUrl.password || initialUrl.pathname!=='/' || initialUrl.search || initialUrl.hash) throw Error('本地对话地址无效');
  let child = null;
  let startError = null, starting = null, captureEnabled = false, failureText = '';
  let resolvedWorkflowDir = typeof workflowDir === 'string' ? workflowDir : '';
  let workflowPending = null;
  let lastPortCheck = null;
  let port = Number(new URL(url).port || 8000), stopped=false, startupTimer=null, healthTimer=null, retries=0;
  function clearStartupWatch(){clearTimeout(startupTimer);clearInterval(healthTimer);}
  const instanceId=require('node:crypto').randomUUID();
  const diag = diagnostics || {log(){},failure(){},redact:String,addSecrets(){},capture(){return ()=>{};}};

  async function resolveWorkflowDir() {
    if (resolvedWorkflowDir) return resolvedWorkflowDir;
    if (typeof workflowDir !== 'function') return '';
    if (!workflowPending) {
      workflowPending = Promise.resolve().then(workflowDir).then((dir) => {
        resolvedWorkflowDir = dir;
        return dir;
      }).catch((error) => {
        workflowPending = null;
        throw error;
      });
    }
    return workflowPending;
  }

  function failed(details) {
    startError = details;
    diag.failure(details);
    return {status:'error',url,...details};
  }

  async function readyUrl() {
    try {
      const response = await fetchImpl(new URL('/studio-api/health', url), {
        signal: AbortSignal.timeout(1500),
        redirect: 'manual',
      });
      if (response.status !== 200) return '';
      const health = await response.json();
      if (health.app === 'hamster-smart-video' && (!requireIdentity || (health.instance===instanceId && health.version===26))) return health;
      return '';
    } catch {
      return '';
    }
  }

  async function start() {
    if(stopped)return {status:'stopped',url};
    if (child && child.exitCode === null) return { status: 'starting', url };
    if (starting) return starting;
    starting = startChecked();
    try {return await starting;} finally {starting=null;}
  }
  async function startChecked() {
    startError = null;
    const [runtime, preparedWorkflowDir] = await Promise.all([
      runtimeProvider ? runtimeProvider() : null,
      resolveWorkflowDir(),
    ]);
    if(stopped)return {status:'stopped',url};
    lastPortCheck = await portProbe(port);
    diag.log('port-preflight',lastPortCheck);
    if (lastPortCheck.state !== 'available' && dynamicPorts) {
      const previous=port;port=await allocatePort();
      if(!Number.isInteger(port)||port<1||port>65535)return failed({code:'PORT_UNAVAILABLE',message:'无法分配本地工作台端口，请稍后重试'});
      url=`http://127.0.0.1:${port}/`;
      diag.log('port-switch',{previous,port,reason:lastPortCheck.state});
    } else if (lastPortCheck.state !== 'available') {
      const owners=(lastPortCheck.owners || []).map(item=>`${item.name}（PID ${item.pid}）`).join('、');
      return failed({code:lastPortCheck.state==='occupied'?'PORT_IN_USE':'PORT_UNAVAILABLE',port,
        message:lastPortCheck.state==='occupied'?'工作台端口被占用，请稍后重试；不要随意结束其他程序':'无法使用本地端口，请检查系统权限或联系支持'});
    }
    const dir = findSmartVideoDir(preparedWorkflowDir);
    if (!dir) {
      return failed({code:'WORKFLOW_MISSING',message:'未找到本地工作流文件，请检查安装是否完整或联系支持'});
    }

    const localVeadk = process.platform === 'win32'
      ? path.join(dir, '.venv', 'Scripts', 'python.exe')
      : path.join(dir, '.venv', 'bin', 'python');
    const bundledUv = process.platform === 'win32'
      ? path.join(dir, 'bin', 'uv.exe')
      : '';
    const command = runtime ? runtime.python : fs.existsSync(localVeadk)
      ? localVeadk
      : fs.existsSync(bundledUv) ? bundledUv : 'uv';
    const args = runtime ? ['-I','-B',runtime.bootstrap,dir,'--port',String(port)] : fs.existsSync(localVeadk)
      ? ['web.py', '--port', String(port)]
      : ['run', 'python', 'web.py', '--port', String(port)];
    const extraEnv = envProvider();
    if(stopped)return {status:'stopped',url};
    diag.addSecrets(extraEnv);
    diag.log('launch',{runtime:runtime?runtime.id:fs.existsSync(localVeadk)?'python-venv':'uv-bootstrap',command,port,workflow:dir});
    let launched;
    try { launched = spawnImpl(command, args, {
      cwd: dir,
      env: {
        ...process.env,
        ...extraEnv,
        PYTHONPATH: [dir, process.env.PYTHONPATH].filter(Boolean).join(path.delimiter),
        PYTHONUNBUFFERED: '1',
        HAMSTER_SERVICE_INSTANCE: instanceId,
        HAMSTER_PARENT_PID: String(process.pid),
        PYTHONNOUSERSITE: '1',
      },
      windowsHide: true,
      stdio: ['ignore','pipe','pipe'],
    }); } catch(error) {return failed(classifyFailure(String(error)));}
    child = launched;
    clearStartupWatch();
    let checking=false;
    healthTimer=setInterval(async()=>{
      if(checking||child!==launched)return;
      checking=true;
      try{if(await readyUrl()){captureEnabled=false;clearStartupWatch();diag.log('health-ready',{port});}}finally{checking=false;}
    },1000);
    healthTimer.unref?.();
    startupTimer=setTimeout(()=>{
      if(child!==launched)return;
      failed({code:'STARTUP_TIMEOUT',message:'本地工作台未在预期时间内通过健康检查，请稍后重试或联系支持'});
      child=null;launched.kill?.();
      clearStartupWatch();
    },startupTimeoutMs);
    startupTimer.unref?.();
    captureEnabled=true;failureText='';
    const note=line=>{
      failureText=(failureText+'\n'+line).slice(-32768);
      if(/Uvicorn running on/i.test(line)){captureEnabled=false;diag.log('ready','本地服务已开始监听；停止采集业务期输出');}
    };
    const enabled=()=>captureEnabled && child===launched;
    const flushOut=diag.capture(launched.stdout,'stdout',note,enabled);
    const flushErr=diag.capture(launched.stderr,'stderr',note,enabled);
    launched.once('error', (err) => {
      if (child !== launched) return;
      flushOut();flushErr();diag.log('spawn-error',String(err));
      failed(classifyFailure(String(err),`启动失败：${diag.redact(err.message)}`));
      child = null;captureEnabled=false;
      clearStartupWatch();
    });
    launched.once('close', (code, signal) => {
      if (child !== launched) return;
      flushOut();flushErr();
      diag.log('process-close',{code,signal});
      clearStartupWatch();
      if(!stopped && dynamicPorts && classifyFailure(failureText).code==='PORT_IN_USE' && retries++<3){
        child=null;captureEnabled=false;
        start().catch(error=>failed(classifyFailure(String(error))));return;
      }
      if(!startError)failed({...classifyFailure(failureText,`本地工作台已退出（代码 ${code ?? '未知'}），请稍后重试或联系支持`),exitCode:code,signal});
      child = null;captureEnabled=false;
    });
    return { status: 'starting', url };
  }

  async function status() {
    if(stopped)return {status:'stopped',url};
    const health = await readyUrl();
    if(stopped)return {status:'stopped',url};
    if (health) {captureEnabled=false;clearStartupWatch();return { status: 'ready', url, progress:{percent:100,stage:'工作台已就绪'} };}
    const progress=child?{percent:95,stage:'启动服务并检查可用性'}:runtimeProvider?.progress?.() || {percent:0,stage:'准备本地服务'};
    if (startError) return { status: 'error', url, ...startError, progress };
    return { status: starting || (child && child.exitCode === null) ? 'starting' : 'stopped', url, progress };
  }

  async function prepare() {
    if(stopped)return {status:'stopped',url};
    const current=await status();
    if(current.status==='ready'||current.status==='starting')return current;
    // Background preparation never opens a browser and never waits for extraction in HTTP.
    start().catch(error=>{diag.log('prepare-error',String(error));failed(classifyFailure(String(error)));});
    return {status:'starting',url,progress:runtimeProvider?.progress?.() || {percent:0,stage:'准备本地服务'}};
  }

  async function open(target = 'chat') {
    if(stopped)return {status:'stopped',url};
    if(target===true) return failed({code:'WORKFLOW_VERSION_MISMATCH',message:'反推改写工作台已停用，请使用对话功能'});
    const health = await readyUrl();
    if(stopped)return {status:'stopped',url};
    if (health) {
      captureEnabled=false;
      clearStartupWatch();
      if (!health.chat) return failed({code:'WORKFLOW_VERSION_MISMATCH',message:'本地对话服务仍是旧版本，请退出旧版应用及其对话窗口后重试'});
      diag.log('reuse-service',{port,version:health.version || 'unknown'});
      const targetUrl = new URL('/chat/', url);
      targetUrl.searchParams.set('instance',instanceId);
      return { status: 'ready', url: targetUrl.href };
    }
    try{return await start();}catch(error){diag.log('prepare-error',String(error));return failed(classifyFailure(String(error)));}
  }

  function stop() {
    stopped=true;clearStartupWatch();
    const launched = child;
    child = null;
    startError = null;captureEnabled=false;
    diag.log('stop','应用正在关闭本次启动的工作台');
    if (!launched || launched.exitCode !== null) return;
    if (process.platform === 'win32' && launched.pid) {
      execFile('taskkill', ['/PID', String(launched.pid), '/T', '/F'], { windowsHide: true }, () => {});
    } else if (typeof launched.kill === 'function') {
      launched.kill();
    }
  }

  async function diagnose() {
    const health=await readyUrl();
    const check=health?{port,host:'127.0.0.1',state:'own-service',version:health.version || null}:await portProbe(port);
    const dir=findSmartVideoDir(resolvedWorkflowDir);
    const exists=relative=>!!dir && fs.existsSync(path.join(dir,relative));
    const deferredWorkflow=typeof workflowDir==='function' && !dir;
    return {service:health?'ready':child?'starting':startError?'error':'stopped',port:check,lastPortCheck,
      workflow:{found:!!dir || deferredWorkflow,deferred:deferredWorkflow,webEntry:exists('web.py'),manifest:exists('pyproject.toml'),
        python:exists(process.platform==='win32'?'.venv/Scripts/python.exe':'.venv/bin/python'),bundledRuntime:!!runtimeProvider,bundledLauncher:exists('bin/uv.exe')},currentFailure:startError};
  }
  return { open, prepare, status, stop, diagnose };
}

async function handleSmartVideo(req, res, launcher, action, creative = false) {
  const allowedMethod = action === 'status' ? 'GET' : 'POST';
  if (req.method !== allowedMethod) { res.writeHead(405); res.end('Method Not Allowed'); return; }
  const payload = action === 'open' ? await launcher.open(creative) : action === 'prepare' ? await launcher.prepare() : await launcher.status();
  const statusCode = payload.status === 'error' ? 503 : 200;
  res.writeHead(statusCode, { 'Content-Type': 'application/json; charset=utf-8' });
  res.end(JSON.stringify(payload));
}

function serveStatic(req, res, publicDir, pathname, internalUi=false) {
  if (req.method !== 'GET' && req.method !== 'HEAD') {
    res.writeHead(405); res.end('Method Not Allowed'); return;
  }
  const filePath = pathname === '/' ? 'index.html' : pathname.slice(1);
  const full = path.normalize(path.join(publicDir, filePath));
  if (!full.startsWith(publicDir)) { res.writeHead(403); res.end('Forbidden'); return; }
  fs.readFile(full, (err, data) => {
    if (err) {
      res.writeHead(err.code === 'ENOENT' ? 404 : 500);
      res.end(err.code === 'ENOENT' ? 'Not Found' : 'Server Error');
      return;
    }
    if(filePath==='index.html'){const html=data.toString('utf8');data=Buffer.from(internalUi?require('./hypit-ui.cjs')(html):html.replace(/<!-- INTERNAL_[A-Z]+ -->/g,''));}
    const ext = path.extname(full).toLowerCase();
    res.writeHead(200, { 'Content-Type': MIME[ext] || 'application/octet-stream' });
    res.end(data);
  });
}

