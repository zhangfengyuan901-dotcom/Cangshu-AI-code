  let localCodex=codexClient;
  let reverse;
  const getReverse=()=>reverse ||= require('./reverse.cjs').createReverse({dir:path.join(path.dirname(configPath),'reverse-history'),getContext:()=>relayMode?wallet.reverseContext():{},...reverseOptions});
  const codexRoutes=require('./codex-routes.cjs').createCodexRoutes({
    getClient:()=>localCodex ||= require('./codex-local.cjs').createLocalCodex({dir:path.join(path.dirname(configPath),'codex-sessions'),...codexOptions}),
    chooseDirectory:codexOptions.chooseDirectory,
