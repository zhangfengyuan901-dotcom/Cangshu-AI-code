  const getAssets = () => assetsHandler ||= require('./assets.cjs').createAssets(assetDir,resultDir,uploadObject,uploadDirectObject);
  const taskStore = () => {
    if (!tasks) {
      tasks = require('./tasks.cjs').createTasks({dir:taskDir, resultDir, upstream, officialVideoUpstream, dhUpstream,
        walletQuery:wallet?item=>wallet.query(item):undefined,walletUser:()=>relayMode?wallet.owner():String(loadConfig(configPath).billingUserId||''),relayMode,
        getKey:provider => {
