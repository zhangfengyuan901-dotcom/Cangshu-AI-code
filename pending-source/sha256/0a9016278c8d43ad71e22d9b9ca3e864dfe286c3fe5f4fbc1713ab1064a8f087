/* 本地配置端点：GET 查询是否已配置 Key，POST 保存 Key 到 config.json */
async function handleConfig(req, res, configPath) {
  if (req.method === 'GET') {
    res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
    return res.end(JSON.stringify(configStatus(configPath)));
  }
  if (req.method === 'POST') {
    const body = await readBody(req);
    let payload = {};
    try { payload = body && body.length ? JSON.parse(body.toString('utf8')) : {}; } catch { payload = {}; }
    const cfg = loadConfig(configPath);
    if (typeof payload.apiKey === 'string') cfg.apiKey = payload.apiKey.trim();
    if (typeof payload.videoApiKey === 'string') cfg.videoApiKey = payload.videoApiKey.trim();
    if (typeof payload.rhApiKey === 'string') cfg.rhApiKey = payload.rhApiKey.trim();
    delete cfg.llmApiKey;
    delete cfg.llmEndpointId;
    delete cfg.creativeEndpointId;
    saveConfig(configPath, cfg);
    const configured = Boolean((cfg.apiKey || '').trim());
    res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
    return res.end(JSON.stringify({
      ok: true,
      configured,
      videoConfigured: Boolean((cfg.videoApiKey || '').trim()),
      rhConfigured: Boolean((cfg.rhApiKey || '').trim()),
      llmConfigured: configured,
      inferenceMode: 'cloud-auto',
    }));
  }
  res.writeHead(405); res.end('Method Not Allowed');
}

/*
 * 通用转发：把请求原样转发到上游，并注入 Authorization。
 * multipart 上传（媒体上传）也能直接透传——content-type 含 boundary，body 为原始 Buffer。
 */
async function forward(req, res, { target, apiKey, dualHeader, taskStore }) {
  const headers = {};
  for (const [k, v] of Object.entries(req.headers)) {
    if (SKIP_REQ_HEADERS.has(k)) continue;
    headers[k] = v;
  }
  if (apiKey) {
    headers['Authorization'] = `Bearer ${apiKey}`;
    if (dualHeader) headers['X-API-Key'] = apiKey; // 图片/视频兼容头
  }
  let body = await readBody(req);
  const routePath = new URL(req.url, 'http://localhost').pathname;
  let taskPayload;
  try { taskPayload = JSON.parse(body?.toString('utf8') || '{}'); } catch { taskPayload = {}; }
  if (req.method === 'POST' && routePath === '/api/images') {
    const { IMAGE_ROUTES } = await import('./legacy-routes.mjs');
    const payload = taskPayload;
    if (!IMAGE_ROUTES.some((route) => route.id === payload.model)) {
      res.writeHead(400, { 'Content-Type': 'application/json; charset=utf-8' });
      res.end(JSON.stringify({ error: '请选择当前可用的仓鼠图片线路' }));
      return;
    }
  }
  if (req.method === 'POST' && routePath === '/api/videos') {
    const { VIDEO_ROUTES, mediaLimitError } = await import('./legacy-routes.mjs');
    const payload = taskPayload;
    const route = VIDEO_ROUTES.find((r) => r.id === payload.model);
    let error = route ? '' : '请选择当前可用的仓鼠视频线路';
    const media = [];
    for (const [field, kind] of [['images', 'image'], ['videos', 'video'], ['audios', 'audio']]) {
      if (payload[field] !== undefined && !Array.isArray(payload[field])) error = '素材参数格式错误';
      for (const item of Array.isArray(payload[field]) ? payload[field] : []) media.push({ kind });
    }
    if (!error) error = mediaLimitError({ ...route, type: 'video' }, media);
    if (!error && payload.resolution && !route.resolutions.includes(payload.resolution)) error = '所选线路不支持此画质';
    if (!error && payload.ratio && !route.ratios.includes(payload.ratio)) error = '所选线路不支持此画面比例';
    if (!error && payload.duration !== undefined && !route.durations.includes(Number(payload.duration))) error = '所选线路不支持此时长';
    if (error) {
      res.writeHead(400, { 'Content-Type': 'application/json; charset=utf-8' });
      res.end(JSON.stringify({ error }));
      return;
    }
  }
  if (req.method === 'POST' && routePath === '/api/official-videos') {
    const { OFFICIAL_VIDEO_ROUTE, buildOfficialVideoProviderPayload, mediaLimitError } = await import('./legacy-routes.mjs');
    const payload = taskPayload;
    let error = payload.model === OFFICIAL_VIDEO_ROUTE.id ? '' : '请选择当前可用的官方备选线路';
    const media = [];
    for (const [field, kind] of [['images','image'],['videos','video'],['audios','audio']]) {
      if (payload[field] !== undefined && !Array.isArray(payload[field])) error = '素材参数格式错误';
      for (const item of Array.isArray(payload[field]) ? payload[field] : []) {
        const value = typeof item === 'string' ? item : item?.url;
        try { const parsed = new URL(value); if (!['http:','https:'].includes(parsed.protocol)) throw new Error(); }
        catch { error = '素材必须使用可公开访问的 HTTP/HTTPS 地址'; }
        media.push({kind});
      }
    }
    if (!error) error = mediaLimitError(OFFICIAL_VIDEO_ROUTE, media);
    if (!error && !String(payload.prompt || '').trim()) error = '请输入提示词';
    if (!error && payload.resolution !== OFFICIAL_VIDEO_ROUTE.default_resolution) error = '官方视频生成仅开放480p';
    if (!error && !OFFICIAL_VIDEO_ROUTE.ratios.includes(payload.ratio)) error = '官方视频生成不支持此画面比例';
    if (!error && !OFFICIAL_VIDEO_ROUTE.durations.includes(Number(payload.duration))) error = '官方视频生成不支持此时长';
    if (error) {
      res.writeHead(400, { 'Content-Type':'application/json; charset=utf-8' });
      res.end(JSON.stringify({error}));
      return;
    }
    body = Buffer.from(JSON.stringify(buildOfficialVideoProviderPayload(payload, OFFICIAL_VIDEO_MODEL)));
  }
  const route = routePath;
  const track = req.method === 'POST' && (/^\/api\/(videos|images|official-videos)$/.test(route) || /^\/rh\/run\/ai-app\//.test(route));
  const journal = track && taskStore ? taskStore() : null;
  const submission = journal?.begin(route, taskPayload, apiKey, req.headers['idempotency-key']);
  const respondAsync = Boolean(submission && /(?:^|,)\s*respond-async(?:\s|,|$)/i.test(String(req.headers.prefer || '')));
  if (respondAsync) delete headers.prefer;
  const submit = async () => {
    try {
      const upstreamRes = await fetch(target, { method: req.method, headers, body, signal:AbortSignal.timeout(120000) });
      const buffer = Buffer.from(await upstreamRes.arrayBuffer());
      if (submission) {
        let data; try { data = JSON.parse(buffer.toString('utf8')); } catch { data = {}; }
        await journal.capture(submission, data, upstreamRes.status);
      }
      return { upstreamRes, buffer };
    } catch (error) {
      if (submission) journal.uncertain(submission);
      throw error;
    }
  };
  if (respondAsync) {
    res.writeHead(202, { 'Content-Type':'application/json; charset=utf-8', 'Cache-Control':'no-store' });
    res.end(JSON.stringify({ accepted:true, task:journal.view(submission) }));
    setImmediate(() => submit().catch(() => {}));
    return;
  }
  const { upstreamRes, buffer } = await submit();
  const resHeaders = {};
  for (const [k, v] of upstreamRes.headers) {
    if (['content-length', 'connection', 'transfer-encoding'].includes(k)) continue;
    resHeaders[k] = v;
  }
  res.writeHead(upstreamRes.status, resHeaders);
  res.end(buffer);
}

async function forwardStream(req, res, { target, apiKey, dualHeader }) {
  const headers = {};
  for (const [key, value] of Object.entries(req.headers)) {
    if (SKIP_REQ_HEADERS.has(key)) continue;
    headers[key] = value;
  }
  headers['Content-Length'] = String(req.headers['content-length']);
  if (apiKey) {
    headers.Authorization = `Bearer ${apiKey}`;
    if (dualHeader) headers['X-API-Key'] = apiKey;
  }
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 180000);
  const abort = () => controller.abort();
  req.once('aborted', abort);
  try {
    const upstreamRes = await fetch(target, {
      method: req.method,
      headers,
      body: req,
      duplex: 'half',
      signal: controller.signal,
    });
    const responseHeaders = {};
    for (const [key, value] of upstreamRes.headers) {
      if (['connection', 'transfer-encoding'].includes(key)) continue;
      responseHeaders[key] = value;
    }
    res.writeHead(upstreamRes.status, responseHeaders);
    if (!upstreamRes.body) res.end();
    else await pipeline(Readable.fromWeb(upstreamRes.body), res);
  } finally {
    clearTimeout(timeout);
    req.off('aborted', abort);
  }
}

function createApp({
