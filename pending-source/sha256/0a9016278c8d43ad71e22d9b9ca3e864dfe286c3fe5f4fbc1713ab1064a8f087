/* ---------- config.json（可选，服务端持久化 API Key） ---------- */
function loadConfig(configPath) {
  try { return JSON.parse(fs.readFileSync(configPath, 'utf8')); }
  catch { return {}; }
}
function saveConfig(configPath, cfg) {
  fs.writeFileSync(configPath, JSON.stringify(cfg, null, 2) + '\n', 'utf8');
}
function purgeLegacyInferenceConfig(configPath) {
  const cfg = loadConfig(configPath);
  const fields = ['llmApiKey', 'llmEndpointId', 'creativeEndpointId'];
  if (!fields.some(field => Object.prototype.hasOwnProperty.call(cfg, field))) return;
  for (const field of fields) delete cfg[field];
  saveConfig(configPath, cfg);
}
function configStatus(configPath) {
  const cfg = loadConfig(configPath);
  const configured = Boolean((cfg.apiKey || '').trim());
  return {
    configured,
    videoConfigured: Boolean((cfg.videoApiKey || '').trim()),
    rhConfigured: Boolean((cfg.rhApiKey || '').trim()),
    llmConfigured: configured,
    inferenceMode: 'cloud-auto',
  };
}

/* 解析图片/视频 API Key：Authorization / X-API-Key / x-sandbox-key 优先，其次 config.json */
function resolveGenKey(req, configPath) {
  const auth = String(req.headers['authorization'] || '');
  const m = auth.match(/^Bearer\s+(.+)$/i);
  if (m && m[1].trim()) return m[1].trim();
  const xk = String(req.headers['x-api-key'] || req.headers['x-sandbox-key'] || '');
  if (xk.trim()) return xk.trim();
  const cfg = loadConfig(configPath);
  return (cfg.apiKey || '').trim();
}

/* 解析数字人 API Key：x-rh-key 优先，其次 config.json */
