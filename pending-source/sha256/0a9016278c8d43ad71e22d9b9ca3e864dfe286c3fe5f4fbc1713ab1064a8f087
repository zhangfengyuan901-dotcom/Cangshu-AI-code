  let chatcut;
  const getChatCut=()=>chatcut ||= require('./chatcut.cjs').createChatCut({
    dir:path.join(path.dirname(configPath),'chatcut-data'),resultDir,taskStore,
    getExecutionContext:()=>relayMode?wallet.executionContext():{owner:'',scope:'',revision:0},
    ...chatcutOptions,
