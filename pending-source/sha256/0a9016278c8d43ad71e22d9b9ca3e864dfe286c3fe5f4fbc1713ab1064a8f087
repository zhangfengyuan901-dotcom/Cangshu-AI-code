  const accountViewRoutes=require('./relay-account-view.cjs').createAccountViewRoutes({view:accountView});
  const server = http.createServer((req, res) => {
    res.setHeader('Content-Security-Policy', "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src http://127.0.0.1:*");
    const url = new URL(req.url, 'http://localhost');
    const p = url.pathname;
    if(relayMode&&p.startsWith('/api/')&&(!/^127\.0\.0\.1:\d+$/.test(req.headers.host||'')||req.headers.origin&&req.headers.origin!==`http://${req.headers.host}`||req.headers['sec-fetch-site']==='cross-site')){
