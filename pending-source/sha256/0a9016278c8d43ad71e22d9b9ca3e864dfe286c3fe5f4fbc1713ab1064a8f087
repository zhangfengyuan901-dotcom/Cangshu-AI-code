  // 数字人：/rh/xxx → /openapi/v2/xxx
  const dhTarget = (url) => dhUpstream + url.pathname.replace(/^\/rh/, '') + url.search;

  const fail = (res, sdkError = false) => async (err) => {
    const {customerErrorMessage}=await import('./public/customer-errors.mjs');
    const expectedDisabled = Number(err?.statusCode) === 503 && err?.code === 'assistant_disabled';
    const expectedRateLimit=Number(err?.statusCode)===429;
    if (!res[reportHandled] && !expectedDisabled && !expectedRateLimit) report('service',err);
    res[reportHandled] = true;
    if (res.destroyed) return;
    if (res.headersSent) { res.destroy(); return; }
    const status = Number.isInteger(err?.statusCode) && err.statusCode >= 400 && err.statusCode <= 599 ? err.statusCode : 500;
    const rejectedBeforeExecution=err?.code==='llm_rejected_before_execution'&&err?.submissionState==='rejected_before_execution';
    const retryAfterMs=expectedRateLimit?(Number.isFinite(err?.retryAfterMs)?Math.max(1000,Math.min(3600000,err.retryAfterMs)):60000):0;
    res.writeHead(status, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control':'no-store',...(retryAfterMs?{'Retry-After':String(Math.ceil(retryAfterMs/1000))}:{}) });
    const body={ error: customerErrorMessage(err,{status}),...(retryAfterMs?{retryAfterMs,httpStatus:429}:{}),...((rejectedBeforeExecution||/^(?:quote_(invalid|expired|changed|parameters_changed|already_submitted)|media_(duration_required|reference_expired|metadata_unavailable)|assistant_disabled|llm_(unknown|not_submitted|price_changed|request_conflict|capability_unavailable))$/.test(err?.code||''))?{code:err.code}:{}),...(rejectedBeforeExecution?{submission_state:'rejected_before_execution'}:err?.submissionState==='not_submitted'&&err?.code!=='llm_rejected_before_execution'?{submission_state:'not_submitted'}:{}) };
    // The locked SDK retains only `error`; keep execution evidence inside it.
    if(sdkError)body.error={message:body.error,...(body.code?{code:body.code}:{}),...(body.submission_state?{submission_state:body.submission_state}:{})};
