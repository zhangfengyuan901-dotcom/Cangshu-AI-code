body > .app[inert] {
  visibility: hidden;
}

body > .app[hidden] {
  display: none;
}

.startup-splash {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  align-items: safe center;
  justify-items: center;
  overflow: auto;
  padding: clamp(16px, 5vw, 56px);
  color: #163a2d;
  background:
    radial-gradient(ellipse at 86% 10%, #d8ecdf, transparent 52%),
    radial-gradient(ellipse at 10% 90%, #f4e7cd, transparent 48%),
    #eff5ee;
}

.startup-splash[hidden],
.startup-splash-actions[hidden] {
  display: none;
}

.startup-splash-inner {
  display: grid;
  grid-template-columns: minmax(172px, 232px) minmax(0, 1fr);
  align-items: center;
  gap: clamp(22px, 5vw, 46px);
  width: min(100%, 700px);
  padding: clamp(18px, 4vw, 30px);
  border: 1px solid #d7e4d9;
  border-radius: 24px;
  background: #fdfefb;
  box-shadow: 0 28px 76px #193f2d1c;
}

.startup-splash-visual {
  position: relative;
  display: grid;
  place-items: center;
  min-height: 192px;
  padding: 26px 12px;
  overflow: hidden;
  border-radius: 15px;
  background: radial-gradient(ellipse at 50% 48%, #35644b, #16382e 77%);
}

.startup-splash-visual::before,
.startup-splash-visual::after {
  position: absolute;
  inset-inline: 0;
  height: 7px;
  content: "";
  background: repeating-linear-gradient(90deg, #91b39c65 0 11px, transparent 11px 22px) center;
}

.startup-splash-visual::before { top: 9px; }
.startup-splash-visual::after { bottom: 9px; }

.startup-splash-frame {
  position: relative;
  width: 128px;
  overflow: hidden;
  border-radius: 12px;
  box-shadow: 0 0 0 1px #102d24, 0 0 0 6px #c2ddc342, 0 12px 24px #0d251c80;
}

.startup-splash-frame img {
  display: block;
  width: 100%;
  height: auto;
  image-rendering: pixelated;
}

.startup-splash-frame::after {
  position: absolute;
  inset: 0;
  content: "";
  background: linear-gradient(180deg, transparent 65%, #defbd95c 98%, #f7ffe1cc 100%);
  animation: startup-splash-scan 2.7s ease-in-out infinite;
}

.startup-splash-eyebrow {
  margin: 0 0 8px;
  color: #2e6a52;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .13em;
}

.startup-splash-copy h1 {
  margin: 0;
  font-size: clamp(25px, 4.5vw, 36px);
  line-height: 1.3;
  letter-spacing: -.035em;
}

.startup-splash-status {
  min-height: 2.9em;
  margin: 10px 0 0;
  color: #4c685c;
  font-size: 14px;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.startup-splash-progress {
  width: min(100%, 240px);
  height: 4px;
  margin-top: 12px;
  overflow: hidden;
  border-radius: 4px;
  background: #dce9df;
}

.startup-splash-progress::after {
  display: block;
  width: 36%;
  height: 100%;
  border-radius: inherit;
  content: "";
  background: #24825f;
  animation: startup-splash-track 1.9s ease-in-out infinite;
}

.startup-splash-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 14px;
}

.startup-splash-actions button {
  min-height: 42px;
  padding: 8px 12px;
  border: 1px solid #36785c;
  border-radius: 8px;
  color: #205a43;
  background: #fdfefb;
  font: inherit;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
}

.startup-splash-actions #retryStartup {
  color: #fff;
  background: #21674d;
}

.startup-splash-actions button:hover { box-shadow: 0 0 0 2px #b7d8c6; }
.startup-splash-actions button:focus-visible { outline: 2px solid #256e51; outline-offset: 3px; }
.startup-splash:has(.startup-splash-actions:not([hidden])) .startup-splash-progress { display: none; }
.startup-splash:has(.startup-splash-actions:not([hidden])) .startup-splash-frame::after { display: none; }

@keyframes startup-splash-scan {
  0%, 18% { transform: translateY(-100%); }
  73%, 100% { transform: translateY(42%); }
}

@keyframes startup-splash-track {
  0% { transform: translateX(-105%); }
  100% { transform: translateX(285%); }
}

@media (max-width: 540px) {
  .startup-splash-inner { grid-template-columns: 1fr; gap: 20px; }
  .startup-splash-visual { min-height: 144px; }
  .startup-splash-frame { width: 92px; }
}

@media (prefers-reduced-motion: reduce) {
  .startup-splash-frame::after { display: none; }
  .startup-splash-progress::after { animation: none; transform: translateX(90%); }
}
