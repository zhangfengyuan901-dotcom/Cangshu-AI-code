// Two fixed workflows, no wallet and no customer database. Atomic R2 claims
// prevent an ambiguous paid submission from being executed a second time.
import {toolCredential,toolConfiguration} from './tools-config.mjs';
const RH='https://www.runninghub.cn/openapi/v2';
const WORKFLOWS={digital:'2087890031699648513',depth:'2089021172049596418'};
const OUTPUT_HOSTS=new Set(['rh-images-1252422369.cos.ap-beijing.myqcloud.com','rh-comfyui01.tos-cn-beijing.volces.com']);
const encoder=new TextEncoder();
const sameSecret=async(a,b)=>{
  const hashes=await Promise.all([a,b].map(value=>crypto.subtle.digest('SHA-256',encoder.encode(value))));
  const x=new Uint8Array(hashes[0]),y=new Uint8Array(hashes[1]);let difference=0;for(let i=0;i<x.length;i++)difference|=x[i]^y[i];return difference===0;
};
const sha=async data=>Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',data)),byte=>byte.toString(16).padStart(2,'0')).join('');

export async function tools(request,env,{ticket,inspect,signClaims,boundedBytes,fail,json}){
  if(new URL(request.url).pathname.startsWith('/media/v1/tools/config'))return toolConfiguration(request,env,{sameSecret,boundedBytes,fail,json});
  if(!env.TOOLS_BRIDGE_SECRET||env.TOOLS_BRIDGE_SECRET.length<32||!env.TOOLS_ADMIN_SECRET||env.TOOLS_ADMIN_SECRET.length<32||
    await sameSecret(env.TOOLS_ADMIN_SECRET,env.TOOLS_BRIDGE_SECRET))throw fail(503,'Tool service unavailable');
  const auth=request.headers.get('authorization')||'';
  if(auth.length>512||!await sameSecret(auth,'Bearer '+env.TOOLS_BRIDGE_SECRET))throw fail(401,'Tool execution authorization required');
  const statusUrl=new URL(request.url);
  if(statusUrl.pathname==='/media/v1/tools/status'){
    if(request.method!=='GET'||statusUrl.search)throw fail(405,'Tool operation unavailable');
    const enabled=env.TOOLS_ENABLED==='true',credential_configured=Boolean((await toolCredential(env)).key);
    const ready=enabled&&credential_configured;
    // Configuration readiness is not an upstream authorization or paid test.
    return json({enabled,credential_configured,ready,tools:{digital:{available:ready,max_audio_seconds:30},depth:{available:ready}}});
  }
  const url=new URL(request.url),match=/^\/media\/v1\/tools(?:\/([A-Za-z0-9_-]{1,200})(\/content)?)?$/.exec(url.pathname);
  if(!match||url.search)throw fail(404,'Tool operation unavailable');
  const write=async(key,value)=>env.MEDIA.put(key,JSON.stringify(value),{httpMetadata:{contentType:'application/json'}});
  const read=async key=>{const object=await env.MEDIA.get(key);return object?JSON.parse(new TextDecoder().decode(await object.arrayBuffer())):null;};
  const acquirePoll=async id=>{
    const key='tool-polls/'+id,now=Math.floor(Date.now()/1000),current=await env.MEDIA.head(key);
    if(current&&Number(current.customMetadata?.expires)>now)return null;
    const lease=crypto.randomUUID(),saved=await env.MEDIA.put(key,'polling',{onlyIf:current?{etagMatches:current.etag}:{etagDoesNotMatch:'*'},customMetadata:{lease,expires:String(now+600)}});
    return saved?{key,lease}:null;
  };
  const releasePoll=async lease=>{
    try{const current=await env.MEDIA.head(lease.key);if(current?.customMetadata?.lease===lease.lease)await env.MEDIA.delete(lease.key);}catch{}
  };
  let credential;
  const rh=async(path,options)=>{
    if(!credential?.key)throw fail(503,'Tool credential unavailable');
    const response=await fetch(RH+path,{...options,headers:{...options.headers,Authorization:'Bearer '+credential.key},redirect:'manual',signal:AbortSignal.timeout(180000)});
    const bytes=await boundedBytes(response.body,65536);let data;try{data=JSON.parse(new TextDecoder().decode(bytes));}catch{throw fail(502,'Tool response uncertain');}
    if(!response.ok){
      const error=fail(502,'Tool response uncertain');
      // A complete non-timeout 4xx rejects this request. A network loss, 408 or
      // server failure cannot prove that a paid submission was not accepted.
      error.definitiveRejection=response.status>=400&&response.status<500&&response.status!==408;
      throw error;
    }
    return data;
  };
  async function upload(asset){
    const ext={'image/png':'png','image/jpeg':'jpg','image/webp':'webp','video/mp4':'mp4','video/webm':'webm','video/quicktime':'mov','audio/mpeg':'mp3','audio/wav':'wav','audio/mp4':'m4a','audio/aac':'aac'}[asset.mime];
    const boundary='pikno-tool-'+crypto.randomUUID().replaceAll('-','');
    const start=encoder.encode(`--${boundary}\r\nContent-Disposition: form-data; name="file"; filename="reference.${ext}"\r\nContent-Type: ${asset.mime}\r\n\r\n`),end=encoder.encode(`\r\n--${boundary}--\r\n`);
    const stream=new FixedLengthStream(start.length+asset.size+end.length),writer=stream.writable.getWriter();
    const pumping=(async()=>{
      try{
        await writer.write(start);const object=await env.MEDIA.get(asset.key);if(!object)throw fail(404,'Reference missing');
        const reader=object.body.getReader();try{for(;;){const part=await reader.read();if(part.done)break;await writer.write(part.value);}}finally{reader.releaseLock();}
        await writer.write(end);await writer.close();
      }catch(error){await writer.abort(error);}
    })();
    void pumping;
    const result=await rh('/media/upload/binary',{method:'POST',headers:{'Content-Type':'multipart/form-data; boundary='+boundary},body:stream.readable,duplex:'half'});
    const file=result.data?.fileName||result.data?.filename||result.data?.download_url;
    if(![0,200].includes(result.code)||typeof file!=='string'||!file||file.length>512||/[\r\n]/.test(file))throw fail(502,'Tool reference upload failed');
    return file;
  }
  const outputUrl=async job=>{
    const p=job.output,now=Math.floor(Date.now()/1000),meta=await env.MEDIA.head(p.key);
    if(!meta||meta.size!==p.size||meta.customMetadata?.uid!==String(job.uid)||Number(meta.customMetadata?.expires)<=now)throw fail(404,'Tool result expired');
    const signed=await signClaims({v:1,aud:'pikno-relay-media',uid:job.uid,id:p.id,op:'read',iat:now,exp:now+7200,mime:'video/mp4',size:p.size},env.TICKET_KEY);
    return 'https://www.piknoai.com/media/v1/assets/'+p.id+'?ticket='+signed;
  };
  const present=async job=>({id:job.id,status:job.status,outputs:job.status==='completed'?[{type:'video',url:await outputUrl(job)}]:[]});
  if(match[2]){
    if(!['GET','HEAD'].includes(request.method))throw fail(405,'Tool result operation unavailable');
    const job=await read('tool-jobs/'+match[1]),p=job?.output;
    if(job?.status!=='completed'||!p)throw fail(404,'Tool result unavailable');
    const direct=request.method==='GET'&&!request.headers.has('Range');
    let object=direct?await env.MEDIA.get(p.key):null;
    const meta=direct?object:await env.MEDIA.head(p.key);
    if(!meta||meta.size!==p.size||meta.customMetadata?.uid!==String(job.uid)||meta.httpMetadata?.contentType!=='video/mp4'||Number(meta.customMetadata?.expires)<=Date.now()/1000){
      try{await object?.body?.cancel();}catch{}
      throw fail(404,'Tool result expired');
    }
    const headers={'Content-Type':'video/mp4','Content-Length':String(meta.size),'Cache-Control':'private, no-store','Content-Disposition':'attachment','X-Content-Type-Options':'nosniff','Referrer-Policy':'no-referrer','Accept-Ranges':'bytes'};
    let range,status=200;
    if(request.method==='GET'&&request.headers.has('Range')){
      const m=/^bytes=(\d*)-(\d*)$/.exec(request.headers.get('Range'));
      const invalid=()=>new Response(null,{status:416,headers:{...headers,'Content-Length':'0','Content-Range':`bytes */${meta.size}`}});
      if(!m||(!m[1]&&!m[2]))return invalid();
      const start=m[1]?Number(m[1]):Math.max(0,meta.size-Number(m[2])),end=m[1]&&m[2]?Math.min(Number(m[2]),meta.size-1):meta.size-1;
      if(!Number.isSafeInteger(start)||!Number.isSafeInteger(end)||start>=meta.size||end<start||(!m[1]&&Number(m[2])===0))return invalid();
      range={offset:start,length:end-start+1};status=206;headers['Content-Length']=String(range.length);headers['Content-Range']=`bytes ${start}-${end}/${meta.size}`;
    }
    if(request.method==='GET'&&!object)object=await env.MEDIA.get(p.key,range?{range}:undefined);
    if(request.method==='GET'&&!object)throw fail(404,'Tool result missing');
    return new Response(object?.body||null,{status,headers});
  }
  if(request.method==='GET'&&match[1]){
    const key='tool-jobs/'+match[1],job=await read(key);
    // Lost/expired markers are uncertain, not proof the original job failed.
    if(!job)return json({id:match[1],status:'unknown',outputs:[]});
    if(job.status==='completed'){
      try{return json(await present(job));}catch{return json({id:job.id,status:'unknown',outputs:[]});}
    }
    if(job.status==='failed'||!job.provider_task_id)return json(await present(job));
    const lease=await acquirePoll(job.id);
    if(!lease)return json({id:job.id,status:'processing',outputs:[]});
    let stage='credential';
    const diagnostic={};
    const uncertain=async code=>{
      // Private, fixed diagnostics only. Provider responses, URLs and secrets
      // must never be persisted or returned as diagnostic details.
      try{job.poll_diagnostic={code,stage,...diagnostic};await write(key,job);}catch{}
      return json({id:job.id,status:'unknown',outputs:[]});
    };
    try{
      credential=await toolCredential(env,job.credential_version||'legacy');
      stage='query';
      const result=await rh('/query',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({taskId:job.provider_task_id})});
      const data=result.data&&typeof result.data==='object'?result.data:result,status=String(data.status||'').toUpperCase();
      diagnostic.provider_status=['SUCCESS','FAILED','FAILURE','CANCEL','CREATE','RUNNING','QUEUED','PENDING'].includes(status)?status:'UNRECOGNIZED';
      if(['FAILED','FAILURE','CANCEL'].includes(status)){job.status='failed';await write(key,job);return json(await present(job));}
      if(['CREATE','RUNNING','QUEUED','PENDING'].includes(status))return json({id:job.id,status:'processing',outputs:[]});
      if(status!=='SUCCESS')return await uncertain('PROVIDER_STATUS_UNRECOGNIZED');
      stage='output';
      const outputs=data.results||result.results,output=Array.isArray(outputs)?outputs.find(item=>['video','mp4','video/mp4'].includes(String(item.outputType||'').toLowerCase())):null;
      diagnostic.output_count=Array.isArray(outputs)?Math.min(outputs.length,10000):0;
      diagnostic.video_output=Boolean(output);diagnostic.output_url=typeof output?.url==='string';
      if(!output||typeof output.url!=='string')return await uncertain('OUTPUT_UNRECOGNIZED');
      stage='output_url';
      const remote=new URL(output.url),host=remote.hostname.toLowerCase().replace(/\.$/,'');
      diagnostic.output_host_allowed=OUTPUT_HOSTS.has(host);
      if(remote.protocol!=='https:'||remote.username||remote.password||(remote.port&&remote.port!=='443')||!OUTPUT_HOSTS.has(host))return await uncertain('OUTPUT_URL_REJECTED');
      stage='download';
      const response=await fetch(remote.href,{redirect:'manual',signal:AbortSignal.timeout(180000)});
      diagnostic.download_status=response.status;
      const declaredLength=Number(response.headers.get('Content-Length'));
      if(Number.isSafeInteger(declaredLength)&&declaredLength>=0)diagnostic.declared_bytes=declaredLength;
      if(!response.ok||declaredLength>(50<<20))return await uncertain(!response.ok?'DOWNLOAD_HTTP_REJECTED':'OUTPUT_TOO_LARGE');
      stage='download_body';
      const bytes=await boundedBytes(response.body,50<<20);
      diagnostic.received_bytes=bytes.length;
      if(bytes.length<12||new TextDecoder().decode(bytes.slice(4,8))!=='ftyp')return await uncertain('OUTPUT_FORMAT_REJECTED');
      stage='store';
      const id=(await sha(encoder.encode('tool-output:'+job.id))).slice(0,32),objectKey=`input/${job.uid}/${id}`,created=Math.floor(Date.now()/1000);
      const stored=await env.MEDIA.put(objectKey,bytes,{onlyIf:{etagDoesNotMatch:'*'},httpMetadata:{contentType:'video/mp4'},customMetadata:{uid:String(job.uid),expires:String(created+86400)}});
      if(!stored){const existing=await env.MEDIA.head(objectKey);if(!existing||existing.size!==bytes.length||existing.httpMetadata?.contentType!=='video/mp4'||existing.customMetadata?.uid!==String(job.uid))return await uncertain('OUTPUT_STORE_CONFLICT');}
      delete job.poll_diagnostic;
      job.output={id,key:objectKey,size:bytes.length};job.status='completed';await write(key,job);
      stage='present';
      return json(await present(job));
    }catch{return await uncertain('POLL_EXCEPTION');}
    finally{await releasePoll(lease);}
  }
  if(request.method!=='POST'||match[1])throw fail(405,'Tool operation unavailable');
  credential=await toolCredential(env);
  if(env.TOOLS_ENABLED!=='true'||!credential.key)throw fail(503,'Tool service unavailable');
  const bytes=await boundedBytes(request.body,65536);let input;
  try{input=JSON.parse(new TextDecoder().decode(bytes));}catch{throw fail(400,'Invalid tool request');}
  if(!input||Object.keys(input).some(key=>!['kind','images','videos','audios','request_id'].includes(key))||!Object.hasOwn(WORKFLOWS,input.kind)||!/^task_[A-Za-z0-9_-]{1,190}$/.test(input.request_id||''))throw fail(400,'Invalid tool request');
  const images=input.images||[],videos=input.videos||[],audios=input.audios||[];
  if(![images,videos,audios].every(Array.isArray)||(input.kind==='digital'?(images.length!==1||videos.length!==0||audios.length!==1):(videos.length!==1||images.length!==0||audios.length!==0)))throw fail(400,'Tool reference count invalid');
  if(input.kind==='digital'&&(!Number.isFinite(audios[0]?.durationSeconds)||audios[0].durationSeconds<=0||audios[0].durationSeconds>30))throw fail(400,'Tool audio duration invalid');
  const assets=[];let uid;
  for(const [kind,refs] of [['image',images],['video',videos],['audio',audios]])for(const ref of refs){
    if(typeof ref?.url!=='string')throw fail(400,'Tool reference invalid');
    const remote=new URL(ref.url),m=/^\/media\/v1\/assets\/([a-f0-9]{32})$/.exec(remote.pathname);
    if(remote.origin!=='https://www.piknoai.com'||remote.username||remote.password||remote.hash||!m||[...remote.searchParams.keys()].length!==1||!remote.searchParams.has('ticket'))throw fail(403,'Tool reference invalid');
    const claims=await ticket(new Request(ref.url),env,m[1],'read');
    uid??=claims.uid;if(claims.uid!==uid||!claims.mime.startsWith(kind+'/'))throw fail(403,'Tool reference scope invalid');
    const key=`input/${uid}/${claims.id}`,meta=await inspect(env,key,claims);
    if(Number(meta.customMetadata?.expires)<=Date.now()/1000)throw fail(404,'Tool reference expired');
    assets.push({...claims,key,kind});
  }
  const key='tool-jobs/'+input.request_id,hash=await sha(bytes),job={id:input.request_id,uid,kind:input.kind,hash,status:'preparing',credential_version:credential.version,created_at:Math.floor(Date.now()/1000)};
  const claimed=await env.MEDIA.put(key,JSON.stringify(job),{onlyIf:{etagDoesNotMatch:'*'},httpMetadata:{contentType:'application/json'}});
  if(!claimed){const previous=await read(key);if(!previous||previous.hash!==hash)throw fail(409,'Tool request identity conflict');try{return json({...await present(previous),status:previous.status==='preparing'?'unknown':previous.status});}catch{return json({id:previous.id,status:'unknown',outputs:[]});}}
  let dispatched=false;
  try{
    const nodeInfoList=[];
    for(const asset of assets){const file=await upload(asset);nodeInfoList.push({nodeId:input.kind==='depth'?'183':asset.kind==='image'?'133':'125',fieldName:asset.kind,fieldValue:file});}
    // Persist the no-retry barrier BEFORE the potentially paid upstream call.
    job.status='unknown';await write(key,job);dispatched=true;
    const result=await rh('/run/ai-app/'+WORKFLOWS[input.kind],{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({nodeInfoList,instanceType:'default',usePersonalQueue:false})});
    const id=result.taskId||result.data?.taskId||result.task_id||result.data?.task_id;
    if(typeof id==='string'&&/^[A-Za-z0-9_-]{1,200}$/.test(id))job.provider_task_id=id;
    if(['FAILED','FAILURE','CANCEL'].includes(String(result.status||result.data?.status||'').toUpperCase()))job.status='failed';
    else if(job.provider_task_id)job.status='queued';
    await write(key,job);
  }catch(error){job.status=dispatched&&!error.definitiveRejection?'unknown':'failed';await write(key,job);}
  return json(await present(job));
}
