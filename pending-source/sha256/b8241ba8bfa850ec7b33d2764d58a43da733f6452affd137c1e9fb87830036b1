var (
	ErrPiknoLineConflict = errors.New("line changed; refresh before saving")
	ErrPiknoLineNotReady = errors.New("line is not ready to publish")
	ErrPiknoLineNotFound = errors.New("line not found")
)

var piknoPublicModelPattern = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$`)

// PiknoLine keeps operator drafts separate from the active route. PublicModel
// is immutable: renaming a customer API model creates a new line instead of
// silently changing the meaning of historical requests.
type PiknoLine struct {
	PublicModel     string `gorm:"primaryKey;size:120" json:"public_model"`
	Version         int64  `gorm:"not null;default:1" json:"version"`
	DraftConfig     string `gorm:"type:text" json:"-"`
	PublishedConfig string `gorm:"type:text" json:"-"`
	PreviousConfig  string `gorm:"type:text" json:"-"`
	UpdatedAt       int64  `gorm:"index" json:"updated_at"`
	UpdatedBy       int    `json:"updated_by"`
}

type PiknoLinePrice struct {
	Resolution   string   `json:"resolution"`
	Unit         string   `json:"unit"`
	CostCNY      *float64 `json:"cost_cny,omitempty"`
	SuggestedCNY float64  `json:"suggested_cny"`
	RetailQuota  int      `json:"retail_quota"`
}

type PiknoLineConfig struct {
	SyncHash                string           `json:"sync_hash,omitempty"`
	AdapterVersion          string           `json:"adapter_version,omitempty"`
	PublicModel             string           `json:"public_model"`
	SourceID                string           `json:"source_id"`
	DisplayName             string           `json:"name"`
	Kind                    string           `json:"kind"`
	Provider                string           `json:"provider"`
	UpstreamModel           string           `json:"upstream_model"`
	PluginKey               string           `json:"plugin_key,omitempty"`
	ChannelID               int              `json:"channel_id"`
	Enabled                 bool             `json:"enabled"`
	UpstreamAvailable       bool             `json:"upstream_available"`
	Resolutions             []string         `json:"resolutions"`
	Ratios                  []string         `json:"ratios"`
	Qualities               []string         `json:"qualities,omitempty"`
	Durations               []float64        `json:"durations"`
	MaxImages               int              `json:"max_images"`
	MaxVideos               int              `json:"max_videos"`
	MaxAudio                int              `json:"max_audio"`
	Prices                  []PiknoLinePrice `json:"prices"`
	PriceIssue              bool             `json:"price_issue"`
	BillingUnit             string           `json:"billing_unit,omitempty"`
	CostIssueCode           string           `json:"cost_issue_code,omitempty"`
	BillingIssueCode        string           `json:"billing_issue_code,omitempty"`
	ExplicitFree            bool             `json:"explicit_free,omitempty"`
	ReferenceSurchargeQuota int              `json:"reference_surcharge_quota"`
	FetchedAt               string           `json:"fetched_at"`
	Revision                int64            `json:"revision"`
}

