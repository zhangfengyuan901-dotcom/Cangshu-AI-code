import { test } from 'node:test';
import assert from 'node:assert/strict';
import worker from './src/worker.mjs';
const id = 'a'.repeat(32), secret = 'test-only-secret-not-a-production-key';
const png = Uint8Array.from([137,80,78,71,13,10,26,10,0,0,0,0,0,0,0,0]);
async function signed(overrides = {}) {
  const now = Math.floor(Date.now() / 1000);
  const claims = { v: 1, aud: 'pikno-relay-media', uid: 7, id, op: 'upload', iat: now, exp: now + 300, mime: 'image/png', size: png.length, ...overrides };
  const data = Buffer.from(JSON.stringify(claims)).toString('base64url');
  const key = await crypto.subtle.importKey('raw', new TextEncoder().encode(secret), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
  return data + '.' + Buffer.from(await crypto.subtle.sign('HMAC', key, new TextEncoder().encode(data))).toString('base64url');
}
function fixture() {
  const files = new Map(), operations=[];
  const wrap = (row, range) => row && ({ ...row, body: new Blob([row.bytes.slice(range?.offset || 0, range ? range.offset + range.length : undefined)]).stream(), arrayBuffer: async () => row.bytes.slice(range?.offset || 0, range ? range.offset + range.length : undefined).buffer });
  return { operations, TICKET_KEY: secret, UPLOAD_LIMITER: { limit: async () => ({ success: true }) }, MEDIA: {
    async put(key, stream, options) { if (files.has(key)) return null; const bytes = new Uint8Array(await new Response(stream).arrayBuffer());
      const row = { bytes, size: bytes.length, ...options }; files.set(key, row); return wrap(row); },
    async get(key, options) { operations.push(['get',key]); return wrap(files.get(key), options?.range); },
    async head(key) { operations.push(['head',key]); return wrap(files.get(key)); }, async delete(key) { files.delete(key); },
  } };
}
async function request(env, { claims, token, method = 'PUT', suffix = '', body = png, headers = {} } = {}) {
  token ??= await signed(claims);
  const read = ['GET','HEAD'].includes(method);
  return worker.fetch(new Request(`https://www.piknoai.com/media/v1/assets/${id}${suffix}${read ? '?ticket=' + token : ''}`, {
    method, headers: { ...(read ? {} : { Authorization: 'Bearer ' + token }), ...(method === 'PUT' ? { 'Content-Type': 'image/png', 'Content-Length': String(body.length) } : {}), ...headers },
    ...(['PUT','POST'].includes(method) ? { body: method === 'PUT' ? body : '{}' } : {}),
  }), env);
}
test('direct upload, owner inspection and private download; successful object cannot be overwritten', async () => {
  const env = fixture();
  assert.equal((await request(env)).status, 201);
  assert.equal((await request(env)).status, 409);
  const result = await request(env, { method: 'POST', suffix: '/inspect', claims: { op: 'inspect' } });
  assert.equal(result.status, 200); assert.equal((await result.json()).owner_id, 7);
  const download = await request(env, { method: 'GET', claims: { op: 'read' } });
  assert.equal(download.status, 200); assert.deepEqual(new Uint8Array(await download.arrayBuffer()), png);
  assert.equal((await request(env, { method: 'HEAD', claims: { op: 'read', uid: 8 } })).status, 404);
});

test('full asset downloads use one storage read; HEAD and byte ranges retain their validation',async()=>{
  const env=fixture(),key='input/7/'+id;
  assert.equal((await request(env)).status,201);env.operations.length=0;
  const full=await request(env,{method:'GET',claims:{op:'read'}});
  assert.equal(full.status,200);assert.deepEqual(env.operations,[['get',key]]);
  assert.deepEqual(new Uint8Array(await full.arrayBuffer()),png);
  env.operations.length=0;
  const head=await request(env,{method:'HEAD',claims:{op:'read'}});
  assert.equal(head.status,200);assert.equal(head.headers.get('content-length'),'16');
  assert.deepEqual(env.operations,[['head',key]]);
  env.operations.length=0;
  const partial=await request(env,{method:'GET',claims:{op:'read'},headers:{Range:'bytes=-4'}});
  assert.equal(partial.status,206);assert.equal(partial.headers.get('content-range'),'bytes 12-15/16');
  assert.deepEqual(new Uint8Array(await partial.arrayBuffer()),png.slice(-4));
  assert.deepEqual(env.operations,[['head',key],['get',key]]);
});

test('full downloads reject object metadata before delivering bytes and release rejected streams',async()=>{
  for(const [patch,status] of [
    [{size:17},403],[{httpMetadata:{contentType:'video/mp4'}},403],
    [{customMetadata:{uid:'8',expires:String(Date.now()/1000+60)}},403],
    [{customMetadata:{uid:'7',expires:'1'}},404],
  ]){
    const env=fixture();assert.equal((await request(env)).status,201);
    const get=env.MEDIA.get;let cancelled=0;
    env.MEDIA.get=async(...args)=>{
      const object=await get(...args);await object.body.cancel();
      return {...object,...patch,body:new ReadableStream({start(controller){controller.enqueue(png);},cancel(){cancelled++;}})};
    };
    const response=await request(env,{method:'GET',claims:{op:'read'}});
    assert.equal(response.status,status);assert.equal(cancelled,1);
    assert.match(response.headers.get('content-type'),/application\/json/);
  }
});

test('tool result full downloads reuse stream metadata without a separate storage HEAD',async()=>{
  const bridge='test-download-bridge-secret-1234567890',outputKey='input/7/'+id;
  for(const method of ['GET','HEAD']){
    const calls=[],metadata={size:16,httpMetadata:{contentType:'video/mp4'},customMetadata:{uid:'7',expires:String(Date.now()/1000+60)}};
    const env={TOOLS_BRIDGE_SECRET:bridge,TOOLS_ADMIN_SECRET:'test-other-admin-secret-1234567890',MEDIA:{
      async get(key){
        calls.push(['get',key]);
        if(key==='tool-jobs/task_fixture')return {arrayBuffer:async()=>new TextEncoder().encode(JSON.stringify({status:'completed',uid:7,output:{key:outputKey,size:16}})).buffer};
        assert.equal(key,outputKey);return {...metadata,body:new Blob([png]).stream()};
      },
      async head(key){calls.push(['head',key]);assert.equal(key,outputKey);return metadata;},
    }};
    const response=await worker.fetch(new Request('https://www.piknoai.com/media/v1/tools/task_fixture/content',{method,headers:{Authorization:'Bearer '+bridge}}),env);
    assert.equal(response.status,200);assert.equal(response.headers.get('content-length'),'16');
    assert.deepEqual(calls,[['get','tool-jobs/task_fixture'],[method==='GET'?'get':'head',outputKey]]);
    assert.deepEqual(new Uint8Array(await response.arrayBuffer()),method==='GET'?png:new Uint8Array());
  }
});
test('ticket forgery, expiry, operation and object scope are rejected', async () => {
  for (const claims of [{ exp: 1 }, { op: 'read' }, { id: 'b'.repeat(32) }, { uid: 0 }, { aud: 'other' }, { size: 100 << 20 }]) {
    assert.equal((await request(fixture(), { claims })).status, 403);
  }
  assert.equal((await request(fixture(), { token: 'invalid.signature' })).status, 401);
});
test('declared MIME, length and actual file signature must agree', async () => {
  assert.equal((await request(fixture(), { headers: { 'Content-Length': '999' } })).status, 400);
  assert.equal((await request(fixture(), { headers: { 'Content-Type': 'text/html' } })).status, 400);
  const env = fixture();
  assert.equal((await request(env, { body: new Uint8Array(16) })).status, 415);
  assert.equal((await request(env, { method: 'POST', suffix: '/inspect', claims: { op: 'inspect' } })).status, 404);
});
test('fail closed without rate limiter or secret; reject foreign origins', async () => {
  const env = fixture(); delete env.UPLOAD_LIMITER;
  assert.equal((await request(env)).status, 429);
  env.TICKET_KEY = ''; assert.equal((await request(env)).status, 503);
  assert.equal((await request(fixture(), { headers: { Origin: 'https://evil.example' } })).status, 403);
  const ready = fixture(); await request(ready);
  const partial=await request(ready,{method:'GET',claims:{op:'read'},headers:{Range:'bytes=0-1'}});
  assert.equal(partial.status,206);assert.equal(partial.headers.get('content-range'),'bytes 0-1/16');assert.deepEqual(new Uint8Array(await partial.arrayBuffer()),png.slice(0,2));
  for(const value of ['bytes=99-100','bytes=2-1','bytes=0-1,3-4','bytes=-0'])assert.equal((await request(ready,{method:'GET',claims:{op:'read'},headers:{Range:value}})).status,416);
});
