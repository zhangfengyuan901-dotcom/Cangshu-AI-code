FROM pikno-wallet7-test:latest AS source
FROM oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6 AS web
WORKDIR /build/web
COPY --from=source /build/web/package.json /build/web/bun.lock ./
RUN bun install --frozen-lockfile
COPY --from=source /build/web ./
COPY --from=source /build/pkg/billingexpr/testdata /build/pkg/billingexpr/testdata
COPY client10/ ./
RUN DISABLE_ESLINT_PLUGIN=true VITE_REACT_APP_VERSION=v1.0.0-rc.41-pikno.10 bun run build
RUN bun run typecheck
RUN bun run test src/hooks/__tests__/customer-navigation.test.tsx src/features/dashboard/components/overview/__tests__/customer-overview.test.tsx src/features/wallet/__tests__/customer-wallet.test.tsx src/features/wallet/__tests__/fixed-cny.test.tsx src/features/usage-logs/__tests__/access.test.ts src/features/usage-logs/__tests__/task-details.test.ts src/features/auth/__tests__/pikno-auth-layout.test.tsx src/routes/__tests__/-pikno-entry.test.ts
RUN bunx oxlint -c .oxlintrc.json src/hooks/use-sidebar-data.ts src/hooks/use-top-nav-links.ts src/features/dashboard/index.tsx src/features/dashboard/components/overview/customer-overview.tsx src/features/wallet/index.tsx src/features/wallet/hooks/use-affiliate.ts src/features/wallet/components/recharge-form-card.tsx src/routes/_authenticated/developer.tsx

FROM source AS build
WORKDIR /build
COPY --from=web /build/web/dist ./web/dist
COPY brand/pikno_media*.go ./controller/
RUN rm controller/pikno_media_routes.go
COPY brand/pikno_media_routes.go ./router/
COPY brand/pikno_packy_edge.go ./relay/channel/openai/
RUN grep -q 'modelsRouter := router.Group("/v1/models")' router/relay-router.go \
 && ! grep -q 'setPiknoMediaRoutes' router/relay-router.go \
 && sed -i '/modelsRouter := router.Group("\/v1\/models")/i\	setPiknoMediaRoutes(router)' router/relay-router.go \
 && sed -i 's/middleware.TokenAuth(),/middleware.TokenAuth(), controller.PiknoMediaGuard,/g' router/task-plugin-protocol-router.go router/plugin-router.go
RUN sed -i '/func (a \*Adaptor) DoRequest(c \*gin.Context, info \*relaycommon.RelayInfo, requestBody io.Reader) (any, error) {/a\	if info.ChannelBaseUrl == "https://cf.api.fan" \&\& (info.RelayMode == relayconstant.RelayModeImagesEdits || info.RelayMode == relayconstant.RelayModeImagesGenerations) { return piknoPackyEdge(c, info, requestBody) }' relay/channel/openai/adaptor.go
RUN gofmt -w controller/pikno_media*.go router/pikno_media_routes.go router/relay-router.go router/task-plugin-protocol-router.go router/plugin-router.go
RUN go test ./controller -run '^TestPikno(MediaControlPlane|MediaGuard|FixedCNY)$' -count=1 && go test ./router -run '^$' && go test ./relay/channel/openai -run '^TestOpenaiImage' -count=1
RUN go build -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=v1.0.0-rc.41-pikno.10'" -o /client-new-api
FROM pikno-new-api:v1.0.0-rc.41-brand.9
COPY --from=build /client-new-api /new-api
