// Launch immutable candidate EXEs; install isolation before their main module.
const fs=require('node:fs'),path=require('node:path'),os=require('node:os'),net=require('node:net'),assert=require('node:assert/strict');
const {spawn}=require('node:child_process'),{chromium}=require('playwright-core');
const output=path.resolve(process.argv[2]||''),version=process.argv[3];
assert.match(version||'',/^\d+\.\d+\.\d+$/);assert.equal(path.basename(output),'hamster-release-'+version);
const reportDir=path.resolve(__dirname,'../../output/account-login-repair-current/native');fs.mkdirSync(reportDir,{recursive:true});
const modern=Number(version.split('.').at(-1))>=63;
const sleep=ms=>new Promise(resolve=>setTimeout(resolve,ms));
async function port(){const s=net.createServer();await new Promise(resolve=>s.listen(0,'127.0.0.1',resolve));const value=s.address().port;await new Promise(resolve=>s.close(resolve));return value;}
async function run(tag,exe){
  const root=fs.mkdtempSync(path.join(os.tmpdir(),'hamster-startup-exe-')),inspect=await port(),debug=await port();
  fs.mkdirSync(path.join(root,'profile'));fs.mkdirSync(path.join(root,'desktop'));fs.mkdirSync(path.join(root,'session'));
  const child=spawn(exe,[`--inspect-brk=${inspect}`,`--remote-debugging-port=${debug}`,'--remote-debugging-address=127.0.0.1'],{windowsHide:true,env:require('../codex-local.cjs').nativeEnvironment(),stdio:['ignore','pipe','pipe']});
  let stderr='',ws,browser,id=0,paused,wsReady,exited=false;const pending=new Map();child.stderr.on('data',data=>stderr+=data.toString());child.on('exit',()=>exited=true);
  const send=(method,params={})=>new Promise((resolve,reject)=>{const n=++id,timer=setTimeout(()=>{pending.delete(n);reject(Error('Inspector timeout: '+method));},10000);pending.set(n,{resolve:value=>{clearTimeout(timer);resolve(value);},reject:error=>{clearTimeout(timer);reject(error);}});ws.send(JSON.stringify({id:n,method,params}));});
  try{
    let endpoint;for(let i=0;i<240;i++){endpoint=/Debugger listening on (ws:\/\/127\.0\.0\.1:[^\s]+)/.exec(stderr)?.[1];
      // The portable launcher does not forward its child's inspector stderr.
      if(!endpoint)try{const response=await fetch(`http://127.0.0.1:${inspect}/json/list`,{signal:AbortSignal.timeout(200)});if(response.ok)endpoint=(await response.json())[0]?.webSocketDebuggerUrl;}catch{}
      if(endpoint)break;if(exited)throw Error('Candidate exited before inspector');await sleep(250);}
    assert.ok(endpoint,'Inspector endpoint unavailable');ws=new WebSocket(endpoint);wsReady=new Promise((resolve,reject)=>{ws.addEventListener('open',resolve,{once:true});ws.addEventListener('error',reject,{once:true});});
    ws.addEventListener('message',event=>{const data=JSON.parse(String(event.data));if(data.method==='Debugger.paused')paused=data.params;if(data.id){const item=pending.get(data.id);if(item){pending.delete(data.id);data.error?item.reject(Error(data.error.message)):item.resolve(data.result);}}});
    await wsReady;await send('Debugger.enable');await send('Runtime.enable');await send('Runtime.runIfWaitingForDebugger');
    for(let i=0;i<100&&!paused;i++)await sleep(50);assert.ok(paused?.callFrames?.length,'Main did not pause');
    const injection="(function(root){const e=require('electron'),p=require('path');e.app.setPath('userData',p.join(root,'profile'));e.app.setPath('sessionData',p.join(root,'session'));e.app.setPath('desktop',p.join(root,'desktop'));global.__qaElectron=e;const origin='https://www.piknoai.com',now=performance.now(),qa=global.__accountExeQA={events:[],requests:[],blocked:0,nodeBlocked:0,version:e.app.getVersion(),profile:e.app.getPath('userData'),quit:()=>e.app.quit()};const stamp=(event,id,extra={})=>qa.events.push({event,id,ms:Math.round(performance.now()-now),...extra});const guard=session=>{session.webRequest.onBeforeRequest((d,cb)=>{const u=new URL(d.url);const localFile=u.protocol==='file:'&&['electron/account-status.html','electron/account-status.js','electron/account-status.css','public/hamster-mark.png'].some(file=>p.resolve(require('node:url').fileURLToPath(u))===p.resolve(e.app.getAppPath(),file));const local=localFile||u.hostname==='127.0.0.1'||['data:','blob:','devtools:'].includes(u.protocol);const guest=u.origin===origin&&(d.method==='GET'||d.method==='HEAD'||d.method==='POST'&&(u.pathname==='/api/user/auth/refresh'||u.pathname.startsWith('/cdn-cgi/')));const challenge=u.origin==='https://challenges.cloudflare.com';const allow=local||guest||challenge;if(!local)qa.requests.push({origin:u.origin,path:u.pathname.startsWith('/cdn-cgi/')?'/cdn-cgi/[challenge]':u.pathname,method:d.method,allowed:allow,ms:Math.round(performance.now()-now)});if(!allow)qa.blocked++;cb({cancel:!allow});});session.webRequest.onCompleted(d=>{const u=new URL(d.url);if(u.origin===origin)stamp('request-finished',d.webContentsId,{path:u.pathname.startsWith('/cdn-cgi/')?'/cdn-cgi/[challenge]':u.pathname,status:d.statusCode});});};e.app.on('session-created',guard);e.app.whenReady().then(()=>guard(e.session.defaultSession));const realFetch=global.fetch;global.fetch=(url,...rest)=>{const u=new URL(typeof url==='string'||url instanceof URL?url:url.url);if(u.hostname!=='127.0.0.1'){qa.nodeBlocked++;return Promise.reject(Error('QA node network blocked'));}return realFetch(url,...rest);};e.app.on('browser-window-created',(_event,w)=>{stamp('created',w.id);w.on('show',()=>stamp('show',w.id));w.on('closed',()=>stamp('closed',w.id));w.webContents.on('did-start-loading',()=>stamp('loading',w.id));w.webContents.on('did-finish-load',()=>stamp('loaded',w.id));w.webContents.on('did-fail-load',(_e,code,_description,_url,main)=>stamp('load-failed',w.id,{code,main}));});return {version:e.app.getVersion(),packaged:e.app.isPackaged};})("+JSON.stringify(root)+')';
    const result=await send('Debugger.evaluateOnCallFrame',{callFrameId:paused.callFrames[0].callFrameId,expression:injection,returnByValue:true});
    assert.equal(result.exceptionDetails,undefined);assert.equal(result.result.value.version,version);assert.equal(result.result.value.packaged,true);
    await send('Debugger.resume');
    let endpointHTTP;for(let i=0;i<120;i++){try{const response=await fetch(`http://127.0.0.1:${debug}/json/version`,{signal:AbortSignal.timeout(500)});if(response.ok){endpointHTTP=(await response.json()).webSocketDebuggerUrl;break;}}catch{}await sleep(250);}
    assert.ok(endpointHTTP);browser=await chromium.connectOverCDP(endpointHTTP);
    if(process.argv.includes('--fail-once')||process.argv.includes('--corrupt-settings')){let splash;for(let i=0;i<80;i++){splash=browser.contexts()[0]?.pages().find(p=>p.url().startsWith('file:'));if(splash)break;await sleep(100);}assert.ok(splash);await splash.locator('#retry').waitFor({state:'visible'});await splash.screenshot({path:path.join(reportDir,version+'-'+tag+'-failure.png')});if(process.argv.includes('--corrupt-settings')){assert.match(await splash.locator('#status').innerText(),/未能读取本机设置/);const recovered=await send('Runtime.evaluate',{expression:'global.__qaRecoverSettings()',returnByValue:true});assert.equal(recovered.result.value,true);}await splash.locator('#retry').click();}
    let page;for(let i=0;i<80;i++){page=browser.contexts()[0]?.pages().find(p=>p.url().startsWith('http://127.0.0.1:'));if(page)break;await sleep(100);}assert.ok(page);await page.locator('#localAccountIdentity').waitFor();
    await page.locator('#registerLocalAccount').waitFor({state:'visible'});
    const initial=await page.locator('#localAccountNotice').innerText();await page.locator('#registerLocalAccount').click();
    const checkpoints=[];for(const delay of [1000,4000,11000]){await sleep(delay);checkpoints.push({notice:await page.locator('#localAccountNotice').innerText(),pages:browser.contexts()[0].pages().map(p=>new URL(p.url()).origin+new URL(p.url()).pathname)});}
    const facts=await send('Runtime.evaluate',{expression:'global.__accountExeQA',returnByValue:true});
    const resultPages=[];for(const p of browser.contexts()[0].pages()){resultPages.push({url:new URL(p.url()).origin+new URL(p.url()).pathname,title:await p.title().catch(()=>''),bodySample:await p.locator('body').innerText({timeout:2000}).then(t=>t.slice(0,500)).catch(()=>'' )});}
    const requests=facts.result.value.requests;
    const registrationPosts=requests.filter(r=>r.method==='POST'&&r.path==='/api/user/register').length;
    const loginPosts=requests.filter(r=>r.method==='POST'&&r.path==='/api/user/login').length;
    assert.equal(registrationPosts,0);assert.equal(loginPosts,0);
    if(version==='1.7.64'){
      assert.doesNotMatch(checkpoints[0].notice,/正在处理/);
      assert.ok(checkpoints[0].pages.length>=2,'A visible account window must already exist');
      assert.ok(resultPages.some(p=>p.url==='https://www.piknoai.com/auth-lite/index.html'&&p.bodySample.includes('注册')),'Remote registration form must load');
      const account=browser.contexts()[0].pages().find(p=>p.url().startsWith('https://www.piknoai.com/auth-lite/index.html'));
      await account.screenshot({path:path.join(reportDir,version+'-'+tag+'-register.png')});
    }
    fs.writeFileSync(path.join(reportDir,version+'-'+tag+'-auth.json'),JSON.stringify({initial,checkpoints,facts:facts.result.value,pages:resultPages,isolatedProfile:root,registrationPosts,loginPosts},null,2));
    await page.screenshot({path:path.join(reportDir,version+'-'+tag+'-account.png')});
    await send('Runtime.evaluate',{expression:'global.__accountExeQA.quit()'}).catch(()=>{});
  }finally{
    ws?.close();await browser?.close().catch(()=>{});
    for(let i=0;i<30&&!exited;i++)await sleep(100);
    if(!exited)child.kill();
  }
}
(async()=>{const samples=process.argv.includes('--repeat')?3:1;for(let sample=0;sample<samples;sample++){await run('unpacked-'+sample,path.join(output,'win-unpacked','仓鼠AI.exe'));if(process.argv.includes('--portable'))await run('portable-'+sample,path.join(output,version==='1.7.62'?'仓鼠AI.exe':`仓鼠AI-${version}-便携版.exe`));}console.log(JSON.stringify({passed:true,version,actualExeStarts:samples*(process.argv.includes('--portable')?2:1)}));})().catch(error=>{console.error(error);process.exitCode=1;});
