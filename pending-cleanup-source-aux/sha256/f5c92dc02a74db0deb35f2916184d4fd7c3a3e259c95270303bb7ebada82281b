"""Run the maintained formal release suite against promoted workspace source."""
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess

here = Path(__file__).resolve().parent
root = here.parents[1]
app = root / '仓鼠AI'
specification = json.loads((app / 'release/current.json').read_text(encoding='utf-8'))
assert specification['version'] == '1.7.77'
environment = dict(os.environ, HAMSTER_TEST_APP_ROOT=str(app))
result = subprocess.run(['npm.cmd', '--prefix', str(app), 'run', 'test:release'],
                        cwd=root, env=environment, capture_output=True, timeout=300)
log = result.stdout + result.stderr
(here / 'formal-release-tests.log').write_bytes(log)
text = log.decode('utf-8', errors='replace')
counts = {}
for key in ('tests', 'pass', 'fail', 'cancelled', 'skipped'):
    matches = re.findall(r'^(?:#|ℹ) ' + key + r' (\d+)\s*$', text, re.MULTILINE)
    counts[key] = int(matches[-1]) if matches else None
record = {
    'version': '1.7.77', 'scope': 'accepted-current-release-contracts',
    'exit_code': result.returncode, **counts,
    'passed': result.returncode == 0 and counts['fail'] == counts['cancelled'] == 0,
    'source_manifest_sha256': hashlib.sha256((app / 'release/source-manifest.json').read_bytes()).hexdigest(),
    'customer_data_access': False, 'real_payments': 0, 'real_generation_calls': 0,
}
(here / 'formal-release-tests.json').write_text(json.dumps(record, indent=2) + '\n', encoding='utf-8')
print(json.dumps(record))
if not record['passed']:
    raise SystemExit(1)
