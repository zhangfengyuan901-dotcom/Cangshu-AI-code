'use strict';
const fs=require('node:fs'),path=require('node:path'),assert=require('node:assert/strict');
const root=__dirname,baseline=path.resolve(root,'../custom-installer-1.7.85-current');assert(JSON.parse(fs.readFileSync(path.join(baseline,'verification.json'),'utf8')).passed);
