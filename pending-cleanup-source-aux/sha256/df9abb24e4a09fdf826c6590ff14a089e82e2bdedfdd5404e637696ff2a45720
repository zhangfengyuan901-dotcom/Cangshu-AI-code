 const target=path.join(root,name);assert(!fs.existsSync(target));fs.cpSync(path.join(baseline,name),target,{recursive:true,filter:source=>{if(fs.lstatSync(source).isSymbolicLink())return false;return name==='source'||!path.relative(path.join(baseline,name),source).split(path.sep).includes('node_modules');}});
}
const replace=value=>typeof value==='string'?value.replaceAll(baseline,root):Array.isArray(value)?value.map(replace):value&&typeof value==='object'?Object.fromEntries(Object.entries(value).map(([k,v])=>[k,replace(v)])):value;
