const {test}=require('node:test');
const assert=require('node:assert/strict');
const fs=require('node:fs'),path=require('node:path'),os=require('node:os'),crypto=require('node:crypto'),cp=require('node:child_process');
const hash=value=>crypto.createHash('sha256').update(value).digest('hex');
function fixture(t){
 const root=fs.mkdtempSync(path.join(os.tmpdir(),'hamster-official-source-')),app=path.join(root,'app');
 const write=(name,bytes)=>{const file=path.join(root,name);fs.mkdirSync(path.dirname(file),{recursive:true});fs.writeFileSync(file,bytes);return file;};
 const runtime={name:'hamster-ai',version:'1.7.73',main:'electron/main.cjs',dependencies:{fixture:'1.0.0'}},runtimeBytes=Buffer.from(JSON.stringify(runtime,null,2)+'\n');
 const source=Buffer.from('module.exports="official-source";\n'),installer=Buffer.from('; fixture installer\n'),dependency=Buffer.from('module.exports="fixture";\n'),generated=Buffer.from('{"name":"fixture","version":"1.0.0"}\n'),metadata=Buffer.from('{"name":"fixture","version":"1.0.0","devDependencies":{"test":"1"}}\n'),python=Buffer.from('print("official")\n'),binary=Buffer.from('bounded-runtime-fixture');
 const record=bytes=>({bytes:bytes.length,sha256:hash(bytes)});
 write('app/package.json',JSON.stringify({...runtime,scripts:{test:'node --test'},devDependencies:{fixture:'1'}}));
 write('app/main.cjs',source);write('app/electron/installer.nsh',installer);write('app/node_modules/fixture/index.js',dependency);write('app/node_modules/fixture/package.json',metadata);write('app/workflow/main.py',python);write('app/build/icon.ico','icon');
 const archive=Buffer.from('accepted-archive-digest-fixture'),portable=Buffer.from('accepted-portable-digest-fixture');
 write('output/current/win-unpacked/resources/app.asar',archive);write('output/current/client.exe',portable);
 write('output/current/win-unpacked/resources/workflow/main.py',python);write('output/current/win-unpacked/resources/runtime.bin',binary);
 const manifest={format:1,version:runtime.version,baselineASARSHA256:hash(archive),runtimePackage:runtime,runtimePackageSHA256:hash(runtimeBytes),files:{'main.cjs':record(source),'electron/installer.nsh':record(installer)},dependencies:{'node_modules/fixture/index.js':record(dependency),'node_modules/fixture/package.json':{...record(generated),sourceSHA256:hash(metadata),generatedContentBase64:generated.toString('base64')}},resourceSources:{'workflow/main.py':'workflow/main.py'}};
 const spec={format:1,version:runtime.version,sourceIsOfficial:true,sourceManifest:'release/source-manifest.json',releaseDirectory:'output/current',asarSHA256:hash(archive),portable:{path:'output/current/client.exe',sha256:hash(portable)},resources:{'workflow/main.py':record(python),'runtime.bin':record(binary)},builder:{appId:'com.hamster.ai',directories:{app:'@stage',output:'@artifacts',buildResources:'@app/build'},nsis:{deleteAppDataOnUninstall:false,include:'@stage/electron/installer.nsh'},win:{icon:'@app/build/icon.ico'},electronDist:'@app/node_modules/electron/dist',electronVersion:'33.4.11'}};
 write('app/release/source-manifest.json',JSON.stringify(manifest));write('app/release/current.json',JSON.stringify(spec));
 const script=write('app/scripts/stage-current-release.cjs',fs.readFileSync(path.join(__dirname,'../scripts/stage-current-release.cjs')));
 t.after(()=>{assert(path.resolve(root).startsWith(path.resolve(os.tmpdir())+path.sep));fs.rmSync(root,{recursive:true,force:true});});
 const run=(...args)=>cp.spawnSync(process.execPath,[script,...args],{cwd:app,encoding:'utf8'});
 return {root,app,run,write,runtimeBytes,generated,source,python};
}
test('official release stages workspace source, generated runtime metadata and pinned resource inputs',t=>{
 const f=fixture(t),check=f.run('--check');assert.equal(check.status,0,check.stderr);assert.equal(JSON.parse(check.stdout).source,'official-workspace-source');
 const build=f.run('--out','fixture-stage');assert.equal(build.status,0,build.stderr);
 const dir=path.join(f.root,'output/fixture-stage');
 assert.deepEqual(fs.readFileSync(path.join(dir,'source/main.cjs')),f.source);
 assert.deepEqual(fs.readFileSync(path.join(dir,'source/package.json')),f.runtimeBytes);
 assert.deepEqual(fs.readFileSync(path.join(dir,'source/node_modules/fixture/package.json')),f.generated);
 assert.deepEqual(fs.readFileSync(path.join(dir,'resource-inputs/workflow/main.py')),f.python);
 assert.equal(fs.existsSync(path.join(dir,'source/tests')),false);
 assert.equal(f.run('--out','fixture-stage').status,1,'must preserve an existing stage');
});
test('changed workspace source or dependency metadata cannot silently rebuild the accepted archive',t=>{
 const f=fixture(t);f.write('app/main.cjs','module.exports="unreviewed";');
 assert.equal(f.run('--check').status,1);assert.equal(f.run('--out','invalid-stage').status,1);assert.equal(fs.existsSync(path.join(f.root,'output/invalid-stage')),false);
 f.write('app/main.cjs',f.source);f.write('app/node_modules/fixture/package.json','{"version":"changed"}');assert.equal(f.run('--check').status,1);
});
test('output traversal, altered source resources and runtime package drift stop before creating a stage',t=>{
 const f=fixture(t);assert.equal(f.run('--out','../../outside').status,1);assert.equal(fs.existsSync(path.join(f.root,'outside')),false);
 f.write('app/workflow/main.py','print("unreviewed")');assert.equal(f.run('--out','bad-resource').status,1);assert.equal(fs.existsSync(path.join(f.root,'output/bad-resource')),false);
 f.write('app/workflow/main.py',f.python);const pkg=JSON.parse(fs.readFileSync(path.join(f.app,'package.json')));pkg.dependencies.fixture='2.0.0';f.write('app/package.json',JSON.stringify(pkg));assert.equal(f.run('--check').status,1);
});
