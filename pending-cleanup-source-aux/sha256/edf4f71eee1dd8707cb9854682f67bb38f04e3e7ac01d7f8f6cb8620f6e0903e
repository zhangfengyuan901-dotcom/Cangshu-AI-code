test('当前公开教程只允许指定入口，不包含供应商身份、凭证或内部地址', () => {
  const mediaPolicy = ['视频生成的参考素材上传到 R2。','图片和工具结果从上游下载到本机，任务状态由后台保存。'];
  for (const disclosure of mediaPolicy) assert.ok(page.includes(disclosure));
  const otherCopy = mediaPolicy.reduce((copy, disclosure) => copy.replace(disclosure, ''), page);
  const forbidden = /三宝|RunningHub|Cloudflare|BytePlus|Image 2|\bRH\b|\bARK\b|\bR2\b|上游|密钥|接口|接入点|token\s*[:=]|Bearer\s+\S+|127\.0\.0\.1|localhost|\/api\/|sk-[A-Za-z0-9_-]{8,}|ep-[A-Za-z0-9_-]{8,}/i;
  assert.doesNotMatch(otherCopy, forbidden);
  const urls = [...page.matchAll(/https?:\/\/[^"\s<>]+/g)].map(match => match[0]);
  assert.ok(urls.every(url => url.startsWith('https://hamsterai.cc/') || url === 'https://www.piknoai.com' || url === CLIENT_DOWNLOAD_URL));
});

test('当前引用的画布演示截图存在并标明离线模拟', () => {
  const chapters = new Map([...page.matchAll(/<section class="tutorial-chapter reveal" id="([a-z]+)"[\s\S]*?<\/section>/g)].map(match => [match[1], match[0]]));
  for (const [chapter, name] of [['canvas', 'canvas']]) {
    const asset = `/assets/tutorial-1749-${name}.png`;
    assert.ok(chapters.get(chapter)?.includes(asset));
    assert.ok(existsSync(new URL('../website/public' + asset, import.meta.url)));
    assert.match(chapters.get(chapter), /离线模拟截图/);
  }
});


