import assert from 'node:assert/strict';
import { existsSync, readFileSync } from 'node:fs';
import test from 'node:test';
import { CLIENT_DOWNLOAD_URL } from '../website/src/download-handler.js';

const read = path => readFileSync(new URL('../website/public/' + path, import.meta.url), 'utf8');
const page = read('tutorials/index.html');
const home = read('index.html');
assert.ok(home.includes('href="' + CLIENT_DOWNLOAD_URL + '"'), 'Homepage must link the approved netdisk share');
const publishedVersion = home.match(/DOWNLOAD · V(\d+\.\d+\.\d+)/)?.[1];
assert.ok(publishedVersion, 'Homepage must identify the published release');

test('默认教程对应当前网盘发布版本，展示网页连接、充值、批次和手动画布', () => {
  const sections = [...page.matchAll(/<section class="tutorial-chapter reveal" id="([a-z]+)"/g)].map(match => match[1]);
  assert.deepEqual(sections, ['account', 'quote', 'batch', 'canvas', 'reverse']);
  assert.match(page, /<aside class="tutorial-sidebar" aria-label="教程目录">/);
  for (const id of sections) assert.match(page, new RegExp(`<a href="#${id}">`));
  assert.ok(page.includes('适用于仓鼠AI正式版 '+publishedVersion));
  assert.match(page, /进入仓鼠AI「账户」，点击「去中转站充值」/);
  assert.match(page, /系统浏览器会打开中转站/);
  assert.match(page, /新用户注册并完成安全验证后自动登录/);
  assert.match(page, /系统按账户与用途补齐应用 Key，并在本机加密保存/);
  assert.match(page, /已有同账户的有效配置继续使用/);
  assert.match(page, /网页账号与应用账号不一致/);
  assert.match(page, /点击「充值」进入收银台/);
  assert.match(page, /账户页自动读取中转站余额和本机连接状态/);
  assert.doesNotMatch(page, /tutorial-1749-account\.png/);
  assert.match(page, /图片、视频、工具与对话用途共用同一账户余额/);
  assert.match(page, /数字人与黑白深度使用工具用途/);
  assert.match(page, /手动更换和移除仍可在高级连接设置中操作/);
  assert.match(page, /检测不创建生成任务、不扣费/);
  assert.match(page, /连接检测通过表示认证及当前可用线路已确认/);
});

