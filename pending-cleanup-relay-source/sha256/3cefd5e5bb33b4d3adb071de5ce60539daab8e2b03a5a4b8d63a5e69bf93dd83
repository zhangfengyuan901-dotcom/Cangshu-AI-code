async (page) => {
  const base = 'http://127.0.0.1:48276';
  const shots = 'D:/PIKNO/output/playwright/relay-portal-current/';
  const passed = [];
  let pageErrors = 0;
  page.on('pageerror', () => pageErrors++);
  const check = (value, label) => { if (!value) throw new Error('UI validation failed: ' + label); passed.push(label); };
  const ready = async () => { await page.locator('.portal-header').waitFor(); };
  const noOverflow = async label => check(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth + 1), label);
  await page.request.put(base+'/__qa/catalog', {data:{reset:true}});
  await page.setViewportSize({width:1440,height:1000});
  await page.goto(base + '/');await ready();
  check(await page.locator('h1').count() === 1, 'homepage_heading');
  check(await page.getByRole('button', {name:/立即生成|开始生成|Generate now|Run request/}).count() === 0, 'no_online_generation_action');
  await page.screenshot({path:shots+'portal-home-desktop.png',fullPage:true});
  await page.goto(base+'/hub/models');await ready();
  await page.locator('.portal-model-card').first().waitFor();
  check(await page.locator('.portal-model-card').count() === 12, 'catalog_pagination');
  const search = page.getByRole('textbox', {name:/搜索模型|Search models/});
  await search.fill('03');
  await page.locator('.portal-model-card').first().waitFor();
  check(await page.locator('.portal-model-card').count() === 1, 'catalog_search');
  await page.locator('.portal-model-card button').click();
  const details = page.getByRole('dialog');await details.waitFor();
  check((await details.innerText()).includes('合成验证图片线路 03'), 'published_model_details');
  check((await details.innerText()).includes('12'), 'published_total_reference_limit');
  await page.screenshot({path:shots+'portal-model-details-desktop.png'});
  await page.request.put(base+'/__qa/catalog', {data:{remove:'pikno-qa-image-03'}});
  await details.waitFor({state:'hidden'});
  check(await page.locator('.portal-model-card').count() === 0, 'removed_selected_model_clears_detail');
  await search.fill('');
  await page.locator('.portal-model-card').first().waitFor();
  await page.screenshot({path:shots+'portal-models-desktop.png',fullPage:true});
  await page.goto(base+'/hub/pricing');await ready();
  await page.getByText(/0\.123456/).first().waitFor();
  check(await page.getByText(/0\.123456/).count()>0, 'published_price_precision');
  await noOverflow('desktop_pricing_layout');
  await page.screenshot({path:shots+'portal-pricing-desktop.png',fullPage:true});
  await page.goto(base+'/hub/docs');await ready();
  await page.getByRole('button', {name:'Python',exact:true}).click();
  check((await page.locator('.portal-code code').first().innerText()).includes('requests.get'), 'python_readonly_example');
  await page.getByRole('button', {name:'Node.js',exact:true}).click();
  check((await page.locator('.portal-code code').first().innerText()).includes('process.env.PIKNO_API_KEY'), 'node_readonly_example');
  check(await page.locator('input[type=password]').count()===0, 'no_api_key_input_in_public_docs');
  await page.screenshot({path:shots+'portal-docs-desktop.png',fullPage:true});
  await page.goto(base+'/hub/dashboard');await ready();
  let account = page.frameLocator('.portal-account-frame');
  await account.locator('#balance-value').waitFor();
  check(await account.locator('#balance-value').innerText()==='¥123.45','account_balance_from_synthetic_server');
  check(await account.locator('.topbar').isHidden(), 'same_origin_account_embedding');
  check(await page.locator('.portal-account-frame').getAttribute('src') === '/account-lite/index.html?tab=balance&embed=1', 'fixed_account_frame_source');
  await page.screenshot({path:shots+'portal-console-desktop.png',fullPage:true});
  check(await account.locator('#login-panel a[target=_top]').count()===3, 'guest_authentication_leaves_account_frame');
  await account.locator('.developer-shortcuts a').first().click();
  await page.waitForURL(base+'/hub/models');await ready();
  check(await page.locator('.portal-account-frame').count()===0, 'model_shortcut_leaves_account_frame');
  await page.goto(base+'/hub/dashboard');await ready();
  account = page.frameLocator('.portal-account-frame');
  await account.locator('#balance-value').waitFor();
  await account.locator('[data-go=topup]').click();
  await page.waitForURL(base+'/hub/billing');await ready();
  check(await page.locator('.portal-account-frame').getAttribute('src')==='/account-lite/index.html?tab=topup&embed=1','embedded_recharge_updates_outer_console_tab');
  await page.goto(base+'/hub/keys');await ready();
  account = page.frameLocator('.portal-account-frame');
  await account.locator('#new-key').waitFor();
  await account.locator('#new-key').click();
  await account.locator('#key-dialog').waitFor();
  check(await account.locator('#key-dialog select[name=group] option').count() >= 3, 'purpose_specific_key_dialog');
  await account.locator('#close-key').click();
  await account.locator('#key-dialog').waitFor({state:'hidden'});
  await page.goto(base+'/hub/usage');await ready();
  account = page.frameLocator('.portal-account-frame');
  await account.locator('#usage-list').getByText('暂无消费记录',{exact:true}).waitFor();
  check(true, 'usage_records_account_ui');
  await account.locator('#usage-kind').selectOption('settlements');
  await account.locator('#usage-list').getByText('暂无任务结算记录',{exact:true}).waitFor();
  check(true, 'settlement_history_account_ui');
  await page.goto(base+'/hub/billing');await ready();
  account = page.frameLocator('.portal-account-frame');
  await account.locator('#amounts button').first().waitFor();
  check(await account.locator('#amounts button').count()===3, 'fixed_topup_amounts_preserved');
  check(await account.locator('#pay').isEnabled(), 'topup_quote_ui_without_payment');
  await page.goto(base+'/account-lite/index.html?tab=balance');
  await page.locator('#balance-value').waitFor();
  await page.locator('[data-go=topup]').click();
  await page.locator('#topup').waitFor({state:'visible'});
  check(new URL(page.url()).pathname==='/account-lite/index.html','standalone_native_account_tab_stays_in_existing_page');
  await page.setViewportSize({width:390,height:844});
  for(const [route,name] of [['/','home'],['/hub/models','models'],['/hub/pricing','pricing'],['/hub/dashboard','console']]){
    await page.goto(base+route);await ready();
    if(name==='models')await page.locator('.portal-model-card').first().waitFor();
    if(name==='pricing')await page.getByText(/0\.123456/).first().waitFor();
    if(name==='console')await page.frameLocator('.portal-account-frame').locator('#balance-value').waitFor();
    await noOverflow('mobile_'+name+'_layout');
    await page.screenshot({path:shots+'portal-'+name+'-mobile.png',fullPage:true});
  }
  await page.goto(base+'/');await ready();
  check(Boolean(await page.locator('.portal-mobile-menu').getAttribute('aria-label')),'mobile_menu_accessible_name');
  await page.locator('.portal-mobile-menu').click();
  check(await page.getByRole('navigation',{name:/主导航|Main navigation/}).isVisible(), 'mobile_navigation');
  await page.request.put(base+'/__qa/catalog',{data:{fail:true}});
  await page.goto(base+'/hub/models');await ready();
  await page.getByText(/模型目录加载失败|Unable to load model catalog/).first().waitFor();
  check(await page.locator('.portal-model-card').count()===0, 'failed_catalog_no_fabricated_models');
  await page.request.put(base+'/__qa/catalog',{data:{reset:true}});
  const state = await (await page.request.get(base+'/__qa/state')).json();
  check(state.generationCalls===0,'no_generation_or_payment_requests');
  check(pageErrors===0,'no_browser_page_errors');
  await page.goto(base+'/');await ready();
  return {ok:true,synthetic:true,checks:passed.length,passed,pageErrors,real_generation_calls:0,real_payment_calls:0};
}
