        with self.assertRaisesRegex(C.CleanupError, 'UNRESOLVED_OR_SHARED'):
            self.plan()

    def test_shared_model_preserves_other_snapshot_and_ambiguous_buckets(self):
        self.psql("UPDATE pikno_lines SET draft_config=' {\"provider\":\"canseedream\",\"retain\":true} ' WHERE public_model='sb-model';")
        plan = self.plan()
        self.assertEqual(plan['notes']['shared_model_identities_preserved'], 1)
        self.assertEqual(plan['tables']['pikno_lines']['update_keys'], [['sb-model']])
        self.assertEqual(plan['tables']['quota_data']['delete_keys'], [])
        self.execute(plan)
        value = self.query("SELECT jsonb_build_object('draft',draft_config,'published',published_config,'previous',previous_config) FROM pikno_lines WHERE public_model='sb-model'")
        self.assertEqual(value, {'draft': ' {"provider":"canseedream","retain":true} ', 'published': '', 'previous': ''})

