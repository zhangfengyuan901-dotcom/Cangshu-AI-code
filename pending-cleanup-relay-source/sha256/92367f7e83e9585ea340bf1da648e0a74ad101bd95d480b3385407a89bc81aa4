class CleanupTests(unittest.TestCase):
    container = None

    @classmethod
    def setUpClass(cls):
        name = 'relay-sanbao68-cleanup-synthetic'
        if subprocess.run(['docker', 'container', 'inspect', name], capture_output=True).returncode == 0:
            raise RuntimeError('PREVIOUS_SYNTHETIC_CONTAINER_REQUIRES_REVIEW')
        value = subprocess.run(['docker', 'run', '-d', '--name', name, '--network', 'none',
            '--label', 'codex.task=sanbao68-cleanup-tests', '--memory', '384m', '--cpus', '1',
            '--tmpfs', '/var/lib/postgresql/data:rw,nosuid,size=256m',
            '-e', 'POSTGRES_USER=fixture', '-e', 'POSTGRES_DB=fixture',
            '-e', 'POSTGRES_HOST_AUTH_METHOD=trust', 'postgres:16-alpine'], capture_output=True, timeout=30)
        if value.returncode:
            raise RuntimeError('SYNTHETIC_DATABASE_START_FAILED')
        cls.container = value.stdout.decode().strip()
        for _ in range(60):
            ready = subprocess.run(['docker', 'exec', cls.container, 'pg_isready', '-U', 'fixture', '-d', 'fixture'], capture_output=True)
            if ready.returncode == 0:
                return
            time.sleep(0.25)
        raise RuntimeError('SYNTHETIC_DATABASE_START_TIMEOUT')

    @classmethod
    def tearDownClass(cls):
        if not cls.container:
            return
        value = json.loads(subprocess.run(['docker', 'inspect', cls.container], capture_output=True, check=True).stdout)[0]
        if value['Id'] != cls.container or value['Config']['Labels'].get('codex.task') != 'sanbao68-cleanup-tests' or value['HostConfig']['NetworkMode'] != 'none':
            raise RuntimeError('SYNTHETIC_CLEANUP_IDENTITY_INVALID')
        metadata = {'container_id': cls.container, 'task_label': 'sanbao68-cleanup-tests', 'network': 'none', 'tmpfs_only_database': True, 'remove_volumes': False}
        (HERE / 'cleanup68-test-container-cleanup.json').write_text(json.dumps(metadata, indent=2)+'\n', encoding='utf-8')
        subprocess.run(['docker', 'rm', '-f', cls.container], capture_output=True, check=True)
        metadata['removed'] = True
        (HERE / 'cleanup68-test-container-cleanup.json').write_text(json.dumps(metadata, indent=2)+'\n', encoding='utf-8')

    def psql(self, script):
        r = subprocess.run(['docker', 'exec', '-i', self.container, 'psql', '-X', '-qAt', '-U', 'fixture', '-d', 'fixture', '-v', 'ON_ERROR_STOP=1', '-f', '-'], input=script.encode(), capture_output=True, timeout=60)
        if r.returncode:
            # Synthetic diagnostics stay local, never contain production data.
            (HERE / 'cleanup68-synthetic-last-psql-error.log').write_bytes(r.stderr)
            raise RuntimeError('SYNTHETIC_PSQL_FAILED')
        values = [s for s in r.stdout.decode().splitlines() if s.startswith(('{', '['))]
        return json.loads(values[-1]) if values else None

    def query(self, query):
        return self.psql('BEGIN READ ONLY; ' + query + '; ROLLBACK;')

    def setUp(self):
        self.psql('DROP SCHEMA public CASCADE; CREATE SCHEMA public; ' + DDL)

    def plan(self):
        return C.preflight_inventory(self.query)

    def execute(self, plan):
        return C.apply(self.psql, plan, services_stopped=True, approved_plan_sha256=plan['plan_sha256'])

    def test_exact_owned_links_children_first_and_all_other_tables_preserved(self):
        plan = self.plan()
        result = self.execute(plan)
        self.assertTrue(result['protected_fingerprints_preserved'])
        self.assertEqual(result['delete_counts']['tasks'], 3)
        self.assertEqual(result['delete_counts']['logs'], 3)
        self.assertEqual(result['delete_counts']['audit_logs'], 2)
        self.assertEqual(result['delete_counts']['pikno_settlement_outboxes'], 2)
        self.assertFalse(result['opening_balance_snapshot_saved'])
        after = self.plan()
        self.assertTrue(all(not v['delete_keys'] and not v['update_keys'] for v in after['tables'].values()))

    def test_private_plan_contains_keys_and_hashes_not_rows_or_opening_amounts(self):
        plan = self.plan()
        encoded = json.dumps(plan)
        self.assertNotIn('synthetic-credential', encoded)
        self.assertNotIn('fixture@example.invalid', encoded)
        self.assertNotIn('used_quota', encoded)
        self.assertNotIn('opening', encoded)
        self.assertNotIn('request-chain', encoded)
        self.assertIn('additional_keep', plan['tables'])

    def test_unknown_or_reserved_orders_block_before_delete(self):
        for change in ("reserved_quota=1", "generation_state='unknown'", "settled_outcome=''", "financial_state='pending_review'"):
            self.setUp()
            self.psql("UPDATE pikno_settlements SET " + change + " WHERE line_provider='sanbao';")
            with self.assertRaisesRegex(C.CleanupError, 'UNRESOLVED_OR_SHARED'):
                self.plan()

