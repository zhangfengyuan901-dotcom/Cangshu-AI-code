        self.psql("UPDATE channels SET setting='{\"task_extend_plugin_keys\":[\"pikno-sanbao\",\"keep-plugin\"]}';")
        with self.assertRaisesRegex(C.CleanupError, 'UNRESOLVED_OR_SHARED'):
            self.plan()

    def test_drift_after_private_plan_rolls_back(self):
        plan = self.plan()
        self.psql("UPDATE logs SET quota=quota+1 WHERE id=1;")
        with self.assertRaisesRegex(C.CleanupError, 'TRANSACTION_FAILED'):
            self.execute(plan)
        value = self.query('SELECT jsonb_build_object(\'count\',count(*)) FROM pikno_settlements')
        self.assertEqual(value['count'], 2)

    def test_post_delete_financial_trigger_mutation_rolls_back_everything(self):
        self.psql("CREATE FUNCTION public.fixture_mutate_wallet() RETURNS trigger LANGUAGE plpgsql AS $$BEGIN UPDATE users SET quota=quota+1 WHERE id=101; RETURN OLD; END$$; CREATE TRIGGER fixture_bad_trigger AFTER DELETE ON tasks FOR EACH ROW EXECUTE PROCEDURE public.fixture_mutate_wallet();")
        plan = self.plan()
        with self.assertRaisesRegex(C.CleanupError, 'TRANSACTION_FAILED'):
            self.execute(plan)
        self.assertEqual(self.plan(), plan)

    def test_approval_and_stop_attestation_required(self):
        plan = self.plan()
        for kwargs in ({'services_stopped':False,'approved_plan_sha256':plan['plan_sha256']}, {'services_stopped':True,'approved_plan_sha256':'0'*64}):
            with self.assertRaisesRegex(C.CleanupError, 'APPROVAL_OR_PLAN'):
                C.apply(lambda _:self.fail('must not execute'), plan, **kwargs)

    def test_protected_keys_are_rejected_even_if_manifest_digest_recomputed(self):
        plan = self.plan()
        plan['tables']['users']['delete_keys'] = [[101]]
        plan.pop('plan_sha256')
        plan['plan_sha256'] = C._digest(plan)
        with self.assertRaisesRegex(C.CleanupError, 'PROTECTED_TABLE'):
            self.execute(plan)

    def test_primary_key_quotes_and_dollar_delimiters_remain_data(self):
        unusual = "fixture'$cleanup68_0$\\path"
        self.psql("INSERT INTO pikno_settlements VALUES(" + C._literal(unusual) + ",101,1,'','sb-model','sanbao',0,'failed','failed','settled','',0);")
        plan = self.plan()
        self.assertIn([unusual], plan['tables']['pikno_settlements']['delete_keys'])
        self.execute(plan)
        self.assertEqual(self.query("SELECT jsonb_build_object('count',count(*)) FROM users")['count'], 2)

    def test_catalog_stage_commit_removes_provider_only_without_backup(self):
        with tempfile.TemporaryDirectory(prefix='sanbao68-catalog-') as folder:
            path = Path(folder).resolve() / 'catalog.json'
            keep = {'provider':'canseedream','id':'keep-model','nested':{'preserve':True}}
            state = {'revision':'old','draft':{'revision':'d','models':[{'provider':'sanbao','id':'old'},keep]},'published':{'revision':'p','models':[keep,{'provider':'sanbao','id':'older'}]},'previous':{'revision':'v','models':[keep]},'events':[{'action':'sync','revision':'historical-hash'}]}
            path.write_text(json.dumps(state),encoding='utf-8')
            original = path.read_bytes()
            staged = C.stage_catalog(path,hashlib.sha256(original).hexdigest(),allowed_directory=Path(folder).resolve())
            self.assertEqual(path.read_bytes(),original)
            self.assertNotIn('old', json.dumps(staged['removed']))
            C.commit_catalog(path,staged,allowed_directory=Path(folder).resolve())
            actual = json.loads(path.read_text(encoding='utf-8'))
            self.assertEqual(actual['draft']['models'],[keep])
            self.assertEqual(actual['published']['models'],[keep])
            self.assertEqual(actual['previous'],state['previous'])
            self.assertEqual(actual['events'],state['events'])
            self.assertEqual(list(Path(folder).iterdir()),[path])

    def test_catalog_changed_after_staging_never_overwrites_it(self):
        with tempfile.TemporaryDirectory(prefix='sanbao68-catalog-') as folder:
            path=Path(folder).resolve()/'catalog.json';path.write_text('{"draft":{"models":[{"provider":"sanbao"}]}}')
            staged=C.stage_catalog(path,hashlib.sha256(path.read_bytes()).hexdigest(),allowed_directory=Path(folder).resolve())
            path.write_text('{"concurrent":"change"}')
            with self.assertRaisesRegex(C.CleanupError,'COMMIT_HASH_DRIFT'):
                C.commit_catalog(path,staged,allowed_directory=Path(folder).resolve())


