:root{color-scheme:light;--canvas:#f3f0eb;--surface:#fffdf9;--ink:#34413d;--muted:#69756f;--primary:#576b5e;--border:#d6d9cf;--clay:#a77f70;font-family:"Segoe UI","Microsoft YaHei",system-ui,sans-serif;color:var(--ink);background:var(--canvas);font-synthesis:none}*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0;font-size:14px}a{color:var(--primary);text-decoration:none}button,input{font:inherit}button,a{touch-action:manipulation;-webkit-tap-highlight-color:transparent}button{cursor:pointer}button:disabled{opacity:.5;cursor:default}a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #788d94;outline-offset:3px}.auth-shell{width:min(450px,calc(100% - 36px));margin:0 auto;padding:44px 0 18px;min-height:100dvh;display:flex;flex-direction:column;justify-content:center}.brand{display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:28px;color:var(--ink);font-size:24px;font-weight:650}.brand img{object-fit:contain}.brand small{display:block;font-size:11px;font-weight:400;letter-spacing:2px;color:var(--muted);margin-top:5px}.auth-card{background:var(--surface);padding:31px 34px 27px;border:1px solid var(--border);border-radius:17px;box-shadow:0 8px 35px #34413d06}.eyebrow{font-size:11px;letter-spacing:2px;color:var(--clay);margin:0 0 12px}h1{font-size:25px;font-weight:600;margin:0 0 10px}p{color:var(--muted);line-height:1.75;margin:0}#description{font-size:12px;margin-bottom:20px}.notice{margin-bottom:18px;padding:11px 13px;border:1px solid var(--border);border-radius:9px;background:#e6ebe3;font-size:12px;white-space:pre-line;overflow-wrap:anywhere}.notice.error{background:#f0e4de;border-color:#d6bfb2;color:#805544}label{display:block;font-size:12px;line-height:1.6;margin-top:15px}input:not([type=checkbox]){display:block;width:100%;min-width:0;border:1px solid var(--border);border-radius:8px;background:#fffdf9;color:var(--ink);padding:11px 12px;margin-top:7px}input[readonly]{background:#f1f1e9}input[type=checkbox]{accent-color:var(--primary);margin:3px 0 0}.primary,.secondary{border-radius:9px;padding:11px 16px;border:1px solid transparent;min-height:42px;white-space:nowrap}.primary{display:block;width:100%;background:var(--primary);color:#fffdf9;font-weight:600;margin-top:23px}.primary:hover:enabled{background:#485b4e}.secondary{background:var(--surface);border-color:var(--border);color:var(--ink);font-size:12px}.text-button{border:0;padding:9px 0;background:none;color:var(--primary);font-size:12px}.auth-links{display:flex;align-items:center;justify-content:center;gap:28px;font-size:12px;margin-top:23px}.code-row{display:flex;gap:9px;align-items:center;margin-top:7px}.code-row input{margin-top:0}.code-row button{flex-shrink:0;padding:9px 11px}.legal{display:flex;gap:9px;margin-top:19px;align-items:flex-start;font-size:11px;color:var(--muted)}.legal label{font-size:11px;margin-top:0}.legal a{text-decoration:underline;text-underline-offset:2px}#turnstile{margin-top:18px;max-width:100%;overflow:hidden}.fine{font-size:11px;margin-top:14px}.result-actions{display:flex;gap:12px;margin-top:13px}.recover{display:grid;gap:9px;margin-top:15px;font-size:12px}.advanced{margin-top:23px;padding-top:19px;border-top:1px solid var(--border);font-size:11px;text-align:center}.advanced a{display:inline-block;margin-top:7px;font-size:12px}footer{text-align:center;color:#8a938a;letter-spacing:1px;font-size:10px;padding:25px 0 0}#reload-status{display:block;margin:10px auto 0}@media(max-width:450px){.auth-shell{padding-top:24px}.brand{margin-bottom:21px}.auth-card{padding:26px 23px}.auth-links{gap:25px}h1{font-size:23px}}@media(max-height:700px){.auth-shell{justify-content:flex-start;padding-top:24px}.brand{margin-bottom:20px}.brand img{width:42px;height:42px}.auth-card{padding-top:24px;padding-bottom:22px}footer{padding-top:19px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
:root{--safe-top:env(safe-area-inset-top,0px);--safe-right:env(safe-area-inset-right,0px);--safe-bottom:env(safe-area-inset-bottom,0px);--safe-left:env(safe-area-inset-left,0px)}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%;scroll-padding-block:20px}
body{padding:0 var(--safe-right) 0 var(--safe-left);overflow-wrap:break-word}
.auth-shell{min-height:100vh;min-height:100dvh;padding-top:max(44px,var(--safe-top));padding-bottom:max(18px,var(--safe-bottom))}
.auth-card{min-width:0}.auth-links,.result-actions{flex-wrap:wrap}button,input,a{scroll-margin-block:24px}button,input:not([type=checkbox]){min-height:44px}.auth-links a,.advanced a{display:inline-flex;align-items:center;min-height:44px}.auth-links{column-gap:24px;row-gap:0}.code-row{min-width:0}.code-row>input{flex:1;width:0}#turnstile{overflow:auto;-webkit-overflow-scrolling:touch}#boot-status{overflow-wrap:anywhere}
@media(max-width:700px),(pointer:coarse){input:not([type=checkbox]){font-size:16px}.text-button{min-height:44px}.auth-shell{justify-content:flex-start;padding-top:max(24px,var(--safe-top))}}
@media(max-height:700px){.auth-shell{padding-top:max(24px,var(--safe-top))}}
@media(max-width:350px){.auth-shell{width:calc(100% - 24px)}.auth-card{padding:24px 16px}.code-row{flex-wrap:wrap}.code-row>input{flex-basis:100%;width:100%}.code-row>button{width:100%}.auth-links{column-gap:18px}}
