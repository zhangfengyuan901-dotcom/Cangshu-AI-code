async(page)=>{
 const base='http://127.0.0.1:48276',shots='D:/PIKNO/output/playwright/relay-hero-auth-current/';
 const passed=[];const check=(value,label)=>{if(!value)throw new Error('Hero check failed: '+label);passed.push(label);};
 await page.setViewportSize({width:1440,height:1000});await page.emulateMedia({reducedMotion:'no-preference'});
 await page.goto(base+'/');await page.locator('.portal-header').waitFor();
 const running=async()=>await page.waitForFunction(()=>{const v=document.querySelector('video');return v&&v.readyState>=2&&!v.paused&&v.currentTime>0.1;});
 await running();
 const props=await page.locator('video').evaluate(v=>({muted:v.muted,defaultMuted:v.defaultMuted,volume:v.volume,loop:v.loop,inline:v.playsInline,autoplay:v.autoplay,width:v.videoWidth,height:v.videoHeight,duration:v.duration}));
 check(props.muted&&props.defaultMuted&&props.volume===0&&props.loop&&props.inline&&props.autoplay,'muted_inline_autoplay_loop');
 check(props.width===1030&&props.height===576&&Math.abs(props.duration-21)<0.2,'real_h264_video_decodes');
 check(await page.locator('.portal-brand-symbol').count()===0&&await page.locator('.portal-brand svg').count()===0,'brand_symbol_removed');
 const visual=await page.locator('video').evaluate(v=>({opacity:getComputedStyle(v).opacity,filter:getComputedStyle(v).filter}));
 check(Number(visual.opacity)<0.6&&visual.filter.includes('0.65'),'dimmed_low_opacity');
 await page.getByRole('button',{name:/暂停背景视频|Pause background video/}).click();
 await page.waitForFunction(()=>document.querySelector('video').paused);
 await page.locator('.portal-developer-section').scrollIntoViewIfNeeded();
 await page.evaluate(()=>scrollTo(0,0));
 check(await page.locator('video').evaluate(v=>v.paused),'manual_pause_preserved');
 await page.getByRole('button',{name:/播放背景视频|Play background video/}).click();await running();
 check(true,'manual_resume');
 await page.locator('.portal-developer-section').scrollIntoViewIfNeeded();
 await page.waitForFunction(()=>document.querySelector('video').paused);
 check(true,'offscreen_video_pauses');
 await page.evaluate(()=>scrollTo(0,0));await running();check(true,'onscreen_video_resumes');
 await page.locator('video').evaluate(v=>{v.currentTime=v.duration-0.1;});
 await page.waitForFunction(()=>{const v=document.querySelector('video');return !v.paused&&v.currentTime<1;});check(true,'native_video_loop_verified');
 await page.screenshot({path:shots+'hero-video-desktop.png'});
 await page.emulateMedia({reducedMotion:'reduce'});await page.goto(base+'/');await page.locator('.portal-header').waitFor();
 check(await page.locator('video').count()===0,'reduced_motion_no_video');
 await page.locator('.portal-hero-poster').evaluate(im=>im.decode());check(true,'reduced_motion_poster');
 await page.emulateMedia({reducedMotion:'no-preference'});await page.setViewportSize({width:390,height:844});await page.goto(base+'/');await running();
 check(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1),'mobile_no_overflow');
 await page.screenshot({path:shots+'hero-video-mobile.png'});
 await page.route('**/portal-media/hero-v1.mp4',route=>route.fulfill({status:404,body:''}));
 await page.goto(base+'/');await page.locator('.portal-header').waitFor();
 await page.waitForFunction(()=>!document.querySelector('video'));
 await page.locator('.portal-hero-poster').evaluate(im=>im.decode());check(true,'failed_video_static_fallback');
 await page.unroute('**/portal-media/hero-v1.mp4');
 await page.setViewportSize({width:1440,height:1000});await page.goto(base+'/');await running();
 return{ok:true,checks:passed.length,passed,video:props,visual,real_generation_calls:0,real_payment_calls:0,synthetic_api:true};
}
