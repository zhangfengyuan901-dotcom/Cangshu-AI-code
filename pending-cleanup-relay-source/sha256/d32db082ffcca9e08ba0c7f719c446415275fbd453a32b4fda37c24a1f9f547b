import hashlib
import argparse
import json
from pathlib import Path
import subprocess

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
SOURCE = ROOT / 'deploy/new-api/backend'
BASELINE = HERE / 'backend-baseline'
PRODUCTION = ROOT / 'output/direct-media-production-current/build.json'
IMAGE = 'golang:1.26.1-alpine'


def digest(path):
    with path.open('rb') as source:
        return hashlib.file_digest(source, 'sha256').hexdigest()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--exact-production-flags', action='store_true')
    parser.add_argument('--source-root', choices=['/build', '/workspace'], default='/build')
    options = parser.parse_args()
    tag = 'baseline63-exactflags' if options.exact_production_flags else 'baseline63'
    if options.source_root != '/build':
        tag += '-workspace'
    manifest = json.loads((BASELINE / 'line-retirement-baseline.json').read_text(encoding='utf-8'))
    before = [item for item in manifest['files'] if item['file'].endswith('.go') and not item['file'].endswith('_test.go')]
    expected_files = {'model/pikno_line_sync.go', 'model/pikno_line_closures.go', 'controller/pikno_line_sync.go',
                      'controller/pikno_lines.go', 'pkg/piknocatalog/catalog.go', 'pkg/piknocatalog/availability.go',
                      'pkg/piknocatalog/sync_snapshot.go'}
    assert {item['file'] for item in before} == expected_files, 'baseline_production_file_map_changed'
    production = json.loads(PRODUCTION.read_text(encoding='utf-8'))
    args = ['docker', 'run', '--rm', '--network', 'none', '--label', 'codex.task=relay-portal-current',
            '--mount', 'type=bind,source=' + str(SOURCE) + ',target=' + options.source_root + ',readonly',
            '--mount', 'type=bind,source=' + str(HERE) + ',target=/out',
            '--mount', 'type=volume,source=relay-portal-gomod,target=/go/pkg/mod',
            '--mount', 'type=volume,source=relay-portal-gobuild,target=/root/.cache/go-build']
    for item in before:
        file = BASELINE / item['file']
        assert digest(file) == item['sha256'], 'baseline_source_hash_drift'
        args += ['--mount', 'type=bind,source=' + str(file) + ',target=' + options.source_root + '/' + item['file'] + ',readonly']
    old_web = HERE / 'backend-web-baseline'
    if (old_web / 'index.html').is_file():
        args += ['--mount', 'type=bind,source=' + str(old_web) + ',target=' + options.source_root + '/web/dist,readonly']
    else:
        old_web = SOURCE / 'web/dist'
    index_hash = digest(old_web / 'index.html')
    ldflags = "-s -w -X 'github.com/QuantumNous/new-api/common.Version=" + production['version'] + "'"
    if options.exact_production_flags:
        metadata = json.loads((HERE / 'baseline63-build-metadata.json').read_text(encoding='utf-8'))
        ldflags = json.loads(metadata['production']['settings']['-ldflags'])
        assert ldflags == '-s -w -X github.com/QuantumNous/new-api/common.Version=' + production['version'], 'production_flags_shape'
    args += ['-w', options.source_root, '-e', 'CGO_ENABLED=0', '-e', 'GOMAXPROCS=2', IMAGE,
             'go', 'build', '-p', '2', '-ldflags', ldflags, '-o', '/out/backend-' + tag]
    result = subprocess.run(args, capture_output=True, text=True, encoding='utf-8', errors='replace')
    (HERE / (tag + '-build.log')).write_text(result.stdout + result.stderr, encoding='utf-8')
    record = {'format': 1, 'exit_code': result.returncode, 'toolchain': IMAGE, 'go_workdir': options.source_root,
              'trimpath': False, 'cgo_enabled': False, 'version': production['version'],
              'ldflags': ldflags,
              'baseline_source_overrides': before, 'old_web_index_sha256': index_hash,
              'production_binary_sha256': production['binary_sha256'], 'production_mutations': 0}
    if result.returncode == 0:
        binary = HERE / ('backend-' + tag)
        record['binary_sha256'] = digest(binary)
        record['binary_bytes'] = binary.stat().st_size
        record['byte_identical_to_production'] = record['binary_sha256'] == record['production_binary_sha256']
    (HERE / (tag + '-build.json')).write_text(json.dumps(record, ensure_ascii=True, indent=2) + '\n', encoding='utf-8')
    print(json.dumps({key: record.get(key) for key in ['exit_code', 'binary_sha256', 'byte_identical_to_production']}))
    raise SystemExit(result.returncode)


if __name__ == '__main__':
    main()
