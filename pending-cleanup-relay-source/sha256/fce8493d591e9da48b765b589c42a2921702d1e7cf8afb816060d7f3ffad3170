import argparse
import datetime
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import socket
import subprocess
import time
import urllib.request
import uuid

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
STATE = HERE / 'website77-proxy.json'
LOCAL_PORT = 42877
REMOTE_PORT = 42777
REMOTE_SOURCE = r'''
import os,select,socket,socketserver
ALLOWED={'api.cloudflare.com','dash.cloudflare.com','hamsterai.cc','speed.cloudflare.com'}
class Handler(socketserver.BaseRequestHandler):
 def handle(self):
  peer=None
  try:
   self.request.settimeout(20); data=b''
   while b'\r\n\r\n' not in data and len(data)<8192:
    part=self.request.recv(1024)
    if not part:return
    data+=part
   header,extra=data.split(b'\r\n\r\n',1)
   method,target,version=header.split(b'\r\n',1)[0].decode('ascii').split(' ')
   host,port=target.rsplit(':',1)
   if method!='CONNECT' or host not in ALLOWED or port!='443':
    self.request.sendall(b'HTTP/1.1 403 Forbidden\r\nContent-Length: 0\r\n\r\n');return
   peer=socket.create_connection((host,443),timeout=20)
   self.request.sendall(b'HTTP/1.1 200 Connection Established\r\n\r\n')
   if extra:peer.sendall(extra)
   self.request.settimeout(None);peer.settimeout(None)
   while True:
    ready,_,_=select.select([self.request,peer],[],[],120)
    if not ready:return
    for origin in ready:
     part=origin.recv(262144)
     if not part:return
     (peer if origin is self.request else self.request).sendall(part)
  except Exception:pass
  finally:
   if peer:peer.close()
class Server(socketserver.ThreadingTCPServer):
 allow_reuse_address=False
 daemon_threads=True
 def handle_error(self,*args):pass
with Server(('127.0.0.1',42777),Handler) as server:server.serve_forever()
'''

def save(data):
    STATE.write_text(json.dumps(data, indent=2)+'\n', encoding='utf-8')

def transport():
    spec=importlib.util.spec_from_file_location('known_transport',ROOT/'output/direct-media-production-current/transport.py')
    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
    return module

def prepare():
    assert not STATE.exists(), 'PROXY_STATE_ALREADY_EXISTS'
    with socket.socket() as check:check.bind(('127.0.0.1', LOCAL_PORT))
    module=transport()
    directory='/tmp/hamster77-connect-'+uuid.uuid4().hex
    code=f'''
import json,os,pathlib,socket,subprocess,sys,time
with socket.socket() as check:check.bind(('127.0.0.1',{REMOTE_PORT}))
directory=pathlib.Path({directory!r});directory.mkdir(mode=0o700)
source=directory/'proxy.py';source.write_text({REMOTE_SOURCE!r});source.chmod(0o600)
child=subprocess.Popen([sys.executable,str(source)],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,close_fds=True,start_new_session=True)
time.sleep(.3)
assert child.poll() is None
print(json.dumps({{'remote_pid':child.pid,'remote_path':str(source),'loopback_only':True}}))
'''
    remote=module.remote(code,timeout=25)
    command=[*module.SSH[:-1],'-N','-o','ExitOnForwardFailure=yes','-o','ServerAliveInterval=15',
             '-o','ServerAliveCountMax=2','-L',f'127.0.0.1:{LOCAL_PORT}:127.0.0.1:{REMOTE_PORT}',module.SSH[-1]]
    child=subprocess.Popen(command,stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,
                           creationflags=subprocess.CREATE_NO_WINDOW if os.name=='nt' else 0)
    state={**remote,'local_tunnel_pid':child.pid,'local_port':LOCAL_PORT,'remote_port':REMOTE_PORT,
           'created_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),
           'tls_intercepted':False,'cloudflare_credentials_copied':False,'production_services_changed':False}
    save(state)
    for _ in range(40):
        assert child.poll() is None, 'SSH_TUNNEL_EXITED'
        try:
            with socket.create_connection(('127.0.0.1',LOCAL_PORT),timeout=.2):break
        except OSError:time.sleep(.1)
    else:raise RuntimeError('SSH_TUNNEL_NOT_READY')
    return {'prepared':True,'local_port':LOCAL_PORT,'loopback_only':True,'tls_intercepted':False,
            'cloudflare_credentials_copied':False,'production_services_changed':False}

def probe():
    state=json.loads(STATE.read_text())
    assert state['loopback_only'] and not state['tls_intercepted']
    results=[]
    for mode,proxies in [('direct',{}),('ecs_tls_tunnel',{'https':f'http://127.0.0.1:{LOCAL_PORT}'})]:
        start=time.monotonic()
        try:
            opener=urllib.request.build_opener(urllib.request.ProxyHandler(proxies))
            req=urllib.request.Request('https://speed.cloudflare.com/__down?bytes=1048576',headers={'User-Agent':'Mozilla/5.0'})
            with opener.open(req,timeout=45) as response:
                data=response.read(1048577)
                assert response.status==200 and len(data)==1048576,'PUBLIC_PROBE_SIZE_FAILED'
            elapsed=time.monotonic()-start
            results.append({'mode':mode,'passed':True,'bytes':len(data),'elapsed_seconds':round(elapsed,3),
                            'bytes_per_second':round(len(data)/elapsed),'sha256':hashlib.sha256(data).hexdigest()})
        except Exception:
            results.append({'mode':mode,'passed':False,'elapsed_seconds':round(time.monotonic()-start,3),
                            'code':'PUBLIC_PROBE_FAILED_DETAILS_WITHHELD'})
    record={'unauthenticated_public_download_only':True,'sample_service':'speed.cloudflare.com','results':results,'traffic_or_source_changed':False}
    (HERE/'website77-proxy-probe.json').write_text(json.dumps(record,indent=2)+'\n')
    return record

def close():
    state=json.loads(STATE.read_text());module=transport()
    code=f'''
import json,os,pathlib,signal
pid={state['remote_pid']};path={state['remote_path']!r}
process=pathlib.Path('/proc')/str(pid)/'cmdline'
if process.exists():
 assert path.encode() in process.read_bytes().split(b'\\x00'),'REMOTE_PROXY_OWNERSHIP_MISMATCH'
 os.kill(pid,signal.SIGTERM)
source=pathlib.Path(path)
assert source.parent.name.startswith('hamster77-connect-') and source.parent.parent==pathlib.Path('/tmp')
if source.exists():source.unlink()
source.parent.rmdir()
print(json.dumps({{'remote_proxy_stopped':True}}))
'''
    result=module.remote(code,timeout=25)
    # Restrict termination to this recorded process and the exact local forwarding endpoint.
    command=f"$p=Get-CimInstance Win32_Process -Filter 'ProcessId={state['local_tunnel_pid']}'; if($null -ne $p){{if($p.Name -notmatch '^ssh(\\.exe)?$' -or $p.CommandLine -notlike '*127.0.0.1:{LOCAL_PORT}:127.0.0.1:{REMOTE_PORT}*'){{throw 'TUNNEL_OWNERSHIP_MISMATCH'}};Stop-Process -Id $p.ProcessId -Force}}"
    completed=subprocess.run(['powershell.exe','-NoProfile','-Command',command],capture_output=True,timeout=20)
    assert completed.returncode==0,'LOCAL_TUNNEL_CLEANUP_FAILED'
    state['closed_at']=datetime.datetime.now(datetime.timezone.utc).isoformat();save(state)
    return {**result,'local_tunnel_stopped':True,'production_services_changed':False}

if __name__=='__main__':
    try:
        parser=argparse.ArgumentParser();parser.add_argument('action',choices=['prepare','probe','close']);args=parser.parse_args()
        print(json.dumps(globals()[args.action]()))
    except Exception as error:
        message=str(error)
        code=message if isinstance(error,(AssertionError,RuntimeError)) and all(c.isupper() or c=='_' for c in message) else 'PROXY_OPERATION_FAILED_DETAILS_WITHHELD'
        print(json.dumps({'passed':False,'code':code}));raise SystemExit(1)
