async (page) => {
 page.setDefaultTimeout(60000);
 const checks=[];const check=(n,v)=>{if(!v)throw new Error(n);checks.push(n)};
 await page.getByRole('button',{name:'编辑',exact:true}).first().click();
 const dialog=page.locator('[data-slot="dialog-content"]');await dialog.waitFor();
 await page.waitForFunction(()=>{const e=document.querySelector('[data-slot="dialog-content"]');return e&&getComputedStyle(e).opacity==='1'});
 check('line_editor_inherits_theme',await dialog.evaluate(e=>getComputedStyle(e).backgroundColor)==='rgb(25, 27, 36)');
 await page.locator('#line-name').focus();
 await page.keyboard.press('Tab');
 await page.locator('#line-name').focus();
 await page.waitForFunction(()=>getComputedStyle(document.querySelector('#line-name')).outlineColor==='rgb(182, 154, 238)');
 check('input_keyboard_focus_visible',await page.locator('#line-name').evaluate(e=>getComputedStyle(e).outlineColor)==='rgb(182, 154, 238)');
 await page.screenshot({path:'D:/PIKNO/output/playwright/relay-admin-theme-current/line-editor.png',fullPage:true});
 await page.setViewportSize({width:390,height:844});
 check('mobile_dialog_fits_viewport',await dialog.evaluate(e=>e.getBoundingClientRect().left>=0&&e.getBoundingClientRect().right<=innerWidth));
 await page.screenshot({path:'D:/PIKNO/output/playwright/relay-admin-theme-current/mobile-line-editor.png',fullPage:true});
 await dialog.getByRole('button',{name:'取消',exact:true}).click();await dialog.waitFor({state:'hidden'});
 await page.locator('[data-slot="sidebar-trigger"]').click();
 const sidebar=page.locator('[data-slot="sidebar"][data-mobile="true"]');await sidebar.waitFor();
 await page.waitForFunction(()=>{const e=document.querySelector('[data-slot="sidebar"][data-mobile="true"]');return e&&getComputedStyle(e).opacity==='1'&&!e.hasAttribute('data-starting-style')});
 check('mobile_sidebar_dark_surface',await sidebar.evaluate(e=>getComputedStyle(e).backgroundColor)==='rgb(16, 17, 22)');
 check('mobile_sidebar_fits_viewport',await sidebar.evaluate(e=>e.getBoundingClientRect().right<=innerWidth));
 await page.screenshot({path:'D:/PIKNO/output/playwright/relay-admin-theme-current/mobile-navigation.png',fullPage:true});
 await sidebar.getByRole('link',{name:'用户',exact:true}).click();
 await sidebar.waitFor({state:'hidden'});
 await page.getByRole('heading',{name:'用户',exact:true}).waitFor();
 check('mobile_navigation_closes_drawer',true);
 check('mobile_document_no_overflow',await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));
 await page.screenshot({path:'D:/PIKNO/output/playwright/relay-admin-theme-current/mobile-users.png',fullPage:true});
 await page.emulateMedia({reducedMotion:'reduce'});
 check('reduced_motion_disables_animation',await page.locator('[data-slot="sidebar-trigger"]').evaluate(e=>getComputedStyle(e).animationName)==='none');
 await page.locator('[data-slot="system-brand"]').click();
 await page.locator('.portal-hero').waitFor();
 check('public_portal_has_no_admin_scope',await page.evaluate(()=>!document.documentElement.hasAttribute('data-admin-theme')));
 check('public_reduced_motion_uses_poster',await page.locator('.portal-hero-poster').isVisible());
 await page.emulateMedia({reducedMotion:'no-preference'});
 await page.locator('video').first().waitFor();
 check('public_video_is_silent_loop',await page.locator('video').first().evaluate(e=>e.muted&&e.loop&&e.playsInline));
 await page.screenshot({path:'D:/PIKNO/output/playwright/relay-admin-theme-current/public-portal-regression.png',fullPage:true});
 await page.goto('http://127.0.0.1:48276/auth-lite/index.html?mode=register',{waitUntil:'domcontentloaded'});
 await page.locator('#auth-form').waitFor();
 check('register_has_no_admin_scope',await page.evaluate(()=>!document.documentElement.hasAttribute('data-admin-theme')));
 check('register_mobile_no_overflow',await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));
 await page.screenshot({path:'D:/PIKNO/output/playwright/relay-admin-theme-current/register-regression.png',fullPage:true});
 const state=await page.evaluate(async()=>await(await fetch('/__qa/state')).json());
 check('no_write_or_action_requests',state.blockedWrites===0&&state.blockedActions===0&&state.generationCalls===0);
 return {passed:true,checks,synthetic:true,stats:state};
}
