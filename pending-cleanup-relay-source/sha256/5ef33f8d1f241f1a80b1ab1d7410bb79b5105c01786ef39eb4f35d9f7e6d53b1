"""Verify the public static release without logging in or creating paid work."""
from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path
import urllib.error
import urllib.request

HERE = Path(__file__).resolve().parent
ORIGIN = 'https://www.piknoai.com'
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
manifest = json.loads((HERE / 'build72.json').read_text(encoding='utf-8'))
media = json.loads((HERE / 'media-manifest.json').read_text(encoding='utf-8'))
checks = []


def request(path, method='GET', extra=None):
    headers = {'User-Agent': 'Mozilla/5.0 Chrome/131.0.0.0', 'Accept-Encoding': 'identity',
               'Cache-Control': 'no-cache', **(extra or {})}
    try:
        response = opener.open(urllib.request.Request(ORIGIN + path, method=method, headers=headers), timeout=30)
    except urllib.error.HTTPError as error:
        response = error
    with response:
        assert response.url.startswith(ORIGIN + '/')
        return response.status, response.headers, response.read()


status, _, body = request('/api/status')
assert status == 200 and json.loads(body)['data']['version'] == manifest['version']
checks.append({'check': 'api_version', 'passed': True})
status, _, body = request('/pay/lanjing/health')
assert status == 200 and json.loads(body)['paymentConfigured'] is True
checks.append({'check': 'existing_bridge_health', 'passed': True})
status, _, body = request('/api/pikno/catalog')
assert status == 200 and len(json.loads(body)['data']['models']) == 8
checks.append({'check': 'published_catalog', 'passed': True})

names = manifest['resources']['changed'] + manifest['resources']['added']
for name in names:
    expected = (HERE / 'backend72-source/web/dist' / name).read_bytes()
    if name == 'index.html':
        expected = expected.replace(b'<!--umami-->\n', b'<!--Umami QuantumNous-->\n').replace(
            b'<!--Google Analytics-->\n', b'<!--Google Analytics QuantumNous-->\n')
    status, _, body = request('/' + name)
    assert status == 200 and hashlib.sha256(body).digest() == hashlib.sha256(expected).digest()
    checks.append({'check': 'public_resource_hash', 'path': '/' + name, 'passed': True})

for asset in media['assets']:
    status, headers, body = request(asset['gif'], 'HEAD')
    assert status == 200 and not body and headers.get_content_type() == 'image/gif'
    checks.append({'check': 'gif_head', 'path': asset['gif'], 'passed': True})
    status, headers, body = request(asset['gif'], extra={'Range': 'bytes=0-63'})
    assert status == 206 and len(body) == 64 and body.startswith((b'GIF87a', b'GIF89a'))
    assert headers.get('Content-Range') == 'bytes 0-63/' + str(asset['original_bytes'])
    checks.append({'check': 'gif_range', 'path': asset['gif'], 'passed': True})

entry = [name for name in names if name.startswith('static/js/index.') and name.endswith('.js')]
assert len(entry) == 1
for path in ['/hub/models', '/hub/billing', '/hub/dashboard']:
    status, _, body = request(path)
    assert status == 200 and ('/' + entry[0]).encode() in body
    checks.append({'check': 'portal_entry', 'path': path, 'passed': True})

record = {'passed': True, 'version': manifest['version'], 'checked_at': datetime.now(timezone.utc).isoformat(),
          'checks': checks, 'asset_hashes': len(names), 'original_gifs': 8,
          'real_payments': 0, 'real_generation_calls': 0, 'customer_login': False}
(HERE / 'public-verification.json').write_text(json.dumps(record, indent=2) + '\n', encoding='utf-8')
print(json.dumps({'passed': True, 'version': manifest['version'], 'checks': len(checks), 'asset_hashes': len(names)}))
