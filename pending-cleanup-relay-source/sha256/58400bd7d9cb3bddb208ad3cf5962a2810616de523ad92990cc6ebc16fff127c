const DOWNLOADS = new Map([
  ['/download/HamsterAI-Portable-1.7.75.exe', {
    key: 'releases/1.7.75/HamsterAI-Portable-1.7.75.exe',
    filename: '仓鼠AI正式版-1.7.75.exe'
  }],
  ['/download/HamsterAI-Portable-1.7.73.exe', {
    key: 'releases/1.7.73/HamsterAI-Portable-1.7.73.exe',
    filename: '仓鼠AI正式版-1.7.73.exe'
  }],
  ['/download/HamsterAI-Portable-1.7.74.exe', {
    key: 'releases/1.7.74/HamsterAI-Portable-1.7.74.exe',
    filename: '仓鼠AI正式版-1.7.74.exe'
  }]
]);

export function publishedDownload(pathname) {
  return DOWNLOADS.get(pathname);
}

export function downloadError(status, text, extraHeaders = {}) {
  return new Response(text, { status, headers: { 'Cache-Control': 'no-store', ...extraHeaders } });
}

function metadataHeaders(object, pathname, file) {
  const headers = new Headers();
  object.writeHttpMetadata(headers);
  headers.set('etag', object.httpEtag);
  headers.set('accept-ranges', 'bytes');
  headers.set('content-disposition', `attachment; filename="${pathname.split('/').pop()}"; filename*=UTF-8''${encodeURIComponent(file.filename)}`);
  headers.set('x-content-type-options', 'nosniff');
  headers.set('cache-control', 'public, max-age=31536000, immutable');
  if (object.uploaded instanceof Date && Number.isFinite(object.uploaded.getTime())) {
    headers.set('last-modified', object.uploaded.toUTCString());
  }
  return headers;
}

function etagMatches(value, etag, weak) {
  return value.split(',').some(part => {
    const candidate = part.trim();
    if (candidate === '*') return true;
    if (!etag) return false;
    return weak ? candidate.replace(/^W\//, '') === etag.replace(/^W\//, '') : candidate === etag && !candidate.startsWith('W/');
  });
}

function conditionalStatus(request, headers) {
  const match = request.headers.get('if-match');
  const noneMatch = request.headers.get('if-none-match');
  const modified = Date.parse(headers.get('last-modified') || '');
  if (match !== null && !etagMatches(match, headers.get('etag'), false)) return 412;
  const unmodifiedSince = Date.parse(request.headers.get('if-unmodified-since') || '');
  if (match === null && Number.isFinite(modified) && Number.isFinite(unmodifiedSince) && modified > unmodifiedSince) return 412;
  if (noneMatch !== null && etagMatches(noneMatch, headers.get('etag'), true)) return 304;
  const modifiedSince = Date.parse(request.headers.get('if-modified-since') || '');
  if (noneMatch === null && Number.isFinite(modified) && Number.isFinite(modifiedSince) && modified <= modifiedSince) return 304;
  return null;
}

function ifRangeMatches(value, headers) {
  if (!value) return true;
  if (value.startsWith('"') || value.startsWith('W/')) return !value.startsWith('W/') && value === headers.get('etag');
  const date = Date.parse(value);
  return Number.isFinite(date) && date === Date.parse(headers.get('last-modified') || '');
}

// Invalid syntax and multiple ranges are ignored. A valid but unsatisfiable
// single byte interval returns 416, matching the complete-file cache path.
function byteRange(value, size) {
  const prefix = /^bytes=(.*)$/i.exec(value);
  if (!prefix) return null;
  if (!prefix[1].trim()) return { unsatisfiable: true };
  const range = /^(\d*)-(\d*)$/.exec(prefix[1].trim());
  if (!range || (!range[1] && !range[2])) return null;
  const first = range[1] ? Number(range[1]) : null;
  const last = range[2] ? Number(range[2]) : null;
  if ((first !== null && !Number.isSafeInteger(first)) || (last !== null && !Number.isSafeInteger(last))) return null;
  if (!size) return { unsatisfiable: true };
  if (first === null) {
    if (last === 0) return { unsatisfiable: true };
    const length = Math.min(last, size);
    return { offset: size - length, length };
  }
  if (first >= size || (last !== null && last < first)) return { unsatisfiable: true };
  const end = last === null ? size - 1 : Math.min(last, size - 1);
  return { offset: first, length: end - first + 1 };
}

function conditionalResponse(status, headers) {
  headers.delete('content-length');
  headers.delete('content-range');
  if (status !== 304) {
    headers.set('cache-control', 'no-store');
    headers.set('cloudflare-cdn-cache-control', 'no-store');
  }
  return new Response(null, { status, headers });
}

async function discardBody(response) {
  try {
    await response.body?.cancel();
  } catch {
    // The response may already have ended; condition failures still have no body.
  }
}

export async function enforceDownloadConditions(request, response) {
  if (![200, 206, 304, 416].includes(response.status)) return response;
  const headers = new Headers(response.headers);
  // Cached responses can bypass the origin handler, including its strong
  // preconditions. Evaluate them before interpreting any Range error.
  const status = conditionalStatus(request, headers);
  if (status && status !== response.status) {
    await discardBody(response);
    return conditionalResponse(status, headers);
  }
  if (response.status === 416) {
    await discardBody(response);
    const total = /\/(\d+)\s*$/.exec(headers.get('content-range') || '')?.[1];
    if (total) headers.set('content-range', `bytes */${total}`);
    headers.set('content-length', '0');
    headers.set('cache-control', 'no-store');
    headers.set('cloudflare-cdn-cache-control', 'no-store');
    return new Response(null, { status: 416, headers });
  }
  return response;
}

function storageConditions(request) {
  const headers = new Headers();
  // R2 checks the conditions supplied to it. Omit date validators whenever
  // their corresponding ETag validator takes precedence in HTTP semantics.
  for (const [etag, date] of [['if-match', 'if-unmodified-since'], ['if-none-match', 'if-modified-since']]) {
    const field = request.headers.has(etag) ? etag : date;
    if (request.headers.has(field)) headers.set(field, request.headers.get(field));
  }
  return headers;
}

async function serve(request, env, pathname, file) {
  const rangeHeader = request.method === 'GET' ? request.headers.get('range') : null;
  // Workers Cache may turn HEAD into GET to populate a complete entry. If
  // HEAD reaches this fallback, its empty body must never fill a GET entry.
  if (request.method === 'HEAD' || rangeHeader !== null) {
    const metadata = await env.DOWNLOADS.head(file.key);
    if (!metadata) return downloadError(404, 'File not found');
    const headers = metadataHeaders(metadata, pathname, file);
    const status = conditionalStatus(request, headers);
    if (request.method === 'HEAD') headers.set('cloudflare-cdn-cache-control', 'no-store');
    if (status) return conditionalResponse(status, headers);
    if (request.method === 'HEAD') {
      headers.set('content-length', String(metadata.size));
      return new Response(null, { status: 200, headers });
    }
    const range = ifRangeMatches(request.headers.get('if-range'), headers) ? byteRange(rangeHeader, metadata.size) : null;
    if (range?.unsatisfiable) {
      headers.set('content-range', `bytes */${metadata.size}`);
      headers.set('content-length', '0');
      headers.set('cache-control', 'no-store');
      return new Response(null, { status: 416, headers });
    }
    if (range) {
      const object = await env.DOWNLOADS.get(file.key, { range, onlyIf: new Headers({ 'If-Match': metadata.httpEtag }) });
      if (!object) return downloadError(404, 'File not found');
      if (!('body' in object)) return downloadError(412, 'Precondition failed');
      headers.set('content-range', `bytes ${range.offset}-${range.offset + range.length - 1}/${metadata.size}`);
      headers.set('content-length', String(range.length));
      return new Response(object.body, { status: 206, headers });
    }
  }
  // Workers Cache removes Range on a cold cache lookup, stores this complete
  // streamed 200 response, then produces the client's interval itself.
  const object = await env.DOWNLOADS.get(file.key, { onlyIf: storageConditions(request) });
  if (!object) return downloadError(404, 'File not found');
  const headers = metadataHeaders(object, pathname, file);
  const status = conditionalStatus(request, headers);
  if (status || !('body' in object)) {
    if ('body' in object) await object.body.cancel?.();
    return conditionalResponse(status || 412, headers);
  }
  headers.set('content-length', String(object.size));
  return new Response(object.body, { status: 200, headers });
}

export async function serveDownload(request, env) {
  const pathname = new URL(request.url).pathname;
  const file = publishedDownload(pathname);
  if (!file) return downloadError(404, 'File not found');
  if (!['GET', 'HEAD'].includes(request.method)) return downloadError(405, 'Method Not Allowed', { Allow: 'GET, HEAD' });
  try {
    return await serve(request, env, pathname, file);
  } catch {
    return downloadError(503, 'Download temporarily unavailable', { 'Retry-After': '30' });
  }
}
