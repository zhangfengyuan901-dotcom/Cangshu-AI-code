const assert=require('node:assert/strict');
const fs=require('node:fs');
const http=require('node:http');
const path=require('node:path');
const electron=require('electron');
const {app,BrowserWindow,session}=electron;

const packaged=path.join(__dirname,'artifacts/win-unpacked/resources/app.asar');
const {createDesktopAccount,PARTITION}=require(path.join(packaged,'electron/account-desktop.cjs'));
const profile=fs.mkdtempSync(path.join(__dirname,'fixture-profile-'));
app.setPath('userData',profile);
app.setPath('sessionData',profile);
app.disableHardwareAcceleration();
const relay='https://www.piknoai.com';
const provider='https://2347637.pay.lanjingzf.com';
const trade='USR12NOFIXTURE1';
const counts={create:0,submit:0,providerPage:0,return:0,status:0,cancel:0,unexpected:0};
const ok=data=>Response.json({success:true,data});
const redirect=url=>new Response(null,{status:303,headers:{Location:url}});
const delay=ms=>new Promise(resolve=>setTimeout(resolve,ms));
async function waitFor(fn){
  for(let elapsed=0;elapsed<12000;elapsed+=50){
    if(await fn())return;
    await delay(50);
  }
  throw Error('FIXTURE_WAIT_TIMEOUT');
}

async function run(){
  const server=http.createServer((_req,res)=>res.end('<!doctype html><title>Payment fixture</title>'));
  await new Promise(resolve=>server.listen(0,'127.0.0.1',resolve));
  const appUrl=`http://127.0.0.1:${server.address().port}/`;
  const partition=session.fromPartition(PARTITION);
  partition.protocol.handle('https',async request=>{
    const url=new URL(request.url);
    if(url.origin===relay){
      switch(url.pathname){
        case '/api/user/auth/refresh':
          return ok({access_token:'fixture-access',access_expires_at:Date.now()/1000+120,user:{id:12},session:{sid:'fixture-session'}});
        case '/api/user/self':
          return ok({id:12,username:'fixture',quota:counts.status>1?150:100,used_quota:0});
        case '/api/status':
          return ok({quota_per_unit:1,usd_exchange_rate:1});
        case '/api/user/self/groups':
          return ok({});
        case '/api/user/topup/info':
          return ok({fixed_cny_topup:true,enable_online_topup:true,payment_compliance_confirmed:true,payment_cancel_supported:true,amount_options:[50],pay_methods:[{type:'alipay'}]});
        case '/api/user/amount':
          return ok('50.00');
        case '/api/user/pay':
          counts.create++;
          return Response.json({message:'success',url:relay+'/pay/lanjing/epay/submit.php',data:{pid:'2347637',type:'alipay',out_trade_no:trade,notify_url:relay+'/api/user/epay/notify',return_url:relay+'/account-lite/index.html?tab=topup&payment_return=1',name:'fixture',money:'50.00',sign:'c'.repeat(32),sign_type:'MD5'}});
        case '/api/user/topup/self':
          return ok({total:1,items:[{user_id:12,trade_no:trade,money:50,payment_method:'alipay',status:counts.status>1?'success':'pending',create_time:1700000000}]});
        case '/api/user/topup/status':
          if(request.method!=='GET'||url.searchParams.get('trade_no')!==trade)break;
          counts.status++;
          return ok({trade_no:trade,money:50,payment_method:'alipay',status:counts.status>1?'success':'pending'});
        case '/api/user/topup/cancel':
          counts.cancel++;
          return new Response(null,{status:403});
        case '/pay/lanjing/epay/submit.php': {
          const posted=new URLSearchParams(await request.text());
          if(request.method!=='POST'||posted.get('out_trade_no')!==trade)break;
          counts.submit++;
          return redirect(provider+'/payPage/pay.html?orderId=fixture');
        }
        case '/pay/lanjing/return':
          counts.return++;
          return redirect(relay+'/account-lite/index.html?tab=topup&payment_return=1&trade_no=untrusted');
      }
    }
    if(url.origin===provider&&url.pathname==='/payPage/pay.html'){
      counts.providerPage++;
      return redirect(relay+'/pay/lanjing/return?fixture=1');
    }
    if(url.pathname!=='/favicon.ico')counts.unexpected++;
    return new Response(null,{status:403});
  });

  const win=new BrowserWindow({show:false,webPreferences:{preload:path.join(packaged,'electron/app-events.cjs'),sandbox:true,contextIsolation:true}});
  let cashier;
  class HiddenFixtureWindow extends BrowserWindow{
    constructor(options){super(options);cashier=this;}
    show(){}
    focus(){}
  }
  const account=createDesktopAccount({window:win,electron:{...electron,BrowserWindow:HiddenFixtureWindow},appUrl,journalFile:path.join(profile,'operations.json'),connectCreatedKey:()=>{throw Error('unexpected fixture write');}});
  try{
    await win.loadURL(appUrl);
    await win.webContents.executeJavaScript("window.fixtureEvents=0; window.addEventListener('hamster-payment-updated',()=>window.fixtureEvents++);");
    const invoke=(name,payload={})=>win.webContents.executeJavaScript(`window.hamsterDesktopAccount.command(${JSON.stringify(name)},${JSON.stringify({accountId:12,...payload})})`);
    const quote=await invoke('payment-quote',{amount:50,method:'alipay'});assert.equal(quote.ok,true);
    const created=await invoke('payment-create',{quoteId:quote.quoteId,confirmed:true});assert.equal(created.ok,true);
    const opened=await invoke('payment-open');assert.equal(opened.paymentOpened,true);
    const prefs=cashier.webContents.getLastWebPreferences();
    assert.equal(prefs.sandbox,true);assert.equal(prefs.contextIsolation,true);assert.equal(prefs.nodeIntegration,false);assert.ok(!prefs.preload);
    await waitFor(async()=>cashier.isDestroyed()&&await win.webContents.executeJavaScript('window.fixtureEvents')>=2);
    const listed=await invoke('payment-orders');
    assert.equal(listed.pending,null);assert.equal(listed.items[0].status,'success');
    const balance=await win.webContents.executeJavaScript("window.hamsterDesktopAccount.command('snapshot')");
    assert.equal(balance.balance,150);
    assert.deepEqual(counts,{create:1,submit:1,providerPage:1,return:1,status:2,cancel:0,unexpected:0});
    return {ok:true,scope:'real_electron_windows_with_synthetic_partition_from_candidate_asar',counts,verifiedBalanceRefresh:true,realPaymentCalls:0};
  }finally{
    account.dispose();win.destroy();partition.protocol.unhandle('https');
    server.closeAllConnections();server.close();
  }
}

app.whenReady().then(run).then(result=>{
  fs.writeFileSync(path.join(__dirname,'electron-fixture-verification.json'),JSON.stringify(result,null,2)+'\n');
  app.exit(0);
}).catch(error=>{
  const result={ok:false,code:error.code==='ERR_ASSERTION'?'FIXTURE_ASSERTION_FAILED':error.message==='FIXTURE_WAIT_TIMEOUT'?'FIXTURE_WAIT_TIMEOUT':'FIXTURE_FAILED',counts};
  fs.writeFileSync(path.join(__dirname,'electron-fixture-verification.json'),JSON.stringify(result,null,2)+'\n');
  app.exit(1);
});
