import hashlib,json,subprocess
from pathlib import Path
HERE=Path(__file__).resolve().parent
base=json.loads((HERE/'baseline67.json').read_text(encoding='utf-8'))
source=HERE/'baseline67-source'
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
assert all(sha(source/i['file'])==i['sha256'] for i in base['runtime_source_files'])
image='golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039'
r=subprocess.run(['docker','run','--rm','--network','none','--label','codex.task=relay-sanbao-retirement-current',
    '--mount','type=bind,source='+str(source)+',target=/workspace,readonly',
    '--mount','type=bind,source='+str(HERE)+',target=/out',
    '--mount','type=volume,source=relay-portal-gomod,target=/go/pkg/mod',
    '--mount','type=volume,source=relay-portal-gobuild,target=/root/.cache/go-build',
    '-w','/workspace','-e','CGO_ENABLED=0','-e','GOMAXPROCS=2',image,'go','build','-p','2',
    '-ldflags','-s -w -X github.com/QuantumNous/new-api/common.Version='+base['version'],'-o','/out/backend67-baseline'],capture_output=True,timeout=240)
(HERE/'baseline67-build.log').write_bytes(r.stdout+r.stderr);assert r.returncode==0,'BASELINE67_BUILD_FAILED'
actual=sha(HERE/'backend67-baseline');assert actual==base['production_binary_sha256'],'BASELINE67_HASH_MISMATCH'
base['byte_identical_to_production67']=True;(HERE/'baseline67.json').write_text(json.dumps(base,indent=2)+'\n',encoding='utf-8')
print(json.dumps({'byte_identical_to_production67':True,'binary_sha256':actual}))
