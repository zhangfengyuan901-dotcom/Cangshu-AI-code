"""Unauthenticated, fixed-origin public GETs. Never print response bodies."""
from concurrent.futures import ThreadPoolExecutor
import datetime
import hashlib
import json
from pathlib import Path
import re
import urllib.error
import urllib.request

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
DIST = ROOT / 'build/hamster-trim44-web/dist'
ORIGIN = 'https://www.piknoai.com'


class SamePublicOrigin(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, response, code, message, headers, newurl):
        raise urllib.error.HTTPError(request.full_url, code, 'PUBLIC_REDIRECT_REJECTED', headers, None)


def main():
    manifest = json.loads((HERE / 'build64.json').read_text())
    entry = manifest['frontend_entry_script']
    entry_code = (DIST / entry.lstrip('/')).read_text(encoding='utf-8')
    portal_ids = set()
    for file in (DIST / 'static/js/async').glob('*.js'):
        text = file.read_text(encoding='utf-8')
        if any(marker in text for marker in ('/hub/models', 'portal-shell', 'portal-home')):
            portal_ids.add(file.name.split('.', 1)[0])
    assert portal_ids, 'PORTAL_LAZY_CHUNK_NOT_IDENTIFIED'
    selected_ids = set(portal_ids)
    for group in re.findall(r'Promise\.all\(\[([^\]]{1,3000})\]\)', entry_code):
        ids = set(re.findall(r'\.e\((\d+)\)', group))
        if ids & portal_ids:
            selected_ids.update(ids)
    paths = {row['path'] for row in manifest['frontend_resources']}
    lazy = set()
    for folder, extension in [('static/js/async', '.js'), ('static/css/async', '.css')]:
        for file in (DIST / folder).glob('*' + extension):
            if file.name.split('.', 1)[0] in selected_ids:
                lazy.add('/' + file.relative_to(DIST).as_posix())
    paths.update(lazy)
    paths.update(manifest['public_paths'])
    assert len(paths) <= 60 and all(re.fullmatch(r'/[A-Za-z0-9_./-]*', path) and '..' not in path for path in paths), 'PUBLIC_PATH_WHITELIST_INVALID'

    def check(path):
        html = path in manifest['public_paths']
        result = {'path': path, 'status': None, 'bytes': 0, 'sha256': None, 'content_type': None,
                  'passed': False, 'code': 'PUBLIC_NETWORK_FAILED'}
        try:
            request = urllib.request.Request(ORIGIN + path, headers={'Accept-Encoding': 'identity',
                'Accept': 'text/html' if html else '*/*', 'User-Agent': 'PIKNO-public-readonly-check/1'})
            with urllib.request.build_opener(SamePublicOrigin()).open(request, timeout=25) as response:
                result['status'] = response.status
                result['content_type'] = response.headers.get_content_type()
                body = response.read(10 * 1024 * 1024 + 1)
            result['bytes'] = len(body)
            result['sha256'] = hashlib.sha256(body).hexdigest()
            if len(body) > 10 * 1024 * 1024:
                result['code'] = 'PUBLIC_RESOURCE_SIZE_LIMIT'
                return result
            if html:
                result['candidate_entry_present'] = entry.encode() in body
                result['passed'] = result['status'] == 200 and result['content_type'] == 'text/html' and result['candidate_entry_present']
            else:
                expected = (DIST / path.lstrip('/')).read_bytes()
                result['expected_sha256'] = hashlib.sha256(expected).hexdigest()
                mime = {'text/css'} if path.endswith('.css') else {'application/javascript', 'text/javascript'} if path.endswith(('.js', '.mjs')) else {'image/png'}
                result['passed'] = result['status'] == 200 and result['sha256'] == result['expected_sha256'] and result['content_type'] in mime
            result['code'] = 'PUBLIC_HTTP_AND_CONTENT_VERIFIED' if result['passed'] else 'PUBLIC_CONTENT_OR_MIME_MISMATCH'
        except urllib.error.HTTPError as error:
            result['status'], result['code'] = error.code, 'PUBLIC_HTTP_ERROR'
        except TimeoutError:
            result['code'] = 'PUBLIC_NETWORK_TIMEOUT'
        except Exception:
            pass
        return result

    with ThreadPoolExecutor(max_workers=4) as pool:
        rows = list(pool.map(check, sorted(paths)))
    evidence = {'format': 1, 'checked_at': datetime.datetime.now(datetime.timezone.utc).isoformat(),
                'passed': all(row['passed'] for row in rows), 'checked_count': len(rows),
                'lazy_portal_paths': sorted(lazy), 'resources': rows, 'generation_requests': 0,
                'production_mutations': 0, 'credentials_supplied': False, 'response_bodies_saved': False,
                'scope': 'public HTTP routes and fixed/local-code-selected resources; browser execution separate'}
    (HERE / 'live-public-assets-verification.json').write_text(json.dumps(evidence, indent=2) + '\n', encoding='utf-8')
    print(json.dumps({'passed': evidence['passed'], 'checks': len(rows), 'passed_checks': sum(row['passed'] for row in rows),
                      'lazy_portal_resources': len(lazy), 'production_mutations': 0}))
    return 0 if evidence['passed'] else 1


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except Exception:
        print(json.dumps({'passed': False, 'code': 'PUBLIC_ASSET_CHECK_FAILED_DETAILS_WITHHELD', 'production_mutations': 0}))
        raise SystemExit(1)
