func stablePublicModel(entry piknocatalog.Entry) string {
	identifier := entry.ID
	prefix := "pikno-" + entry.Kind + "-"
	switch entry.Provider {
	case "packy":
		identifier = "flare"
	case "sanbao":
		identifier = "sb-" + strings.TrimPrefix(entry.ID, "sanbao/")
	case "canseedream":
		identifier = "cs-" + strings.TrimPrefix(entry.ID, "canseedream/video/")
	}
	identifier = strings.NewReplacer("/", "-", " ", "-").Replace(identifier)
	result := prefix + identifier
	if len(result) <= 120 {
		return result
	}
	hash := fmt.Sprintf("%x", sha256.Sum256([]byte(entry.Provider+"\x00"+entry.ID)))[:16]
	return result[:103] + "-" + hash
}

func catalogEntrySeed(entry piknocatalog.Entry, fetchedAt string) (model.PiknoLineSeed, error) {
	pluginKey := ""
	switch entry.Provider {
	case "sanbao":
		pluginKey = "pikno-sanbao"
	case "canseedream":
		pluginKey = "pikno-canseedream"
	case "packy":
	default:
		return model.PiknoLineSeed{}, errors.New("unsupported catalog provider")
	}
	prices := make([]model.PiknoLinePrice, 0, len(entry.Prices))
	for _, price := range entry.Prices {
		quota := 0
		if price.RetailCNY > 0 && !model.PiknoLineSyncEnabled() {
			converted, err := common.QuotaRoundStrict(price.RetailCNY * 1_000_000)
			if err != nil {
				return model.PiknoLineSeed{}, err
			}
			quota = converted
		}
		prices = append(prices, model.PiknoLinePrice{
			Resolution: price.Resolution, Unit: price.Unit, CostCNY: price.CostCNY,
			SuggestedCNY: price.RetailCNY, RetailQuota: quota,
		})
	}
	surcharge := 0
	if entry.ReferenceSurchargeCNY > 0 && !model.PiknoLineSyncEnabled() {
		converted, err := common.QuotaRoundStrict(entry.ReferenceSurchargeCNY * 1_000_000)
		if err != nil {
			return model.PiknoLineSeed{}, err
		}
		surcharge = converted
	}
	seed := model.PiknoLineSeed{
		PublicModel: stablePublicModel(entry), SourceID: entry.ID, DisplayName: entry.Name,
		Kind: entry.Kind, Provider: entry.Provider, UpstreamModel: entry.ID, PluginKey: pluginKey,
		UpstreamAvailable: entry.Available, Resolutions: entry.Resolutions, Ratios: entry.Ratios,
		Qualities: entry.Qualities,
		Durations: entry.Durations, MaxImages: entry.MaxImages, MaxVideos: entry.MaxVideos,
		MaxAudio: entry.MaxAudio, MaxMediaTotal: entry.MaxMediaTotal, Prices: prices, PriceIssue: entry.PriceIssue,
		BillingUnit: entry.BillingUnit, CostIssueCode: entry.CostIssueCode, BillingIssueCode: entry.BillingIssueCode,
		ReferenceSurchargeQuota: surcharge, FetchedAt: fetchedAt,
	}
	seed.ChannelID = model.RecommendPiknoChannel(seed)
	return seed, nil
}

func PiknoLinesSync(c *gin.Context) {
	if model.PiknoLineSyncEnabled() {
		if err := PiknoSyncCatalogOnce(c.Request.Context(), true); err != nil {
			piknoLineError(c, err)
			return
		}
		PiknoLinesAdmin(c)
		return
	}
	entries, err := piknocatalog.Fetch(c.Request.Context())
	if err != nil {
		piknoLineError(c, err)
		return
	}
	fetchedAt := time.Now().UTC().Format(time.RFC3339)
	seeds := make([]model.PiknoLineSeed, 0, len(entries))
	for _, entry := range entries {
		seed, convertErr := catalogEntrySeed(entry, fetchedAt)
		if convertErr != nil {
			piknoLineError(c, convertErr)
			return
		}
		seeds = append(seeds, seed)
	}
	tools := piknoToolSeeds(fetchedAt)
	readiness, readyErr := piknoReadToolReadiness(c.Request.Context())
	for index := range tools {
		tools[index].UpstreamAvailable = readyErr == nil && readiness.available(tools[index].UpstreamModel)
	}
	seeds = append(seeds, tools...)
	if err = preparePiknoTaskPlugins(seeds); err != nil {
		piknoLineError(c, err)
		return
	}
	if err = model.SyncPiknoLines(seeds, c.GetInt("id")); err != nil {
		piknoLineError(c, err)
		return
	}
	PiknoLinesAdmin(c)
}

// preparePiknoTaskPlugins keeps task adapters as an internal implementation
// detail. An operator synchronizing lines must not also manage plugin status.
func preparePiknoTaskPlugins(seeds []model.PiknoLineSeed) error {
	keys := make(map[string]struct{})
	for _, seed := range seeds {
		if seed.Provider == "hamster-tools" && !seed.UpstreamAvailable {
			continue
		}
		if seed.PluginKey != "" {
			keys[seed.PluginKey] = struct{}{}
		}
	}
	for key := range keys {
		if err := model.SetTaskPluginEnabled(key, true); err != nil {
			return fmt.Errorf("线路适配器 %s 未安装或无法启用: %w", key, err)
		}
	}
	SyncTaskPluginsOnce()
	for key := range keys {
		if _, ok := jsplugin.DefaultRegistry.Get(key); !ok {
			return fmt.Errorf("线路适配器 %s 启动失败", key)
		}
	}
	return nil
}

// Fixed existing workflows; no workflow editor, independent wallet or new
// customer account. Remain closed until the execution bridge is configured.
func piknoToolSeeds(fetchedAt string) []model.PiknoLineSeed {
	ready := os.Getenv("PIKNO_TOOLS_ENABLED") == "true" && len(os.Getenv("PIKNO_TOOLS_BRIDGE_SECRET")) >= 32
	seeds := []model.PiknoLineSeed{
		{PublicModel: "pikno-tool-digital", SourceID: "hamster-tools/digital", DisplayName: "数字人", Kind: "video", Provider: "hamster-tools", UpstreamModel: "digital", PluginKey: "pikno-tools", UpstreamAvailable: ready, MaxImages: 1, MaxAudio: 1, Prices: []model.PiknoLinePrice{{Resolution: "default", Unit: "request", SuggestedCNY: 5, RetailQuota: 5_000_000}}, FetchedAt: fetchedAt},
		{PublicModel: "pikno-tool-depth", SourceID: "hamster-tools/depth", DisplayName: "黑白深度视频", Kind: "video", Provider: "hamster-tools", UpstreamModel: "depth", PluginKey: "pikno-tools", UpstreamAvailable: ready, MaxVideos: 1, Prices: []model.PiknoLinePrice{{Resolution: "default", Unit: "request", SuggestedCNY: 0.5, RetailQuota: 500_000}}, FetchedAt: fetchedAt},
	}
	for index := range seeds {
		seeds[index].Resolutions = []string{}
		seeds[index].Ratios = []string{}
		seeds[index].Durations = []float64{}
		seeds[index].ChannelID = model.RecommendPiknoChannel(seeds[index])
	}
	return seeds
}

func PiknoLineUpdate(c *gin.Context) {
	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 128<<10)
	var request struct {
		PublicModel     string                  `json:"public_model"`
		ExpectedVersion int64                   `json:"expected_version"`
		Name            *string                 `json:"name"`
		Enabled         *bool                   `json:"enabled"`
		Prices          *[]model.PiknoLinePrice `json:"prices"`
	}
	if err := common.DecodeJson(c.Request.Body, &request); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"success": false, "message": "Invalid line update"})
		return
	}
	view, err := model.UpdatePiknoLineDraft(request.PublicModel, model.PiknoLinePatch{
		ExpectedVersion: request.ExpectedVersion, DisplayName: request.Name, Enabled: request.Enabled,
		Prices: request.Prices,
	}, c.GetInt("id"))
	if err != nil {
		piknoLineError(c, err)
		return
	}
	c.JSON(http.StatusOK, gin.H{"success": true, "data": view})
}

