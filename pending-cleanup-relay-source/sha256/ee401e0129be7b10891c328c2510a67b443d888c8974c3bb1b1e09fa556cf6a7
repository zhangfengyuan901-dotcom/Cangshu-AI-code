async (page) => {
 page.setDefaultTimeout(90000);
 const checks=[];const check=(n,v)=>{if(!v)throw new Error(n);checks.push(n)};
 await page.getByRole('button',{name:'表格视图',exact:true}).click();
 const table=page.locator('[data-table="managed"]').first();await table.waitFor();
 check('deployed_managed_table_and_synthetic_rows',await table.locator('tbody tr').count()===5);
 check('deployed_table_header_color',await table.locator('thead').evaluate(e=>getComputedStyle(e).backgroundColor)==='rgb(28, 30, 40)');
 await page.screenshot({path:'D:/PIKNO/output/playwright/relay-admin-theme-current/live-table-synthetic.png',fullPage:true});
 await page.getByRole('button',{name:/创建渠道/}).click();
 const sheet=page.locator('[data-slot="sheet-content"]');await sheet.waitFor();
 check('deployed_editor_dark_color',await sheet.evaluate(e=>getComputedStyle(e).backgroundColor)==='rgb(11, 12, 16)');
 await page.keyboard.press('Escape');await sheet.waitFor({state:'hidden'});
 await page.getByRole('link',{name:'用户',exact:true}).click();
 await page.getByRole('heading',{name:'用户',exact:true}).waitFor();
 await page.getByText('synthetic-ui-5',{exact:true}).waitFor();
 await page.getByRole('button',{name:'打开菜单',exact:true}).first().click();
 await page.getByRole('menuitem',{name:'删除',exact:true}).click();
 const confirm=page.locator('[data-slot="alert-dialog-content"]');await confirm.waitFor();
 check('deployed_delete_confirmation_stays_red',await confirm.getByRole('button',{name:'删除',exact:true}).evaluate(e=>getComputedStyle(e).color)==='rgb(255, 139, 149)');
 await confirm.getByRole('button',{name:'取消',exact:true}).click();await confirm.waitFor({state:'hidden'});
 await page.setViewportSize({width:390,height:844});
 await page.locator('[data-slot="sidebar-trigger"]').click();
 const mobile=page.locator('[data-slot="sidebar"][data-mobile="true"]');await mobile.waitFor();
 check('deployed_mobile_navigation_color',await mobile.evaluate(e=>getComputedStyle(e).backgroundColor)==='rgb(16, 17, 22)');
 await page.keyboard.press('Escape');await mobile.waitFor({state:'hidden'});
 check('deployed_mobile_no_overflow',await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));
 await page.screenshot({path:'D:/PIKNO/output/playwright/relay-admin-theme-current/live-mobile-synthetic.png',fullPage:true});
 return {passed:true,checks,synthetic_admin_only:true,production_api_requests_mocked:true,real_customer_login:false,real_generation_calls:0,real_payment_calls:0};
}
