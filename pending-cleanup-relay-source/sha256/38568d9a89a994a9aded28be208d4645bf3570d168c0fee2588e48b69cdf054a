'use strict';
const http=require('node:http'),fs=require('node:fs'),path=require('node:path');
const dev=path.resolve(__dirname,'../../top-tabs-1.7.82-current/dev');
const project={id:'11111111-1111-4111-8111-111111111111',title:'浅色画布检查',revision:1,nodes:[
 {id:'text-0',type:'text',position:{x:24,y:24},data:{label:'画面提示词',text:'清晨的窗边，柔和的自然光。'}},
 {id:'gen-0',type:'generation',position:{x:404,y:24},data:{label:'图片生成',channel:'image',prompt:'简洁的产品展示',model:'',options:{}}},
 {id:'upload-0',type:'upload',position:{x:24,y:350},data:{label:'素材上传'}},
 {id:'output-0',type:'output',position:{x:784,y:24},data:{label:'输出结果'}}
],edges:[],runs:[],viewport:{x:0,y:0,zoom:1}};
const types={'.html':'text/html; charset=utf-8','.css':'text/css; charset=utf-8','.js':'text/javascript; charset=utf-8','.mjs':'text/javascript; charset=utf-8','.woff2':'font/woff2','.ttf':'font/ttf','.txt':'text/plain; charset=utf-8','.png':'image/png'};
const server=http.createServer((req,res)=>{
 const url=new URL(req.url,'http://127.0.0.1');
 const send=(body,status=200)=>{res.writeHead(status,{'Content-Type':'application/json'});res.end(JSON.stringify(body));};
 if(url.pathname.startsWith('/chat-api/')){if(url.pathname==='/chat-api/config')return send({ready:false,metered:false});if(url.pathname==='/chat-api/sessions')return send([]);return send({});}
 if(url.pathname.startsWith('/api/')){
  if(url.pathname==='/api/relay/catalog/events'){res.writeHead(200,{'Content-Type':'text/event-stream'});res.write(': synthetic fixture\n\n');const timer=setInterval(()=>res.write(': heartbeat\n\n'),10000);req.once('close',()=>clearInterval(timer));return;}
  if(url.pathname==='/api/relay/state')return send({revision:1,relayMode:false,configured:false,toolConfigured:false});
  if(url.pathname==='/api/uploads/status')return send({kind:'legacy',state:'pending',connected:false});
  if(url.pathname==='/api/assets')return send({items:[]});
  if(url.pathname==='/api/canvas/models')return send({data:[],revision:1});
  if(url.pathname==='/api/canvas/projects')return send({projects:[{id:project.id,title:project.title}]});
  if(url.pathname.startsWith('/api/canvas/projects/'+project.id))return send(project);
  return send({});
 }
 if(url.pathname==='/studio-api/error-report')return send({ok:true});
 let target;
 if(url.pathname==='/hamster-logo.png')target=path.join(dev,'public/hamster-mark.png');
 else if(url.pathname==='/workbench.css')target=path.join(dev,'smart-video-agent/studio-ui/workbench.css');
 else if(url.pathname.startsWith('/shared/'))target=path.join(dev,'public',url.pathname.slice(8));
 else if(url.pathname.startsWith('/chat'))target=path.join(dev,'smart-video-agent/chat-ui',url.pathname==='/chat/'||url.pathname==='/chat'?'index.html':url.pathname.slice(6));
 else target=path.join(dev,'canvas/dist',url.pathname==='/'?'index.html':url.pathname.slice(1));
 if(!target.startsWith(dev+path.sep)){res.writeHead(403);return res.end();}
 fs.readFile(target,(error,data)=>{if(error){res.writeHead(404);return res.end();}res.writeHead(200,{'Content-Type':types[path.extname(target)]||'application/octet-stream'});res.end(data);});
});
server.listen(0,'127.0.0.1',()=>console.log(JSON.stringify({port:server.address().port,synthetic:true})));
