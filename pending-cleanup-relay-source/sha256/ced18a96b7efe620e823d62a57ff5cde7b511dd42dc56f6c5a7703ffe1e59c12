    const session = bundle?.session?.sid;
    if (!session) return clear();
    const { response, data } = await wire('/api/user/auth/logout', { method: 'POST', headers: { 'X-Auth-Session': session, Authorization: `Bearer ${bundle.access_token}` } });
    if (response.status === 429) throw rateLimitError(response);
    if (!response.ok || data?.success !== true) throw new AccountError('退出未完成，请刷新登录状态后重试。');
