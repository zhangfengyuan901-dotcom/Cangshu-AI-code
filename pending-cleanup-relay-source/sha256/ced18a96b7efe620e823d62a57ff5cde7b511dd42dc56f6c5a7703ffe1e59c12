  return value?.intent === ACTIVATION_INTENT && Number.isSafeInteger(value.userID) && value.userID > 0 && UUID.test(value.requestId || '') && Number.isFinite(value.startedAt) && value.startedAt > 0 && Number.isSafeInteger(value.keyId) && value.keyId > 0 && Number.isSafeInteger(value.createdAt) && value.createdAt > 0 && typeof value.name === 'string' && value.name.length > 0 && value.name.length <= 100 && !/[\u0000-\u001f]/.test(value.name) && hasOwn(GROUPS, value.group);
}
// A selection records its own timestamp. It does not pretend an existing Key
// was just created. Only the exact row chosen by the user can be activated.
export function findSelectedToken(operation, rows) {
  if (!selectedOperation(operation)) return null;
  const matches = (Array.isArray(rows) ? rows : []).map(tokenMetadata).filter((row) => row.id === operation.keyId && row.name === operation.name && row.group === operation.group && row.created_time === operation.createdAt && row.status === 1);
  return matches.length === 1 ? matches[0] : null;
}
export function selectedKeyOperation(row, userID, requestId, startedAt = Date.now()) {
  const value = { intent: ACTIVATION_INTENT, userID, keyId: row?.id, name: row?.name, group: row?.group, createdAt: row?.created_time, requestId, startedAt };
  if (!findSelectedToken(value, [row])) throw new AccountError('请选择可用的图片、视频、工具或对话 Key。');
  return value;
}

// Compatibility helper for earlier callers. The account UI uses the explicit
// selected connector below and never activates a Key as a side effect of creation.
export function createCreatedKeyConnector(options) { return createNativeKeyConnector({ ...options, matches: (operation, row) => findCreatedToken(operation, [row]) }); }
export function createSelectedKeyConnector(options) { return createNativeKeyConnector({ ...options, matches: (operation, row) => findSelectedToken(operation, [row]) }); }

// New API reveals its raw 48-character key; the native boundary requires the
// canonical API credential. Accept an existing prefix without adding it twice.
function nativeKey(value) {
  if (typeof value === 'string' && /^sk-[a-zA-Z0-9]{20,128}$/.test(value)) return value;
  if (typeof value === 'string' && /^[a-zA-Z0-9]{48}$/.test(value)) return `sk-${value}`;
  throw new AccountError('应用连接暂不可用。');
}
function nativeFailure(result) {
  const allowed = ['KEY_INVALID', 'KEY_FORBIDDEN', 'KEY_STORAGE_UNAVAILABLE', 'ACCOUNT_MISMATCH', 'CONNECT_FAILED', 'ACCOUNT_CHANGED'];
  return { ok: false, code: allowed.includes(result?.code) ? result.code : 'CONNECT_FAILED', ...(Number.isInteger(result?.httpStatus) && result.httpStatus >= 100 && result.httpStatus <= 599 ? { httpStatus: result.httpStatus } : {}) };
}

// Complete keys are held briefly here, never in DOM, storage or errors.
function createNativeKeyConnector({ request, identity, bridge, matches, context = async () => ({ ok: true }), isCurrent = () => true, onFailure = () => {}, now = Date.now }) {
  const inFlight = new Map(), completed = new Map(), selections = new Map();
  let scope = '', retryAt = 0;
  return function connect(operation, row) {
    const account = identity(), native = bridge();
    if (!native?.connectCreatedKey) return Promise.resolve({ ok: false, code: 'WEB_ONLY' });
    if (!UUID.test(operation?.requestId || '') || !matches(operation, row) || Number(account?.userId) !== operation.userID || !isCurrent(operation)) return Promise.resolve({ ok: false, code: 'ACCOUNT_CHANGED' });
    if (scope !== account.value) { scope = account.value; retryAt = 0; completed.clear(); selections.clear(); }
    const id = `${account.value}:${operation.requestId}`;
    const selection = JSON.stringify([operation.userID, row.id, row.group, row.name, row.created_time]);
    if (selections.has(id) && selections.get(id) !== selection) return Promise.resolve({ ok: false, code: 'ACCOUNT_CHANGED' });
    if (inFlight.has(id)) return inFlight.get(id);
    if (completed.has(id)) return Promise.resolve({ ...completed.get(id) });
    const remaining = Math.max(retryAt, Math.min(Number(operation.retryAt) || 0, now() + MAX_RETRY_MS)) - now();
    if (remaining > 0) return Promise.resolve(limited(remaining));
    const unchanged = () => identity()?.value === account.value && Number(identity()?.userId) === operation.userID && isCurrent(operation);
    const coolDown = (delay) => { const result = limited(delay); retryAt = now() + result.retryAfterMs; return result; };
    const run = async () => {
      let data, payload;
      try {
        const ready = await context();
        if (!unchanged()) return { ok: false, code: 'ACCOUNT_CHANGED' };
        if (!ready?.ok) { if (ready?.code === 'RATE_LIMITED' || ready?.httpStatus === 429) return coolDown(ready.retryAfterMs); throw new AccountError('应用连接暂不可用。'); }
        data = (await request(`/api/token/${row.id}/key`, { method: 'POST' })).data;
        if (!unchanged()) return { ok: false, code: 'ACCOUNT_CHANGED' };
        payload = { keyId: row.id, userId: operation.userID, group: row.group, name: row.name, createdAt: row.created_time, key: nativeKey(data?.key), requestId: operation.requestId };
        const result = await native.connectCreatedKey(payload);
        if (!unchanged()) return { ok: false, code: 'ACCOUNT_CHANGED' };
        if (result?.ok === true && ['CONNECTED', 'SAVED_CHECK_PENDING'].includes(result.code)) {
          const clean = { ok: true, code: result.code, connected: result.code === 'CONNECTED', ...(result.code === 'SAVED_CHECK_PENDING' && result.httpStatus === 429 ? { httpStatus: 429, retryAfterMs: boundedRetryMs(result.retryAfterMs) } : {}) };
