        if (result?.code === 'RATE_LIMITED' || result?.httpStatus === 429) return coolDown(result.retryAfterMs);
        const failure = nativeFailure(result);
        if (failure.code !== 'ACCOUNT_CHANGED') onFailure({ code: 'ACCOUNT_KEY_IMPORT_FAILED', ...(failure.httpStatus ? { httpStatus: failure.httpStatus } : {}) });
        return failure;
      } catch (error) {
        if (!unchanged() || error?.code === 'ACCOUNT_CHANGED') return { ok: false, code: 'ACCOUNT_CHANGED' };
        if (error?.status === 429 || error?.httpStatus === 429 || error?.code === 'RATE_LIMITED') return coolDown(error.retryAfterMs);
        const failure = nativeFailure({ code: 'CONNECT_FAILED', httpStatus: error?.status });
        onFailure({ code: 'ACCOUNT_KEY_IMPORT_FAILED', ...(failure.httpStatus ? { httpStatus: failure.httpStatus } : {}) });
