      const response = await fetchImpl(path, { ...options, credentials: 'same-origin', cache: 'no-store', redirect: 'error', signal: controller.signal });
      let data;
      try { data = await response.json(); } catch { if (response.ok) throw new AccountError('服务响应未完成，请刷新核对。', 'NETWORK'); }
      return { response, data };
    } catch { throw new AccountError('网络请求未完成，请刷新核对；写入操作不会自动重试。', 'NETWORK'); }
    finally { clearTimeout(timer); }
