      } finally { if (payload) payload.key = ''; if (data && typeof data === 'object') data.key = ''; }
    };
    selections.set(id, selection);
    if (selections.size > 128) selections.delete(selections.keys().next().value);
    const promise = run().finally(() => inFlight.delete(id));
    inFlight.set(id, promise); return promise;
  };
}

export function operationStore(storage) {
  const key = (kind, userID) => `hamster-account-lite:pending-${kind}:${Number(userID)}`;
  const metadata = (userID, fields) => ({ userID, startedAt: Number(fields.startedAt) || Date.now(), ...(typeof fields.order === 'string' ? { order: fields.order } : {}), ...(typeof fields.name === 'string' ? { name: fields.name, group: fields.group } : {}), ...(UUID.test(fields.requestId || '') ? { requestId: fields.requestId } : {}), ...(Number.isInteger(fields.keyId) && fields.keyId > 0 ? { keyId: fields.keyId } : {}), ...(Number.isInteger(fields.createdAt) && fields.createdAt > 0 ? { createdAt: fields.createdAt } : {}), ...(fields.intent === ACTIVATION_INTENT ? { intent: ACTIVATION_INTENT } : {}), ...(Number.isFinite(fields.retryAt) && fields.retryAt > 0 ? { retryAt: Math.min(fields.retryAt, Date.now() + MAX_RETRY_MS) } : {}) });
  const activationKind = (kind, value) => !kind.startsWith('activate-') || selectedOperation(value) && kind === `activate-${value.group}`;
  return {
    read(kind, userID) {
      try { const value = JSON.parse(storage.getItem(key(kind, userID)) || 'null'); return value?.userID === userID && Number.isFinite(value.startedAt) && activationKind(kind, value) ? metadata(userID, value) : null; }
      catch { return null; }
    },
    save(kind, userID, fields) {
      if (!Number.isInteger(userID) || userID <= 0) throw new AccountError('账户身份无效。');
      // Whitelist only recovery metadata. No credentials, key material or signed forms.
      const value = metadata(userID, fields);
      if (!activationKind(kind, value)) throw new AccountError('激活选择已失效，请重新选择 Key。');
      try { storage.setItem(key(kind, userID), JSON.stringify(value)); }
      catch { throw new AccountError('浏览器无法保存操作核对状态，请允许此站点使用本机存储后再试。'); }
      return value;
    },
    remove(kind, userID) { try { storage.removeItem(key(kind, userID)); } catch { throw new AccountError('操作核对状态暂时无法更新，请稍后刷新。'); } },
  };
}

export class AccountError extends Error {
  constructor(message, code = '', status = 0, retryDelay) { super(message); this.code = code; this.status = status; if (status === 429) this.retryAfterMs = boundedRetryMs(retryDelay); }
}
function rateLimitError(response) { return new AccountError('请求暂受限，请等待冷却后刷新；已开通的 Key 无需重新创建。', 'RATE_LIMITED', 429, retryAfterMs(response.headers?.get?.('Retry-After'))); }
export function adminHome(user) { return Number.isInteger(user?.role) && user.role >= 100 ? '/line-management' : Number.isInteger(user?.role) && user.role >= 10 ? '/channels' : ''; }

export function cnyFromQuota(quota, status) {
  const unit = Number(status?.quota_per_unit), rate = Number(status?.usd_exchange_rate);
  if (!Number.isFinite(Number(quota)) || !(unit > 0) || !Number.isFinite(unit) || !(rate > 0) || !Number.isFinite(rate)) return null;
  return Number(quota) / unit * rate;
}

export function paymentForm(response, origin, { amount, method, userID }) {
  const url = new URL(response?.url || '', origin);
  if (url.origin !== origin || url.pathname !== '/pay/lanjing/epay/submit.php' || url.search || url.hash || url.username || url.password) throw new AccountError('支付地址校验失败，请刷新订单核对。');
  const fields = response?.data;
  if (!fields || typeof fields !== 'object' || Array.isArray(fields)) throw new AccountError('支付参数无效。');
  const allowed = new Set(['pid', 'type', 'out_trade_no', 'notify_url', 'return_url', 'name', 'money', 'sign', 'sign_type', 'device', 'clientip', 'param']);
  for (const [key, value] of Object.entries(fields)) {
    if (!allowed.has(key) || typeof value !== 'string' || value.length > 2048) throw new AccountError('支付参数校验失败。');
  }
  const notify = new URL(fields.notify_url || '', origin), returned = new URL(fields.return_url || '', origin);
  if (!AMOUNTS.includes(amount) || !['alipay', 'wxpay'].includes(method) || fields.type !== method || Number(fields.money) !== amount || !new RegExp(`^USR${Number(userID)}NO[A-Za-z0-9]+$`).test(fields.out_trade_no || '') || fields.sign_type?.toUpperCase() !== 'MD5' || !/^[a-f\d]{32}$/i.test(fields.sign || '') || notify.href !== `${origin}/api/user/epay/notify` || returned.origin !== origin || returned.username || returned.password || !fields.pid) throw new AccountError('订单与当前账户不匹配，请刷新订单核对。');
  return { action: url.href, fields: { ...fields } };
}

export function keyPayload(name, group, days, quotaCny, status, usableGroups) {
  const cleanName = String(name).trim();
  if (!cleanName || cleanName.length > 50 || !hasOwn(GROUPS, group) || !hasOwn(usableGroups || {}, group) || ![7, 30, -1].includes(Number(days))) throw new AccountError('请检查名称、用途与有效期。');
  const unlimited = quotaCny === '' || quotaCny == null;
  const unit = Number(status?.quota_per_unit), rate = Number(status?.usd_exchange_rate);
  const remain = unlimited ? 0 : Math.round(Number(quotaCny) / rate * unit);
  if (!unlimited && (!(Number(quotaCny) > 0) || !(unit > 0) || !(rate > 0) || !Number.isSafeInteger(remain) || remain <= 0)) throw new AccountError('额度上限无效，或金额配置尚未加载。');
  return { name: cleanName, group, expired_time: Number(days) === -1 ? -1 : Math.floor(Date.now() / 1000) + Number(days) * 86400, remain_quota: remain, unlimited_quota: unlimited, model_limits_enabled: false, model_limits: '', allow_ips: '', auto_groups: [], cross_group_retry: false };
}

export function createAccountClient({ fetchImpl = globalThis.fetch.bind(globalThis), onChange = () => {}, locks = globalThis.navigator?.locks } = {}) {
  let bundle = null, epoch = 0, refreshing = null, refreshingEpoch = -1;
  const current = () => bundle;
