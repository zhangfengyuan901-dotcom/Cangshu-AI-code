    if (!bundle || bundle.access_expires_at < Date.now() / 1000 + 20) await refresh();
    const ticket = epoch, sid = bundle.session.sid, userID = bundle.user.id;
    const { response, data } = await wire(path, { method, headers: { Authorization: `Bearer ${bundle.access_token}`, ...(body === undefined ? {} : { 'Content-Type': 'application/json' }) }, ...(body === undefined ? {} : { body: JSON.stringify(body) }) });
    if (ticket !== epoch || bundle?.session.sid !== sid || bundle?.user.id !== userID) throw new AccountError('账户已改变，本次结果已丢弃。', 'ACCOUNT_CHANGED');
    if (response.status === 429) throw rateLimitError(response);
    if (response.status === 401) {
      if (method === 'GET' && retry) { await refresh(); return request(path, { method, retry: false }); }
      throw new AccountError('登录已过期，请刷新并核对操作结果。', 'LOGIN_REQUIRED', 401);
    }
    if (!response.ok || !(data?.success === true || data?.message === 'success')) throw new AccountError(method === 'GET' ? '读取失败，请稍后刷新。' : '操作未确认完成，请先刷新记录核对，再决定是否重试。', data?.code || '', response.status);
    return data;
  }
