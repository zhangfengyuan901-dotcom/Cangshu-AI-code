import { hasOwn } from './compat.mjs';
// Account credentials stay in memory. Relay API keys are never login credentials.
export const GROUPS = Object.freeze({
  'image-standard': '图片生成', 'video-standard': '视频生成',
  'tool-standard': '数字人与工具', 'chat-standard': 'AI 对话',
});
export const AMOUNTS = Object.freeze([50, 100, 200]);
const MAX_RETRY_MS = 3600000, DEFAULT_RETRY_MS = 60000;
export function retryAfterMs(value, now = Date.now()) {
  const seconds = typeof value === 'string' && /^\d+(?:\.\d+)?$/.test(value.trim()) ? Number(value.trim()) : NaN;
  const delay = Number.isFinite(seconds) ? seconds * 1000 : typeof value === 'string' && value.trim() ? Date.parse(value) - now : NaN;
  return Math.min(MAX_RETRY_MS, Math.max(1000, Number.isFinite(delay) ? delay : DEFAULT_RETRY_MS));
}
const boundedRetryMs = (value) => Math.min(MAX_RETRY_MS, Math.max(1000, typeof value === 'number' && Number.isFinite(value) ? value : DEFAULT_RETRY_MS));
const limited = (delay) => ({ ok: false, code: 'RATE_LIMITED', httpStatus: 429, retryAfterMs: boundedRetryMs(delay) });

export function tokenMetadata(row) {
  return Object.fromEntries(['id', 'name', 'group', 'status', 'expired_time', 'remain_quota', 'unlimited_quota', 'created_time'].map((key) => [key, row?.[key]]));
}

const UUID = /^[a-f\d]{8}-[a-f\d]{4}-4[a-f\d]{3}-[89ab][a-f\d]{3}-[a-f\d]{12}$/i;
export function findCreatedToken(operation, rows) {
  if (!operation || !Number.isInteger(operation.userID) || operation.userID <= 0 || typeof operation.name !== 'string' || !hasOwn(GROUPS, operation.group) || !Number.isFinite(operation.startedAt)) return null;
  const matches = (Array.isArray(rows) ? rows : []).map(tokenMetadata).filter((row) => Number.isInteger(row.id) && row.id > 0 && row.name === operation.name && row.group === operation.group && Number.isInteger(row.created_time) && row.created_time >= Math.floor(operation.startedAt / 1000) - 2 && (!operation.keyId || operation.keyId === row.id) && (!operation.createdAt || operation.createdAt === row.created_time));
  return matches.length === 1 ? matches[0] : null;
}

const ACTIVATION_INTENT = 'activate-selected-key-v1';
