  async function refresh() {
    if (refreshing) {
      if (refreshingEpoch === epoch) return refreshing;
      const waitingEpoch = epoch;
      // A restored page must not reuse the pre-navigation refresh. Its old
      // callers still receive ACCOUNT_CHANGED; only this new read may proceed.
      try { await refreshing; } catch { /* Drain the invalidated read. */ }
      if (waitingEpoch !== epoch) throw new AccountError('账户已改变，请刷新。', 'ACCOUNT_CHANGED');
      return refresh();
    }
    const ticket = epoch;
    refreshingEpoch = ticket;
    const run = async () => {
      const { response, data } = await wire('/api/user/auth/refresh', { method: 'POST', headers: bundle?.session?.sid ? { 'X-Auth-Session': bundle.session.sid } : {} });
      if (ticket !== epoch) throw new AccountError('账户已改变，请刷新。', 'ACCOUNT_CHANGED');
      if (response.status === 429) throw rateLimitError(response);
      const next = data?.data;
      if (response.status === 401 || response.status === 409) { clear(); throw new AccountError('请登录账户后继续。', 'LOGIN_REQUIRED', response.status); }
