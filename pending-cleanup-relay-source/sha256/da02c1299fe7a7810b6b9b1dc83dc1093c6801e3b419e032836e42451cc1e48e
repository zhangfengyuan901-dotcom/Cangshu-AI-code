import assert from 'node:assert/strict';
import test from 'node:test';
import { serveDownload } from '../website/src/download-handler.js';
import { routeWebsiteRequest } from '../website/src/download-gateway.js';
import { readFileSync } from 'node:fs';

const worker = { fetch: (request, env) => routeWebsiteRequest(request, env, normalized => serveDownload(normalized, env)) };

const url = 'https://hamsterai.cc/download/HamsterAI-Portable-1.7.77.exe';
const releaseObject = 'releases/1.7.77/HamsterAI-Portable-1.7.77.exe';

function environment() {
  let getOptions;
  const reads = [];
  const metadata = {
    size: 4,
    httpEtag: '"test"',
    uploaded: new Date('2026-10-18T10:00:00Z'),
    writeHttpMetadata(headers) { headers.set('content-type', 'application/octet-stream'); },
  };
  return {
    getOptions: () => getOptions,
    reads,
    DOWNLOADS: {
      async head(key) { reads.push(key); return metadata; },
      async get(key, options) {
        reads.push(key);
        getOptions = options;
        const conditional = options.onlyIf;
        if (conditional?.get('if-none-match')?.replace(/^W\//, '') === metadata.httpEtag || conditional?.get('if-match') === '"obsolete"') return metadata;
        if (Date.parse(conditional?.get('if-modified-since') || '') >= metadata.uploaded.getTime() || Date.parse(conditional?.get('if-unmodified-since') || '') < metadata.uploaded.getTime()) return metadata;
        const partial = Boolean(options.range);
        const bytes = new Uint8Array([1, 2, 3, 4]);
        return {
          ...metadata,
          ...(partial ? { range: options.range } : {}),
          body: partial ? bytes.slice(options.range.offset, options.range.offset + options.range.length) : bytes,
        };
      },
    },
    ASSETS: { fetch() { throw new Error('Download must not reach static assets'); } },
  };
}

test('full download responds 200 without a Content-Range header', async () => {
  const env = environment();
  const response = await worker.fetch(new Request(url), env);
  assert.equal(env.getOptions().range, undefined);
  assert.deepEqual(env.reads, [releaseObject]);
  assert.equal(response.status, 200);
  assert.equal(response.headers.get('content-range'), null);
  assert.equal(response.headers.get('content-length'), '4');
  assert.match(response.headers.get('content-disposition'), /filename="HamsterAI-Portable-1\.7\.77\.exe"/);
  assert.ok(response.headers.get('content-disposition').includes(encodeURIComponent('仓鼠AI正式版-1.7.77.exe')));
  assert.deepEqual(new Uint8Array(await response.arrayBuffer()), new Uint8Array([1, 2, 3, 4]));
});

test('explicit range request responds 206 with matching byte range', async () => {
  const env = environment();
  const response = await worker.fetch(new Request(url, { headers: { Range: 'bytes=1-2' } }), env);
  assert.equal(response.status, 206);
  assert.equal(response.headers.get('content-range'), 'bytes 1-2/4');
  assert.equal(response.headers.get('content-length'), '2');
  assert.deepEqual(new Uint8Array(await response.arrayBuffer()), new Uint8Array([2, 3]));
});

test('HEAD returns complete file metadata', async () => {
  const env = environment();
  const response = await worker.fetch(new Request(url, { method: 'HEAD' }), env);
  assert.equal(response.status, 200);
  assert.equal(response.headers.get('content-length'), '4');
  assert.equal(response.headers.get('cloudflare-cdn-cache-control'), 'no-store');
  assert.deepEqual(env.reads, [releaseObject]);
  assert.equal((await response.arrayBuffer()).byteLength, 0);
});

test('conditional GET distinguishes unchanged 304 from failed preconditions 412', async () => {
  for (const [headers, expected] of [
    [{ 'If-None-Match': '"test"' }, 304],
    [{ 'If-None-Match': 'W/"test"' }, 304],
    [{ 'If-None-Match': '*' }, 304],
    [{ 'If-Modified-Since': 'Sun, 18 Oct 2026 10:00:00 GMT' }, 304],
    [{ 'If-Match': '"obsolete"' }, 412],
    [{ 'If-Match': 'W/"test"' }, 412],
    [{ 'If-Unmodified-Since': 'Sat, 17 Oct 2026 10:00:00 GMT' }, 412],
  ]) {
    const response = await worker.fetch(new Request(url, { headers }), environment());
    assert.equal(response.status, expected, JSON.stringify(headers));
    assert.equal((await response.arrayBuffer()).byteLength, 0);
    assert.equal(response.headers.get('content-length'), null);
    if (expected === 412) assert.equal(response.headers.get('cache-control'), 'no-store');
  }
});

test('ETag conditionals take precedence over date conditionals and Range', async () => {
  const env = environment();
  const response = await worker.fetch(new Request(url, { headers: { 'If-None-Match': '"new"', 'If-Modified-Since': 'Sun, 18 Oct 2026 10:00:00 GMT' } }), env);
  assert.equal(response.status, 200);
  assert.equal(env.getOptions().onlyIf.get('if-none-match'), '"new"');
  assert.equal(env.getOptions().onlyIf.get('if-modified-since'), null);
  assert.deepEqual([...new Uint8Array(await response.arrayBuffer())], [1, 2, 3, 4]);
  const notModified = await worker.fetch(new Request(url, { headers: { Range: 'bytes=1-2', 'If-None-Match': '"test"' } }), environment());
  assert.equal(notModified.status, 304);
  const matchedEnv = environment();
  const matched = await worker.fetch(new Request(url, { headers: { 'If-Match': '"test"', 'If-Unmodified-Since': 'Sat, 17 Oct 2026 10:00:00 GMT' } }), matchedEnv);
  assert.equal(matched.status, 200);
  assert.equal(matchedEnv.getOptions().onlyIf.get('if-match'), '"test"');
  assert.equal(matchedEnv.getOptions().onlyIf.get('if-unmodified-since'), null);
});

test('fallback supports byte intervals, suffixes, open intervals and clamped end positions', async () => {
  for (const [range, contentRange, expected] of [
    ['bytes=0-0', 'bytes 0-0/4', [1]],
    ['bytes=1-2', 'bytes 1-2/4', [2, 3]],
    ['bytes=2-', 'bytes 2-3/4', [3, 4]],
    ['bytes=-2', 'bytes 2-3/4', [3, 4]],
    ['bytes=2-99', 'bytes 2-3/4', [3, 4]],
    ['bytes=-99', 'bytes 0-3/4', [1, 2, 3, 4]],
  ]) {
    const env = environment(), response = await worker.fetch(new Request(url, { headers: { Range: range } }), env);
    assert.equal(response.status, 206, range);
    assert.equal(response.headers.get('content-range'), contentRange);
    assert.equal(response.headers.get('content-length'), String(expected.length));
    assert.deepEqual([...new Uint8Array(await response.arrayBuffer())], expected);
    assert.ok(env.getOptions().range);
    assert.equal(env.getOptions().onlyIf.get('if-match'), '"test"');
  }
});

test('unsatisfiable ranges return 416 without reading a body; malformed or multiple ranges are ignored', async () => {
  for (const range of ['bytes=', 'bytes=4-', 'bytes=3-2', 'bytes=-0']) {
    const env = environment(), response = await worker.fetch(new Request(url, { headers: { Range: range } }), env);
    assert.equal(response.status, 416, range);
    assert.equal(response.headers.get('content-range'), 'bytes */4');
    assert.equal(response.headers.get('cache-control'), 'no-store');
    assert.equal((await response.arrayBuffer()).byteLength, 0);
    assert.equal(env.getOptions(), undefined);
  }
  for (const range of ['items=1-2', 'bytes=invalid', 'bytes=0-0,2-2', 'bytes=9007199254740992-']) {
    const response = await worker.fetch(new Request(url, { headers: { Range: range } }), environment());
    assert.equal(response.status, 200, range);
    assert.equal(response.headers.get('content-range'), null);
    assert.deepEqual([...new Uint8Array(await response.arrayBuffer())], [1, 2, 3, 4]);
  }
});

test('If-Range permits only matching strong ETag or modification date; mismatch sends the entire file', async () => {
  for (const [ifRange, expected] of [['"test"', 206], ['Sun, 18 Oct 2026 10:00:00 GMT', 206], ['"old"', 200], ['W/"test"', 200], ['Sat, 17 Oct 2026 10:00:00 GMT', 200], ['invalid', 200]]) {
    const response = await worker.fetch(new Request(url, { headers: { Range: 'bytes=1-2', 'If-Range': ifRange } }), environment());
    assert.equal(response.status, expected, ifRange);
    assert.deepEqual([...new Uint8Array(await response.arrayBuffer())], expected === 206 ? [2, 3] : [1, 2, 3, 4]);
  }
});

test('HEAD ignores Range and never advertises its empty body as a cacheable complete GET', async () => {
  const env = environment(), response = await worker.fetch(new Request(url, { method: 'HEAD', headers: { Range: 'bytes=1-2' } }), env);
  assert.equal(response.status, 200);
  assert.equal(response.headers.get('content-length'), '4');
  assert.equal(response.headers.get('content-range'), null);
  assert.equal(response.headers.get('cloudflare-cdn-cache-control'), 'no-store');
  assert.equal((await response.arrayBuffer()).byteLength, 0);
  assert.equal(env.getOptions(), undefined);
  assert.deepEqual([...new Uint8Array(await (await worker.fetch(new Request(url), env)).arrayBuffer())], [1, 2, 3, 4]);
});

test('gateway normalizes only released download queries before cached dispatch and preserves Range', async () => {
  let dispatched;
  const request = new Request(url + '?tracking=abc&cache=1', { headers: { Range: 'bytes=1-2', 'If-Range': '"test"' } });
  const response = await routeWebsiteRequest(request, environment(), normalized => { dispatched = normalized; return new Response('sent'); });
  assert.equal(await response.text(), 'sent');
  assert.equal(dispatched.url, url);
  assert.equal(dispatched.headers.get('range'), 'bytes=1-2');
  assert.equal(dispatched.headers.get('if-range'), '"test"');
  assert.equal(request.url, url + '?tracking=abc&cache=1');
});

