function cachedResponse(status, overrides = {}, onCancel = () => {}) {
  const headers = {
    ETag: '"test"',
    'Last-Modified': 'Sun, 18 Oct 2026 10:00:00 GMT',
    'Cache-Control': 'public, max-age=31536000, immutable',
    'CF-Cache-Status': 'HIT',
    ...overrides,
  };
  const body = status === 304 ? null : new ReadableStream({ cancel: onCancel });
  return new Response(body, { status, headers });
}

test('gateway enforces strong preconditions even when a cache HIT bypasses the source handler', async () => {
  for (const [headers, expected] of [
    [{ 'If-Match': '"old-release"' }, 412],
    [{ 'If-Match': 'W/"test"' }, 412],
    [{ 'If-Unmodified-Since': 'Sat, 17 Oct 2026 10:00:00 GMT' }, 412],
    [{ 'If-Match': '"test"', 'If-Unmodified-Since': 'Sat, 17 Oct 2026 10:00:00 GMT' }, 200],
    [{ 'If-Match': '*' }, 200],
  ]) {
    let cancelled = false;
    const source = cachedResponse(200, { 'Content-Length': '4' }, () => { cancelled = true; });
    const response = await routeWebsiteRequest(new Request(url, { headers }), {}, () => source);
    assert.equal(response.status, expected, JSON.stringify(headers));
    if (expected === 412) {
      assert.equal(cancelled, true);
      assert.equal(response.headers.get('cache-control'), 'no-store');
      assert.equal(response.headers.get('cloudflare-cdn-cache-control'), 'no-store');
      assert.equal(response.headers.get('content-length'), null);
      assert.equal((await response.arrayBuffer()).byteLength, 0);
    } else {
      assert.equal(response, source);
      await response.body.cancel();
    }
  }
});

test('gateway preserves valid 304 hits and gives failed strong conditions precedence over 304', async () => {
  for (const [headers, expected] of [
    [{ 'If-None-Match': '"test"' }, 304],
    [{ 'If-Match': '"test"', 'If-None-Match': '"test"' }, 304],
    [{ 'If-Match': '"old-release"', 'If-None-Match': '"test"' }, 412],
    [{ 'If-Unmodified-Since': 'Sat, 17 Oct 2026 10:00:00 GMT', 'If-None-Match': '"test"' }, 412],
  ]) {
    const source = cachedResponse(304);
    const response = await routeWebsiteRequest(new Request(url, { headers }), {}, () => source);
    assert.equal(response.status, expected, JSON.stringify(headers));
    assert.equal((await response.arrayBuffer()).byteLength, 0);
    if (expected === 304) assert.equal(response, source);
  }
});

test('gateway removes cached partial bodies and range headers when 304 or 412 takes precedence', async () => {
  for (const [headers, expected] of [[{ 'If-Match': '"old-release"' }, 412], [{ 'If-None-Match': '"test"' }, 304]]) {
    let cancelled = false;
    const source = cachedResponse(206, { 'Content-Range': 'bytes 1-2/4', 'Content-Length': '2' }, () => { cancelled = true; });
    const response = await routeWebsiteRequest(new Request(url, { headers: { Range: 'bytes=1-2', ...headers } }), {}, () => source);
    assert.equal(response.status, expected);
    assert.equal(cancelled, true);
    assert.equal(response.headers.get('content-range'), null);
    assert.equal(response.headers.get('content-length'), null);
    assert.equal((await response.arrayBuffer()).byteLength, 0);
  }
});

test('gateway normalizes cached 416 metadata only after preconditions are evaluated', async () => {
  for (const [extra, expected] of [[{}, 416], [{ 'If-Match': '"test"' }, 416], [{ 'If-Match': '"old-release"' }, 412], [{ 'If-None-Match': '"test"' }, 304]]) {
    let cancelled = false;
    const source = cachedResponse(416, { 'Content-Range': 'bytes 0-0/4', 'Content-Length': '0' }, () => { cancelled = true; });
    const response = await routeWebsiteRequest(new Request(url, { headers: { Range: 'bytes=4-', ...extra } }), {}, () => source);
    assert.equal(response.status, expected, JSON.stringify(extra));
    assert.equal(cancelled, true);
    assert.equal((await response.arrayBuffer()).byteLength, 0);
    if (expected === 416) {
      assert.equal(response.headers.get('content-range'), 'bytes */4');
      assert.equal(response.headers.get('content-length'), '0');
      assert.equal(response.headers.get('cache-control'), 'no-store');
    } else {
      assert.equal(response.headers.get('content-range'), null);
      assert.equal(response.headers.get('content-length'), null);
    }
  }
  const response = await worker.fetch(new Request(url, { headers: { Range: 'bytes=4-', 'If-Match': '"test"' } }), environment());
  assert.equal(response.status, 416);
  assert.equal(response.headers.get('etag'), '"test"');
});

test('gateway does not turn missing objects or other errors into precondition failures', async () => {
  const source = new Response('File not found', { status: 404, headers: { 'Cache-Control': 'no-store' } });
  const response = await routeWebsiteRequest(new Request(url, { headers: { 'If-Match': '"old-release"' } }), {}, () => source);
  assert.equal(response, source);
  assert.equal(response.status, 404);
});

test('missing or temporarily unavailable objects have non-cacheable fixed errors', async () => {
  for (const [implementation, expected] of [[async () => null, 404], [async () => { throw new Error('private storage diagnostic'); }, 503]]) {
    const env = environment();
    env.DOWNLOADS.get = implementation;
    const response = await worker.fetch(new Request(url), env);
    assert.equal(response.status, expected);
    assert.equal(response.headers.get('cache-control'), 'no-store');
    assert.doesNotMatch(await response.text(), /private|storage|diagnostic/);
  }
});

