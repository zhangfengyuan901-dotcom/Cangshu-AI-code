  const paths = [];
  const env = { ASSETS: { fetch: request => { paths.push(request.url); return new Response('asset'); } } };
  const request = new Request('https://hamsterai.cc/tutorials/?page=1');
  assert.equal(await (await routeWebsiteRequest(request, env, () => assert.fail('must not dispatch download'))).text(), 'asset');
  assert.deepEqual(paths, [request.url]);
