import ast
import copy
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import tempfile
import types

HERE=Path(__file__).resolve().parent
source=HERE/'release71-apply.py'
tree=ast.parse(source.read_text())
selected=[node for node in tree.body if isinstance(node,ast.FunctionDef) or isinstance(node,ast.Assign) and any(isinstance(target,ast.Name) and target.id in ('NEW_TABLES','NEW_TOPUP_COLUMNS','REVIEWED_REVERSE','STOP_GRACE_SECONDS') for target in node.targets)]

class Stage:
    OLD_APP_IMAGE='old-app'
    OLD_BRIDGE_IMAGE='old-bridge'
    COMPOSE=['docker','compose']
    @staticmethod
    def hashed(value):return hashlib.sha256(json.dumps(value,sort_keys=True,separators=(',',':')).encode()).hexdigest()
    @staticmethod
    def require(value,code):
        if not value:
            raise RuntimeError(code)

stage=Stage()
ns={'stage':stage,'json':json,'re':re,'os':os,'Path':Path,'signal':signal}
exec(compile(ast.Module(body=selected,type_ignores=[]),str(source),'exec'),ns)
checks=[]

def check(name,operation,error=None):
    try:
        operation()
    except RuntimeError as failure:
        if error is None or str(failure)!=error:
            raise
    else:
        if error is not None:
            raise AssertionError(name+' did not reject')
    checks.append(name)

base={'active_nonunknown_tasks':0,'active_nonunknown_settlements':0,'active_llm':0,'recent_pending_recharges':0,'active_reverse':1,'retained_unknown_tasks':2,'retained_unknown_digest':'same','recent_tasks':5,'recent_settlements':4,'recent_llm':3}
