ns['subprocess']=types.SimpleNamespace(Popen=Stop,DEVNULL=-3,TimeoutExpired=TimeoutError)
ns['time']=types.SimpleNamespace(sleep=lambda duration:None)
ns['process_identity']=lambda *args:copy.deepcopy(identity)
ns['deliver_verified_term']=lambda value:True
check('recreate_owns_normal_120_second_docker_lifecycle',lambda:ns['recreate_pair'](info,info,('old-app',),('old-app',),'new-app','new-app'))
assert commands==[['docker','compose','up','-d','--no-deps','--no-build','--pull','never','--timeout','120','new-api','lanjing-bridge']]
delivered=[]
ns['deliver_verified_term']=lambda value:delivered.append(value) or True
ns['recreate_pair'](info,info,('old-app',),('old-app',),'old-app','old-app')
assert delivered==[]
checks.append('already_desired_running_images_are_never_signaled')
runtime={'Config':{'Image':'old','Hostname':'old-host','Env':['B=2','A=1'],'Labels':{'com.docker.compose.image':'old-image'},'User':'node','Cmd':['node','server.mjs']},'HostConfig':{'Binds':['/a:/b:ro'],'RestartPolicy':{'Name':'unless-stopped'}},'Mounts':[{'Name':'generated','Source':'/a','Destination':'/b','RW':False}],'NetworkSettings':{'Networks':{'network':{}}}}
