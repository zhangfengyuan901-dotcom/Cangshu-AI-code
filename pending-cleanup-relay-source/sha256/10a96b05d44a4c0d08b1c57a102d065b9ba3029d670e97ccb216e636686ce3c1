    check(field+'_blocks',guard,'RECENT_OR_ACTIVE_NONUNKNOWN_WORK');base[field]=original
check('unreviewed_reverse_blocks',lambda:ns['assert_no_new_work'](base),'RECENT_OR_ACTIVE_NONUNKNOWN_WORK')
for field,value in (('active_count',2),('eligible_count',0),('digest','changed')):
    original=reverse[field];reverse[field]=value
    check('reverse_'+field+'_change_blocks',guard,'RETAINED_REVERSE_STATE_CHANGED');reverse[field]=original
base['active_reverse']=2
check('new_reverse_during_probe_blocks',guard,'RETAINED_REVERSE_STATE_CHANGED');base['active_reverse']=1
check('old_unknown_change_blocks',lambda:ns['assert_no_new_work']({**base,'retained_unknown_digest':'changed'},ns['REVIEWED_REVERSE']),'RETAINED_UNKNOWN_STATE_CHANGED')

with tempfile.TemporaryDirectory() as temporary:
    stage.PRIVATE=Path(temporary)
    (stage.PRIVATE/'apply-attempt-1.json').write_text('{}')
    (stage.PRIVATE/'apply-attempt-2.json').write_text('{}')
    (stage.PRIVATE/'apply-attempt-3.json').write_text('{}')
    (stage.PRIVATE/'apply-reservations-1.json').write_text('{}')
    (stage.PRIVATE/'apply-reservations-2.json').write_text('{}')
    (stage.PRIVATE/'apply-failure-1.json').write_text(json.dumps({'code':'RECENT_OR_ACTIVE_NONUNKNOWN_WORK','financial_restore':False,'image_only_rollback':True}))
    (stage.PRIVATE/'apply-failure-2.json').write_text(json.dumps({'code':'PAIR_RUNTIME_BINDINGS_CHANGED','financial_restore':False,'image_only_rollback':True}))
    failure=stage.PRIVATE/'apply-failure-3.json'
    reviewed={'code':'PAIR_RUNTIME_BINDINGS_CHANGED','financial_restore':False,'image_only_rollback':True}
    failure.write_text(json.dumps(reviewed))
    check('exact_three_reviewed_gate_failures_allow_retry',ns['reviewed_attempt_history'])
    for key,value in (('code','OTHER_FAILURE'),('financial_restore',True),('image_only_rollback',False)):
        failure.write_text(json.dumps({**reviewed,key:value}))
        check('previous_failure_'+key+'_blocks',ns['reviewed_attempt_history'],'PREVIOUS_FAILURE_NOT_REVIEWED_ACTIVE_GATE')
    failure.write_text(json.dumps(reviewed))
    for name in ('apply-success-1.json','apply-attempt-4.json','apply-reservations-3.json'):
        extra=stage.PRIVATE/name;extra.write_text('{}')
        check(name+'_blocks_retry',ns['reviewed_attempt_history'],'PREVIOUS_APPLY_REQUIRES_REVIEW');extra.unlink()

old={'columns':[{'table':'users','column':'id','type':'bigint'}],'constraints':[],'indexes':[]}
new=copy.deepcopy(old)
new['columns'] += [{'table':'top_ups','column':column} for column in ns['NEW_TOPUP_COLUMNS']]
new['columns'] += [{'table':table,'column':'id'} for table in ns['NEW_TABLES']]
check('only_requested_additive_schema_accepted',lambda:ns['schema_additions_only'](old,new))
for label,change,error in (
 ('old_column',lambda value:value['columns'][0].update(type='text'),'EXISTING_COLUMN_CHANGED'),
 ('old_index',lambda value:value['indexes'].append({'table':'users','name':'extra'}),'EXISTING_SCHEMA_INDEXES_CHANGED'),
 ('unrelated_column',lambda value:value['columns'].append({'table':'other','column':'x'}),'UNEXPECTED_NEW_TABLE')):
    changed=copy.deepcopy(new);change(changed)
    check(label+'_change_rejected',lambda:ns['schema_additions_only'](old,changed),error)

identity={'id':'container','image':'old-app','pid':123,'start':'55','comm':'new-api'}
info={'Id':'container','Image':'old-app','State':{'Pid':123,'Running':True}}
actual_identity=ns['process_identity']
procfiles={'/proc/123/comm':'new-api\n','/proc/123/cgroup':'0::/docker/container\n','/proc/123/stat':'123 (new-api) '+' '.join(['S']+['0']*18+['55'])}
class ProcPath:
    def __init__(self,value):self.value=str(value)
    def __truediv__(self,value):return ProcPath(self.value+'/'+str(value))
    def joinpath(self,value):return self/value
    def read_text(self):return procfiles[self.value]
ns['Path']=ProcPath
assert actual_identity(info)==identity
checks.append('process_identity_checks_container_comm_and_starttime')
for name,value in (('comm','unexpected'),('cgroup','0::/docker/foreign')):
    key='/proc/123/'+name;prior=procfiles[key];procfiles[key]=value
    check('process_'+name+'_mismatch_blocks',lambda:actual_identity(info),'STOP_PROCESS_OWNERSHIP_MISMATCH');procfiles[key]=prior
check('process_unapproved_image_blocks',lambda:actual_identity({**info,'Image':'other'}),'STOP_IMAGE_NOT_REVIEWED')
check('process_invalid_pid_blocks',lambda:actual_identity({**info,'State':{'Pid':1,'Running':True}}),'STOP_PROCESS_NOT_RUNNING')
ns['Path']=Path
stage.inspect=lambda name:copy.deepcopy(info)
ns['process_identity']=lambda *args:copy.deepcopy(identity)
signals=[]
ns['os']=types.SimpleNamespace(kill=lambda pid,value:signals.append((pid,value)))
check('verified_identity_receives_only_term',lambda:ns['deliver_verified_term'](identity))
assert signals==[(123,signal.SIGTERM)]
for key,value in (('Image','changed'),('Pid',999)):
    original=info[key] if key=='Image' else info['State'][key]
    if key=='Image':info[key]=value
    else:info['State'][key]=value
    check('signal_'+key+'_drift_blocks',lambda:ns['deliver_verified_term'](identity),'STOP_PROCESS_IDENTITY_CHANGED')
    if key=='Image':info[key]=original
    else:info['State'][key]=original
ns['process_identity']=lambda *args:{**identity,'start':'changed'}
check('signal_pid_reuse_blocks',lambda:ns['deliver_verified_term'](identity),'STOP_PROCESS_IDENTITY_CHANGED')
assert len(signals)==1
commands=[]
