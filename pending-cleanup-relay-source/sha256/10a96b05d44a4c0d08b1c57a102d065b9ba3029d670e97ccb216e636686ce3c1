for label,change in (('source',lambda value:value.update(Source='/different')),('target',lambda value:value.update(Target='/different')),('permission',lambda value:value.update(ReadOnly=False)),('type',lambda value:value.update(Type='volume')),('nested_option',lambda value:value['BindOptions'].update(Propagation='shared'))):
