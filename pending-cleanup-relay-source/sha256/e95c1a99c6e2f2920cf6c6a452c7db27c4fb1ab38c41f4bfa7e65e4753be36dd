import hashlib
import importlib.util
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]

PARSE = r'''
def build_metadata(blob):
    def string_at(start):
        value=0
        shift=0
        while True:
            part=blob[start];start+=1
            value|=(part&127)<<shift
            if part<128:break
            shift+=7
            if shift>63:raise RuntimeError('BUILD_METADATA_VARINT')
        return blob[start:start+value],start+value
    at=0
    while True:
        at=blob.find(b'\xff Go buildinf:',at)
        if at<0:raise RuntimeError('BUILD_METADATA_MISSING')
        if blob[at+15]&2:
            version,next_at=string_at(at+32)
            if version.startswith(b'go1.'):
                module,_=string_at(next_at)
                if len(module)>=33 and module[-17]==10:module=module[16:-16]
                break
        at+=1
    lines=module.decode('utf-8').splitlines()
    settings={}
    for line in lines:
        if line.startswith('build\t'):
            key,value=line[6:].split('=',1)
            if key in ['-buildmode','-compiler','-ldflags','-trimpath','DefaultGODEBUG','CGO_ENABLED','GOOS','GOARCH','GOAMD64']:
                settings[key]=value
    dependency_lines=[line for line in lines if line.startswith(('dep\t','=>\t'))]
    source_roots={}
    for relative in ['main.go','model/pikno_line_sync.go','middleware/rate-limit.go']:
        suffix=('/'+relative).encode()+b'\x00'
        point=blob.find(suffix)
        if point>=0:
            start=blob.rfind(b'\x00',max(0,point-180),point)+1
            prefix=blob[start:point].decode('utf-8',errors='replace')
            source_roots[relative]=prefix if prefix in ['/build','/src','/work','/workspace','/app'] else {'prefix_sha256':hashlib.sha256(prefix.encode()).hexdigest(),'prefix_bytes':len(prefix)}
    return {'go_version':version.decode(),'binary_bytes':len(blob),'settings':settings,'source_roots':source_roots,
            'pending_rate_limit_marker_present':b'UC:assistant-chat-status-v1' in blob,
            'dependency_count':sum(line.startswith('dep\t') for line in dependency_lines),
            'dependency_manifest_sha256':hashlib.sha256('\n'.join(dependency_lines).encode()).hexdigest()}
'''


def main():
    context = {'hashlib': hashlib}
    exec(PARSE, context)
    local_file=HERE / 'backend-baseline63-exactflags'
    if not local_file.exists():local_file=HERE / 'backend-baseline63'
    local = context['build_metadata'](local_file.read_bytes())
    spec = importlib.util.spec_from_file_location('readonly_build_metadata_transport', ROOT / 'output/direct-media-production-current/transport.py')
    transport = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(transport)
    remote = "import hashlib,json,subprocess\n" + PARSE + "\nr=subprocess.run(['docker','exec','piknoai-relay-new-api-1','cat','/new-api'],capture_output=True,timeout=25)\nassert r.returncode==0\nprint(json.dumps(build_metadata(r.stdout)))\n"
    production = transport.remote(remote, timeout=60)
    result = {'format': 1, 'production': production, 'local_rebuilt_baseline': local,
              'same_go_version': local['go_version'] == production['go_version'],
              'same_dependency_manifest': local['dependency_manifest_sha256'] == production['dependency_manifest_sha256'],
              'setting_differences': {key: {'production': production['settings'].get(key), 'local': local['settings'].get(key)}
                                      for key in set(local['settings']) | set(production['settings']) if local['settings'].get(key) != production['settings'].get(key)},
              'production_mutations': 0}
    (HERE / 'baseline63-build-metadata.json').write_text(json.dumps(result, ensure_ascii=True, indent=2) + '\n', encoding='utf-8')
    print(json.dumps({**{key: result[key] for key in ['same_go_version', 'same_dependency_manifest', 'setting_differences']},
                      'production_source_roots':production['source_roots'],'local_source_roots':local['source_roots'],
                      'pending_rate_limit_marker':{'production':production['pending_rate_limit_marker_present'],'local':local['pending_rate_limit_marker_present']}}))


if __name__ == '__main__':
    main()
