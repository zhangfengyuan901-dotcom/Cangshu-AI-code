    path = STAGE / 'cleanup68.py'
    require(path.is_file() and not path.is_symlink() and digest(path) == manifest()['cleanup_sha256'], 'CLEANUP_ENGINE_HASH_DRIFT')
    spec = importlib.util.spec_from_file_location('approved_cleanup68', path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module

def schema():
    return sql("SELECT json_build_object('columns',(SELECT coalesce(json_agg(json_build_object('table',table_name,'column',column_name,'type',data_type,'nullable',is_nullable,'default',column_default) ORDER BY table_name,ordinal_position),'[]'::json) FROM information_schema.columns WHERE table_schema='public'), 'constraints',(SELECT coalesce(json_agg(json_build_object('table',r.relname,'name',c.conname,'type',c.contype,'definition',pg_get_constraintdef(c.oid)) ORDER BY r.relname,c.conname),'[]'::json) FROM pg_constraint c JOIN pg_class r ON r.oid=c.conrelid JOIN pg_namespace n ON n.oid=r.relnamespace WHERE n.nspname='public'), 'indexes',(SELECT coalesce(json_agg(json_build_object('table',tablename,'name',indexname,'definition',indexdef) ORDER BY tablename,indexname),'[]'::json) FROM pg_indexes WHERE schemaname='public'))")

def schema_allowed(before, after):
    require(before == after, 'RETIREMENT_RELEASE_SCHEMA_CHANGED')

def catalog_file(app):
    from pathlib import PurePosixPath
    env = dict(value.split('=',1) for value in app['Config'].get('Env',[]) if '=' in value)
    inside = PurePosixPath(env.get('PIKNO_CATALOG_PATH') or '/data/pikno/catalog.json')
    require(inside.is_absolute() and '..' not in inside.parts, 'CATALOG_CONTAINER_PATH_INVALID')
    matches = []
    for mount in app['Mounts']:
        destination = PurePosixPath(mount['Destination'])
        if inside.is_relative_to(destination):
            matches.append((len(destination.parts), mount, inside.relative_to(destination)))
    require(bool(matches), 'CATALOG_MOUNT_NOT_FOUND')
    _, mount, suffix = max(matches,key=lambda item:item[0])
    require(mount['Type'] in ('bind','volume') and mount.get('RW') is True, 'CATALOG_MOUNT_NOT_WRITABLE')
    base = Path(mount['Source'])
    target = base.joinpath(*suffix.parts)
    require(base.is_absolute() and base.resolve()==base and target.resolve()==target and target.is_file() and not target.is_symlink(), 'CATALOG_HOST_PATH_INVALID')
    return target

def run_cleanup_sql(script):
    raw = run(['docker','exec','-i',PG,'psql','-X','-qAt','-U','pikno','-d','newapi','-v','ON_ERROR_STOP=1','-f','-'],data=script.encode(),timeout=180)
    values = [json.loads(line) for line in raw.decode().splitlines() if line.startswith(('{','['))]
    require(bool(values), 'CLEANUP_SQL_RESULT_MISSING')
    return values[-1]

