func TestPiknoSyncRetirementLifecycle(t *testing.T) {
	channel, now := setupPiknoSyncTest(t)
	_, err := applySyncTest(t, channel, now, syncModelBody("a", "b"), true)
	require.NoError(t, err)
	syncOpenDraft(t, "pikno-video-cs-a")
	syncOpenDraft(t, "pikno-video-cs-b")
	var original PiknoLine
	require.NoError(t, DB.First(&original, "public_model = ?", "pikno-video-cs-a").Error)
	oldLine, err := GetPublishedPiknoLine(original.PublicModel)
	require.NoError(t, err)
	var originalState PiknoLineSyncState
	require.NoError(t, DB.First(&originalState, "public_model = ?", original.PublicModel).Error)

	// Upgrade a populated pre-retirement schema, then repeat startup migration.
	require.NoError(t, DB.Migrator().DropColumn(&PiknoLineSyncState{}, "RetiredRevision"))
	require.False(t, DB.Migrator().HasColumn(&PiknoLineSyncState{}, "RetiredRevision"))
	for range 2 {
		require.NoError(t, MigratePiknoLineSync(DB))
	}
	require.True(t, DB.Migrator().HasColumn(&PiknoLineSyncState{}, "RetiredRevision"))
	var upgraded PiknoLine
	require.NoError(t, DB.First(&upgraded, "public_model = ?", original.PublicModel).Error)
	assert.Equal(t, original, upgraded)
	var migratedState PiknoLineSyncState
	require.NoError(t, DB.First(&migratedState, "public_model = ?", original.PublicModel).Error)
	assert.Zero(t, migratedState.RetiredRevision)
	assert.Equal(t, originalState, migratedState)
	assert.True(t, DB.Migrator().HasIndex(&PiknoLineSyncState{}, "Provider"))
	assert.Error(t, DB.Create(&PiknoLineSyncState{PublicModel: original.PublicModel, Provider: "canseedream"}).Error, "upgrade preserves the unique current-identity constraint")

	require.NoError(t, DB.AutoMigrate(&Task{}, &PiknoSettlement{}))
	historyTask := Task{TaskID: "synthetic-original-unknown", Platform: constant.TaskPlatform("pikno-canseedream"), UserId: 101, ChannelId: channel, Status: TaskStatusUnknown,
		Properties: Properties{OriginModelName: original.PublicModel, UpstreamModelName: "canseedream/video/a"}, PrivateData: TaskPrivateData{UpstreamTaskID: "synthetic-provider-original"}}
	require.NoError(t, DB.Create(&historyTask).Error)
	historyOrder := PiknoSettlement{ID: "synthetic-original-unknown", UserID: 101, TokenID: 201, ChannelID: channel, Model: original.PublicModel, LineRevision: oldLine.Revision, QuoteQuota: 1_700_000, ReservedQuota: 1_700_000, GenerationState: "unknown", FinancialState: "reserved", Version: 1}
	require.NoError(t, DB.Create(&historyOrder).Error)
	var storedTask Task
	var storedOrder PiknoSettlement
	require.NoError(t, DB.First(&storedTask, historyTask.ID).Error)
	require.NoError(t, DB.First(&storedOrder, "id = ?", historyOrder.ID).Error)

	applyCached := func(at int64) error {
		lease, provider, err := AcquirePiknoSyncLease("canseedream", "cached-worker", at)
		if err != nil {
			return err
		}
		snapshot, err := PiknoSyncLastSnapshot("canseedream")
		if err != nil {
			return err
		}
		models, err := PiknoSyncRetainedModels(provider)
		if err != nil {
			return err
		}
		seeds := make([]PiknoLineSeed, 0, len(snapshot.Items))
		for _, item := range snapshot.Items {
			seeds = append(seeds, syncSeed(channel, item))
		}
		source, version, hash, err := piknocatalog.GenerateSyncPlugin("canseedream", models)
		if err != nil {
			return err
		}
		return ApplyPiknoSyncSnapshot(lease, snapshot, seeds, source, version, hash, models, false, at)
	}
	// A legacy cached omission is not a newly confirmed complete response.
	omitted, err := piknocatalog.ParseProviderSnapshot("canseedream", []byte(syncModelBody("b")), time.Unix(now, 0))
	require.NoError(t, err)
	raw, err := common.Marshal(omitted)
	require.NoError(t, err)
	require.NoError(t, DB.Create(&PiknoSyncSnapshot{Hash: omitted.Hash, Provider: "canseedream", Data: string(raw)}).Error)
	require.NoError(t, DB.Model(&PiknoSyncProvider{}).Where("provider = ?", "canseedream").Update("snapshot_hash", omitted.Hash).Error)
	require.NoError(t, applyCached(now+60))
	_, err = GetPublishedPiknoLine(original.PublicModel)
	require.NoError(t, err, "304 reuse cannot confirm a new omission")
	_, err = applySyncTest(t, channel, now+120, syncModelBody("b"), true)
	require.NoError(t, err)
	_, err = GetPiknoLineAdmin(original.PublicModel, 0)
	assert.ErrorIs(t, err, ErrPiknoLineNotFound)
	retired := PiknoLineSyncAdmin(original.PublicModel)
	require.NotNil(t, retired)
	assert.Equal(t, original.Version, retired.RetiredRevision)
	assert.Empty(t, retired.SnapshotHash)
	var routed Channel
	require.NoError(t, DB.First(&routed, channel).Error)
	assert.NotContains(t, routed.GetModels(), original.PublicModel)
	assert.NotContains(t, routed.GetModelMapping(), original.PublicModel)
	var abilityCount int64
	require.NoError(t, DB.Model(&Ability{}).Where("channel_id = ? AND model = ?", channel, original.PublicModel).Count(&abilityCount).Error)
	assert.Zero(t, abilityCount)
	_, err = GetPublishedPiknoLine("pikno-video-cs-b")
	require.NoError(t, err, "another available route remains callable")
	var provider PiknoSyncProvider
	require.NoError(t, DB.First(&provider, "provider = ?", "canseedream").Error)
	retained, err := PiknoSyncRetainedModels(provider)
	require.NoError(t, err)
	assert.Contains(t, retained, "canseedream/video/a", "historical query descriptors are retained")

	_, err = applySyncTest(t, channel, now+180, syncModelBody("a", "b"), true)
	require.NoError(t, err)
	reappeared, err := GetPiknoLineAdmin(original.PublicModel, 0)
	require.NoError(t, err)
	assert.Greater(t, reappeared.Version, original.Version)
	assert.Nil(t, reappeared.Published)
	assert.Nil(t, reappeared.Previous)
	assert.False(t, reappeared.Draft.Enabled)
	assert.Zero(t, reappeared.Draft.Prices[0].RetailQuota)
	syncOpenDraft(t, original.PublicModel)
	newLine, err := GetPublishedPiknoLine(original.PublicModel)
	require.NoError(t, err)
	assert.Greater(t, newLine.Revision, oldLine.Revision)
	oldQuote := PiknoSettlementQuote{ConfirmedSlotID: "synthetic-old-slot", ConfirmedRevision: oldLine.Revision, LineRevision: newLine.Revision, ConfirmedQuota: 1_700_000, QuoteQuota: 1_700_000, ConfirmedExpires: time.Now().Unix() + 300}
	assert.ErrorIs(t, validatePiknoConfirmedReservation(DB, oldQuote, &Token{Group: "video-standard"}), ErrPiknoQuoteChanged)
	lease, _, err := AcquirePiknoSyncLease("canseedream", "closed-worker", now+240)
	require.NoError(t, err)
	changed, err := ApplyPiknoSyncClosures(lease, closureBatch("canseedream/video/a"), now+240)
	require.NoError(t, err)
	assert.Equal(t, 1, changed)
	require.NoError(t, RecordPiknoSyncFailure(lease, "catalog_unverified", now+240))
	require.NoError(t, applyCached(now+300))
	_, err = GetPiknoLineAdmin(original.PublicModel, 0)
	assert.ErrorIs(t, err, ErrPiknoLineNotFound, "cached enabled data cannot revive a retired route")

	// A failed physical deletion rolls its projection and marker back together.
	var beforeFailure PiknoLine
	require.NoError(t, DB.First(&beforeFailure, "public_model = ?", "pikno-video-cs-b").Error)
	lease, _, err = AcquirePiknoSyncLease("canseedream", "rollback-worker", now+360)
	require.NoError(t, err)
	require.NoError(t, DB.Callback().Delete().Before("gorm:delete").Register("test:retirement_failure", func(tx *gorm.DB) {
		if tx.Statement.Table == "pikno_lines" {
			tx.AddError(errors.New("synthetic retirement failure"))
		}
	}))
	_, err = ApplyPiknoSyncClosures(lease, closureBatch("canseedream/video/b"), now+360)
	assert.Error(t, err)
	require.NoError(t, DB.Callback().Delete().Remove("test:retirement_failure"))
	require.NoError(t, RecordPiknoSyncFailure(lease, "catalog_unverified", now+360))
	var afterFailure PiknoLine
	require.NoError(t, DB.First(&afterFailure, "public_model = ?", beforeFailure.PublicModel).Error)
	assert.Equal(t, beforeFailure, afterFailure)
	assert.False(t, PiknoLineSyncAdmin(beforeFailure.PublicModel).Paused)
	require.NoError(t, DB.First(&routed, channel).Error)
	assert.Contains(t, routed.GetModels(), beforeFailure.PublicModel)
	_, err = applySyncTest(t, channel, now+420, syncModelBody(), true)
	require.NoError(t, err, "a new complete empty directory retires the final current route")
	var currentCount int64
	require.NoError(t, DB.Model(&PiknoLine{}).Count(&currentCount).Error)
	assert.Zero(t, currentCount)
	var afterTask Task
	var afterOrder PiknoSettlement
	require.NoError(t, DB.First(&afterTask, historyTask.ID).Error)
	require.NoError(t, DB.First(&afterOrder, "id = ?", historyOrder.ID).Error)
	assert.Equal(t, storedTask, afterTask)
	assert.Equal(t, storedOrder, afterOrder)
	queried, exists, err := GetByTaskId(historyTask.UserId, historyTask.TaskID)
	require.NoError(t, err)
	assert.True(t, exists)
	assert.Equal(t, storedTask, *queried)
	queryPlugin, ok := jsplugin.DefaultRegistry.Get("pikno-canseedream")
	require.True(t, ok)
	assert.Contains(t, queryPlugin.Meta.Models, "canseedream/video/a")
	t.Run("independent_provider_locks", func(t *testing.T) {
		if DB.Dialector.Name() == "sqlite" {
			return // SQLite has no FOR UPDATE; both row-lock engines exercise this case.
		}
		testPiknoSyncProviderLockIsolation(t, channel, now+900)
	})
}

func testPiknoSyncProviderLockIsolation(t *testing.T, canseeChannel int, now int64) {
	t.Helper()
	base, setting := "https://sanbaobeauty.com", `{"task_plugin_key":"pikno-sanbao"}`
	sanbao := Channel{Type: constant.ChannelTypeTaskPlugin, Key: "synthetic-only", Name: "independent-sync-test", Status: common.ChannelStatusEnabled, BaseURL: &base, Setting: &setting}
	require.NoError(t, sanbao.Insert())
	type input struct {
		lease                 PiknoSyncLease
		snapshot              *piknocatalog.ProviderSnapshot
		seeds                 []PiknoLineSeed
		source, version, hash string
		models                map[string]piknocatalog.AdapterDescriptor
	}
	prepare := func(provider string, channel int, at int64, ids ...string) input {
		lease, old, err := AcquirePiknoSyncLease(provider, "independent-provider-worker", at)
		require.NoError(t, err)
		body := syncModelBody(ids...)
		if provider == "sanbao" {
			items := make([]map[string]any, 0, len(ids))
			for _, id := range ids {
				items = append(items, map[string]any{"id": id, "type": "video", "enabled": true, "billing": "per_second", "price_per_second_credits": 1, "resolutions": []string{"720p"}, "durations": []int{4}})
			}
			raw, err := common.Marshal(map[string]any{"data": items})
			require.NoError(t, err)
			body = string(raw)
		}
		snapshot, err := piknocatalog.ParseProviderSnapshot(provider, []byte(body), time.Unix(at, 0))
		require.NoError(t, err)
		models, err := PiknoSyncRetainedModels(old)
		require.NoError(t, err)
		seeds := make([]PiknoLineSeed, 0, len(snapshot.Items))
		for _, item := range snapshot.Items {
			seed := syncSeed(channel, item)
			seed.Provider, seed.PluginKey = provider, "pikno-"+provider
			if provider == "sanbao" {
				seed.PublicModel = "pikno-video-sb-" + strings.TrimPrefix(item.Entry.ID, "sanbao/")
			}
			seeds = append(seeds, seed)
			if item.Adapter != nil {
				models[item.Entry.ID] = *item.Adapter
			}
		}
		source, version, hash, err := piknocatalog.GenerateSyncPlugin(provider, models)
		require.NoError(t, err)
		return input{lease, snapshot, seeds, source, version, hash, models}
	}
	apply := func(value input, at int64) error {
		return ApplyPiknoSyncSnapshot(value.lease, value.snapshot, value.seeds, value.source, value.version, value.hash, value.models, true, at)
	}
	for _, item := range []struct {
		provider string
		channel  int
	}{{"canseedream", canseeChannel}, {"sanbao", sanbao.Id}} {
		value := prepare(item.provider, item.channel, now, "keep", "retire")
		require.NoError(t, apply(value, now))
	}
	inputs := []input{prepare("canseedream", canseeChannel, now+60, "keep"), prepare("sanbao", sanbao.Id, now+60, "keep")}
	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
	defer cancel()
	oldDB := DB
	DB = DB.WithContext(ctx)
	defer func() { DB = oldDB }()
	entered, release := make(chan struct{}, 2), make(chan struct{})
	require.NoError(t, DB.Callback().Query().Before("gorm:query").Register("test:independent_provider_scan", func(tx *gorm.DB) {
		if tx.Statement.Table != "pikno_lines" {
			return
		}
		if _, ok := tx.Statement.Dest.(*[]PiknoLine); !ok {
			return
		}
		select {
		case entered <- struct{}{}:
		case <-ctx.Done():
			tx.AddError(ctx.Err())
			return
		}
		select {
		case <-release:
		case <-ctx.Done():
			tx.AddError(ctx.Err())
		}
	}))
	defer func() { _ = DB.Callback().Query().Remove("test:independent_provider_scan") }()
	results := make(chan error, 2)
	for _, value := range inputs {
		go func(value input) { results <- apply(value, now+60) }(value)
	}
	for range 2 {
		select {
		case <-entered:
		case <-ctx.Done():
			close(release)
			t.Fatal("independent provider transactions could not reach their scans")
		}
	}
	close(release)
	for range 2 {
		select {
		case err := <-results:
			require.NoError(t, err)
		case <-ctx.Done():
			t.Fatal("cross-provider line synchronization did not finish")
		}
	}
	for _, prefix := range []string{"pikno-video-cs-", "pikno-video-sb-"} {
		_, err := GetPiknoLineAdmin(prefix+"retire", 0)
		assert.ErrorIs(t, err, ErrPiknoLineNotFound)
		_, err = GetPiknoLineAdmin(prefix+"keep", 0)
		require.NoError(t, err)
	}
}
