func TestPiknoSyncManualSchemaRecovery(t *testing.T) {
	channel, now := setupPiknoSyncTest(t)
	_, err := applySyncTest(t, channel, now, syncModelBody("a"), true)
	require.NoError(t, err)
	syncOpenDraft(t, "pikno-video-cs-a")
