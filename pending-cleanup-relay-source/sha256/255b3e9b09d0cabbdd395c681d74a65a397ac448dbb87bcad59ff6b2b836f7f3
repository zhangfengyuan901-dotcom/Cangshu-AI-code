func TestPiknoSyncDisabledMissingAndStale(t *testing.T) {
	channel, now := setupPiknoSyncTest(t)
	_, err := applySyncTest(t, channel, now, syncModelBody("a", "b", "c"), true)
	require.NoError(t, err)
	syncOpenDraft(t, "pikno-video-cs-a")
	for i := 1; i <= 3; i++ {
		_, err = applySyncTest(t, channel, now+int64(i*60), syncModelBody("b", "c"), true)
		require.NoError(t, err)
		state := PiknoLineSyncAdmin("pikno-video-cs-a")
		require.Equal(t, 1, state.MissingCount)
		require.True(t, state.Paused)
		_, err = GetPiknoLineAdmin("pikno-video-cs-a", 0)
		require.ErrorIs(t, err, ErrPiknoLineNotFound)
	}
	_, err = GetPublishedPiknoLine("pikno-video-cs-a")
	require.Error(t, err)
	_, err = applySyncTest(t, channel, now+240, syncModelBody("a", "b", "c"), true)
	require.NoError(t, err)
	syncOpenDraft(t, "pikno-video-cs-a")
	_, err = GetPublishedPiknoLine("pikno-video-cs-a")
	require.NoError(t, err)
	disabled := strings.Replace(syncModelBody("a", "b", "c"), `"id":"a",`, `"id":"a","disabled":true,`, 1)
	_, err = applySyncTest(t, channel, now+300, disabled, true)
	require.NoError(t, err)
	require.Equal(t, "disabled", PiknoLineSyncAdmin("pikno-video-cs-a").PauseReason)
	require.NoError(t, DB.Model(&PiknoSyncProvider{}).Where("provider = ?", "canseedream").Update("last_verified_at", time.Now().Unix()-600).Error)
	require.Equal(t, "stale", PiknoLineSyncAdmin("pikno-video-cs-a").PauseReason)
}
func TestPiknoSyncLeaseCadenceAndFencing(t *testing.T) {
	_, now := setupPiknoSyncTest(t)
	lease, _, err := AcquirePiknoSyncLease("canseedream", "worker-a", now)
	require.NoError(t, err)
	_, _, err = AcquirePiknoSyncLease("canseedream", "worker-b", now+1)
	require.ErrorIs(t, err, ErrPiknoSyncLease)
	require.NoError(t, RecordPiknoSyncFailure(lease, "catalog_unverified", now+2))
	_, _, err = AcquirePiknoSyncLease("canseedream", "worker-b", now+3)
	require.ErrorIs(t, err, ErrPiknoSyncLease)
	newer, _, err := AcquirePiknoSyncLease("canseedream", "worker-b", now+62)
	require.NoError(t, err)
	require.Greater(t, newer.Epoch, lease.Epoch)
	require.ErrorIs(t, RecordPiknoSyncFailure(lease, "stale_worker", now+63), ErrPiknoSyncLease)
}
