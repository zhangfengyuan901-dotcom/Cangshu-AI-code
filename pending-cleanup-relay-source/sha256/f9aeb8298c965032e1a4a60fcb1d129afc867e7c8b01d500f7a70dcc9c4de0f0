    def test_failure_codes_cannot_include_private_error_details(self):
        self.assertEqual(D.safe_failure_code(RuntimeError('RECENT_OR_ACTIVE_WORK_DEFER_RELEASE')), 'RECENT_OR_ACTIVE_WORK_DEFER_RELEASE')
        self.assertEqual(D.safe_failure_code(RuntimeError('synthetic customer private details')), 'PRIVATE_FAILURE_DETAILS_WITHHELD')
        self.assertEqual(D.safe_failure_code(ValueError('PRIVATE_VALUE')), 'PRIVATE_FAILURE_DETAILS_WITHHELD')

    def test_artwork_resource_hash_and_content_type_are_both_required(self):
        body = b'synthetic artwork bytes'
        entry = '/static/js/index.synthetic123.js'
        build = {'frontend_entry_script': entry, 'frontend_resources': [
            {'path': '/static/image/brand.synthetic.webp', 'sha256': hashlib.sha256(body).hexdigest(), 'content_type': 'image/webp'}], 'public_paths': ['/']}
        response = mock.Mock(returncode=0, stdout=body, stderr=b'HTTP/1.1 200 OK\nContent-Type: image/webp\n')
        with mock.patch.object(D, 'manifest', return_value=build), mock.patch.object(D.subprocess, 'run', return_value=response), mock.patch.object(D, 'run', return_value=entry.encode()):
            self.assertEqual(D.verify_frontend()['checked_resources'], 1)
            response.stderr = b'HTTP/1.1 200 OK\nContent-Type: text/html\n'
            with self.assertRaisesRegex(RuntimeError, 'FRONTEND_RESOURCE_CONTENT_TYPE_DRIFT'):
                D.verify_frontend()


