with mock.patch.dict(sys.modules, {'fcntl': mock.Mock()}):
    SPEC.loader.exec_module(D)


class ReleaseGuards(unittest.TestCase):
    def test_database_queries_are_wrapped_in_read_only_transaction(self):
        with mock.patch.object(D, 'run', return_value=b'BEGIN\n{"ok":true}\nROLLBACK\n') as run:
            self.assertEqual(D.sql("SELECT json_build_object('ok',true)"), {'ok': True})
            query = run.call_args.args[0][-1]
            self.assertTrue(query.startswith('BEGIN READ ONLY; '))
            self.assertTrue(query.endswith('; ROLLBACK'))

    def test_old_unknowns_are_retained_without_blocking_idle_release(self):
        activity = {'recent_tasks': 0, 'recent_settlements': 0, 'tasks_active': 0, 'settlements_active': 0,
                    'llm_active': 0, 'recent_llm': 0, 'pending_recharges': 0, 'reverse_active': 0,
                    'old_unknown_settlements': 3, 'old_unknown_llm': 15}
        with mock.patch.object(D, 'activity', return_value=activity), mock.patch.object(D, 'run', return_value=b'{"active":0,"accepting":true}'):
            self.assertEqual(D.assert_quiet(), activity)

    def test_recent_settlement_blocks_before_stop_or_image_change(self):
        with mock.patch.object(D, 'activity', return_value={'recent_settlements': 1, 'old_unknown_settlements': 3}), mock.patch.object(D, 'run') as run:
            with self.assertRaisesRegex(RuntimeError, 'RECENT_OR_ACTIVE_WORK'):
                D.assert_quiet()
            run.assert_not_called()

    def test_frontend_release_schema_must_remain_identical(self):
        before = {'columns': [{'table': 'users', 'column': 'id', 'type': 'bigint', 'nullable': 'NO', 'default': None}], 'constraints': [], 'indexes': []}
        D.schema_allowed(before, dict(before))
        added = {'table': 'pikno_line_sync_states', 'column': 'retired_revision', 'type': 'bigint', 'nullable': 'NO', 'default': '0'}
        for after in [
            {**before, 'columns': before['columns'] + [added]},
            {**before, 'constraints': [{'name': 'synthetic'}]},
            {**before, 'indexes': [{'name': 'synthetic'}]},
        ]:
            with self.assertRaisesRegex(RuntimeError, 'FRONTEND_ONLY_RELEASE_SCHEMA_CHANGED'):
                D.schema_allowed(before, after)

    def test_private_inventory_is_exclusive_and_not_customer_rows_export(self):
        with tempfile.TemporaryDirectory(prefix='portal67-guard-') as folder:
            stage = Path(folder).resolve() / 'stage'
            private = stage / 'private'
            with mock.patch.object(D, 'STAGE', stage), mock.patch.object(D, 'PRIVATE', private):
                digest = D.save_private('inventory.json', {'lines': [{'public_model': 'synthetic'}], 'protected': {'users': {'count': 1, 'digest': 'synthetic'}}})
                self.assertEqual(len(digest), 64)
                self.assertEqual(json.loads((private / 'inventory.json').read_text())['lines'][0]['public_model'], 'synthetic')
                with self.assertRaises(FileExistsError):
                    D.save_private('inventory.json', {})

    def test_compose_only_replaces_new_api_image(self):
        with tempfile.TemporaryDirectory(prefix='portal67-compose-') as folder:
            root = Path(folder)
            original = 'services:\n  new-api:\n    image: old-app:local\n    environment:\n      - SAFE=SYNTHETIC\n  postgres:\n    image: postgres:16\n'
            (root / 'compose.yaml').write_text(original)
            with mock.patch.object(D, 'ROOT', root):
                changed = D.compose_with_image('old-app:local', 'new-app:local')
                self.assertEqual(changed, original.replace('old-app:local', 'new-app:local'))
                self.assertEqual((root / 'compose.yaml').read_text(), original)
                with self.assertRaisesRegex(RuntimeError, 'REFERENCE_DRIFT'):
                    D.compose_with_image('different:local', 'new-app:local')

    def apply_fixture(self, folder):
        stage = Path(folder).resolve() / 'stage'
        private = stage / 'private'
        private.mkdir(parents=True)
        (private / 'stage.json').write_text(json.dumps({'old_runtime': 'runtime', 'tool_runtime': 'runtime', 'files': {'compose.yaml': 'old'},
                                                     'candidate_image_id': 'candidate', 'manifest_sha256': 'manifest', 'old_image_reference': 'old-app'}))
        return stage, private

