function ModelLibrary({
  data,
  pricing = false,
}: {
  data: ReturnType<typeof usePublishedModels>;
  pricing?: boolean;
}) {
  const { t, i18n } = useTranslation();
  const [search, setSearch] = useState("");
  const [category, setCategory] = useState("all");
  const [resolution, setResolution] = useState("all");
  const [selectedId, setSelectedId] = useState<string | null>(() =>
    new URLSearchParams(window.location.search).get("model"),
  );
  const [page, setPage] = useState(1);
  const models = data.catalog?.models || [];
  const selected = models.find((model) => model.id === selectedId);
  const results = filterPublishedModels(models, search, category, resolution);
  const pages = Math.max(1, Math.ceil(results.length / 12)),
    current = Math.min(page, pages);
  const resolutions = [...new Set(models.flatMap((model) => model.resolutions))];
  const locale = toIntlLocale(i18n.resolvedLanguage || i18n.language);
  useEffect(() => {
    if (data.catalog && selectedId && !selected) setSelectedId(null);
  }, [data.catalog, selected, selectedId]);
  let catalogLabel = "Published directory";
  if (data.unverified) catalogLabel = "Directory needs update";
  if (data.loading) catalogLabel = "Updating directory";
  let listing: ReactNode;
  if (data.failed && !data.catalog) {
    listing = (
      <ErrorState
        title={t("Unable to load model catalog")}
        description={t("Please try again. No example models or prices are substituted.")}
        onRetry={data.refresh}
      />
    );
  } else if (data.loading && !data.catalog) {
    listing = (
      <div className="portal-model-grid">
        {[0, 1, 2, 3, 4, 5].map((value) => (
          <Skeleton className="h-64" key={value} />
        ))}
      </div>
    );
  } else if (!results.length) {
    listing = (
      <EmptyState
        title={t("No matching models")}
        description={t("Try another search or filter. Models appear after they are published.")}
        action={
          <Button
            variant="outline"
            onClick={() => {
              setSearch("");
              setCategory("all");
              setResolution("all");
            }}
          >
            {t("Reset filters")}
          </Button>
        }
      />
    );
  } else if (pricing) {
    listing = (
      <Table className="portal-pricing-table">
        <TableHeader>
          <TableRow>
            <TableHead>{t("Model")}</TableHead>
            <TableHead>{t("Specifications")}</TableHead>
            <TableHead>{t("Published pricing")}</TableHead>
            <TableHead>{t("API access")}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {results.slice((current - 1) * 12, current * 12).map((model) => (
            <TableRow key={model.id}>
              <TableCell>
                <strong>{model.name}</strong>
                <code>{model.id}</code>
              </TableCell>
              <TableCell>
                {model.resolutions.join(" / ") || t("Standard")}
                <small>{model.ratios.join(" · ")}</small>
              </TableCell>
              <TableCell>
                <PriceList model={model} />
              </TableCell>
              <TableCell>
                <Button variant="ghost" onClick={() => setSelectedId(model.id)}>
                  {t("View details")}
                  <ArrowRight data-icon="inline-end" />
                </Button>
              </TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
    );
  } else {
    listing = (
      <div className="portal-model-grid">
        {results.slice((current - 1) * 12, current * 12).map((model) => (
          <PortalModelCard key={model.id} model={model} onDetails={() => setSelectedId(model.id)} />
        ))}
      </div>
    );
  }
  return (
    <>
      <section className={`portal-hub-hero ${pricing ? "pricing" : "models"}`}>
        <div>
          <span className="portal-eyebrow">
            {t(pricing ? "SIMPLE, PUBLISHED PRICING" : "FIND YOUR NEXT POSSIBILITY")}
          </span>
          <h1>{t(pricing ? "Powerful models. Clear pricing." : "Explore the model library.")}</h1>
          <p>
            {t(
              pricing
                ? "Compare published prices and supported specifications in one place."
                : "Find the right capability for your application and creative workflow.",
            )}
          </p>
          <Button
            className="portal-dark-button"
            role="link"
            render={<a href={pricing ? "/hub/billing" : "/hub/docs"} />}
            nativeButton={false}
          >
            {t(pricing ? "Balance & recharge" : "Start building")}
            <ArrowRight data-icon="inline-end" />
          </Button>
        </div>
        <div className="portal-hub-art" aria-hidden="true">
          <PortalArtwork name={pricing ? "api" : "library"} />
        </div>
      </section>
      <div className="portal-hub-layout">
        <aside className="portal-library-sidebar">
          <span className="portal-micro-label">{t("DISCOVER")}</span>
          <h2>{t("Model library")}</h2>
          <div className="portal-category-list" role="group" aria-label={t("Model category")}>
            {categories.map(({ value, label, icon: Icon }) => (
              <Button
                key={value}
                variant="ghost"
                aria-pressed={value === category}
                onClick={() => {
                  setCategory(value);
                  setPage(1);
                }}
              >
                <Icon data-icon="inline-start" />
                {t(label)}
                <span>
                  {formatNumber(
                    value === "all"
                      ? models.length
                      : models.filter((model) => model.category === value).length,
                    locale,
                  )}
                </span>
              </Button>
            ))}
          </div>
          <div className="portal-sidebar-note">
            <Code2 />
            <h3>{t("Build something great.")}</h3>
            <p>{t("Everything you need to connect your first model.")}</p>
            <a href="/hub/docs">
              {t("Read the docs")}
              <ArrowRight aria-hidden="true" />
            </a>
          </div>
        </aside>
        <main className="portal-library-main" id="portal-main">
          <div className="portal-breadcrumb">
            PIKNO <ChevronRight aria-hidden="true" />
            {t(pricing ? "Pricing" : "Model library")}
          </div>
          <div className="portal-library-toolbar">
            <label className="portal-search">
              <Search aria-hidden="true" />
              <Input
                value={search}
                aria-label={t("Search models")}
                placeholder={t("Search models by name or ID")}
                onChange={(event) => {
                  setSearch(event.target.value);
                  setPage(1);
                }}
              />
            </label>
            <Select
              items={[
                { value: "all", label: t("All resolutions") },
                ...resolutions.map((value) => ({ value, label: value })),
              ]}
              value={resolution}
              onValueChange={(value) => {
                setResolution(String(value || "all"));
                setPage(1);
              }}
            >
              <SelectTrigger aria-label={t("Resolution filter")}>
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectGroup>
                  <SelectItem value="all">{t("All resolutions")}</SelectItem>
                  {resolutions.map((value) => (
                    <SelectItem value={value} key={value}>
                      {value}
                    </SelectItem>
                  ))}
                </SelectGroup>
              </SelectContent>
            </Select>
            <Button variant="ghost" disabled={data.loading} onClick={data.refresh}>
              {t("Refresh")}
            </Button>
          </div>
          <div className="portal-result-summary">
            <span>
              {t("Models found")}: {formatNumber(results.length, locale)}
            </span>
            <span className={data.unverified ? "unverified" : ""}>
              <span className="portal-status-dot" />
              {t(catalogLabel)}
            </span>
          </div>
          {listing}
          {pages > 1 && (
            <nav className="portal-pagination" aria-label={t("Model pages")}>
              <Button
                variant="outline"
                disabled={current <= 1}
                onClick={() => setPage(current - 1)}
              >
                {t("Previous page")}
              </Button>
              <span>
                {current} / {pages}
              </span>
              <Button
                variant="outline"
                disabled={current >= pages}
                onClick={() => setPage(current + 1)}
              >
                {t("Next page")}
              </Button>
            </nav>
          )}
          {data.unverified && data.catalog && (
            <p role="status" className="portal-catalog-notice">
              {t("The directory needs an update. Displayed information is for reference.")}
            </p>
          )}
          {selected && (
            <ModelDetails
              model={selected}
              unverified={data.unverified}
              onClose={() => setSelectedId(null)}
            />
          )}
        </main>
      </div>
    </>
  );
}

