function PortalArtwork({
  name,
  eager = false,
  className = "",
}: {
  name: keyof typeof portalArtwork;
  eager?: boolean;
  className?: string;
}) {
  return (
    <img
      className={`portal-artwork ${className}`}
      src={portalArtwork[name]}
      alt=""
      width={1672}
      height={941}
      loading={eager ? "eager" : "lazy"}
      fetchPriority={eager ? "high" : undefined}
      decoding="async"
      data-artwork={name}
    />
  );
}

function usePublishedModels(enabled: boolean) {
  const [catalog, setCatalog] = useState<PublishedCatalog | null>(null);
  const [loading, setLoading] = useState(enabled);
  const [unverified, setUnverified] = useState(false);
  const [failed, setFailed] = useState(false);
  const coordinator = useRef<ReturnType<typeof startCatalogRefresh> | null>(null);
  useEffect(() => {
    if (!enabled) return;
    let disposed = false;
    const controller = new AbortController();
    const observed = {
      isFetching: false,
      lastSuccessAt: 0,
      lastErrorAt: 0,
      error: null as unknown,
    };
    const read = async () => {
      observed.isFetching = true;
      if (!disposed) setLoading(true);
      try {
        const next = await readPublishedCatalog(controller.signal);
        if (disposed) return;
        observed.lastSuccessAt = Date.now();
        observed.error = null;
        setCatalog(next);
        setFailed(false);
        setUnverified(false);
      } catch {
        observed.lastErrorAt = Date.now();
        observed.error = new Error("catalog_unavailable");
        if (!disposed) {
          setFailed(true);
          setUnverified(true);
        }
        throw observed.error;
      } finally {
        observed.isFetching = false;
        if (!disposed) setLoading(false);
      }
    };
    coordinator.current = startCatalogRefresh({
      read,
      state: () => observed,
      onUnverified: () => setUnverified(true),
      onVerified: () => setUnverified(false),
    });
    void read().catch(() => {});
    return () => {
      disposed = true;
      controller.abort();
      coordinator.current?.dispose();
      coordinator.current = null;
    };
  }, [enabled]);
  return { catalog, loading, unverified, failed, refresh: () => coordinator.current?.refresh() };
}

