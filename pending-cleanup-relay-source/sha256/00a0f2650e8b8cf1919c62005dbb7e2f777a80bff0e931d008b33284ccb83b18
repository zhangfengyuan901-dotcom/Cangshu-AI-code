function PriceList({ model, compact = false }: { model: PublishedModel; compact?: boolean }) {
  const { t, i18n } = useTranslation();
  const locale = toIntlLocale(i18n.resolvedLanguage || i18n.language);
  return (
    <>
      {model.prices.length ? (
        <dl className="portal-price-list">
          {(compact ? model.prices.slice(0, 1) : model.prices).map((price) => (
            <div key={`${price.resolution}-${price.unit}-${price.retail_cny}`}>
              <dt>{price.resolution === "default" ? t("Standard") : price.resolution}</dt>
              <dd>
                ¥
                {formatLocalCurrencyAmount(price.retail_cny, {
                  locale,
                  showSymbol: false,
                  digitsLarge: 6,
                  digitsSmall: 6,
                })}
                <small> / {t(price.unit)}</small>
              </dd>
            </div>
          ))}
        </dl>
      ) : (
        <p className="portal-muted">{t("Pricing is not published for this model.")}</p>
      )}
      {model.reference_surcharge_cny !== undefined && model.reference_surcharge_cny > 0 && (
        <p className="portal-price-surcharge">
          {t("Published reference surcharge")}: ¥
          {formatLocalCurrencyAmount(model.reference_surcharge_cny, {
            locale,
            showSymbol: false,
            digitsLarge: 6,
            digitsSmall: 6,
          })}
          <small>{t("Applied according to the current quote.")}</small>
        </p>
      )}
    </>
  );
}

