function DeveloperConsole({ path }: { path: string }) {
  const { t } = useTranslation();
  const tab = accountPanel(path);
  const frame = useRef<HTMLIFrameElement>(null);
  const [height, setHeight] = useState(800);
  useEffect(() => {
    const resize = (event: MessageEvent) => {
      if (
        event.origin !== location.origin ||
        event.source !== frame.current?.contentWindow ||
        !event.data ||
        event.data.type !== "pikno-account-size"
      ) {
        return;
      }
      const value: unknown = event.data.height;
      if (typeof value === "number" && Number.isFinite(value) && value >= 120 && value <= 20000) {
        setHeight(Math.min(12000, Math.max(500, Math.ceil(value))));
      }
    };
    window.addEventListener("message", resize);
    return () => window.removeEventListener("message", resize);
  }, []);
  const items = [
    { tab: "balance", href: "/hub/dashboard", label: "Account overview", icon: LayoutDashboard },
    { tab: "keys", href: "/hub/keys", label: "API keys", icon: KeyRound },
    { tab: "usage", href: "/hub/usage", label: "Usage & spending", icon: Wallet },
    { tab: "topup", href: "/hub/billing", label: "Balance & recharge", icon: CreditCard },
  ];
  return (
    <div className="portal-console-layout">
      <main className="portal-console-main" id="portal-main">
        <div className="portal-breadcrumb">
          PIKNO
          <ChevronRight aria-hidden="true" />
          {t("Console")}
        </div>
        <div className="portal-page-heading">
          <span className="portal-eyebrow">{t("WORKSPACE")}</span>
          <h1>{t(items.find((item) => item.tab === tab)?.label || "Account overview")}</h1>
          <p>{t("Manage your account and API access in one place.")}</p>
        </div>
        <nav className="portal-console-tabs" aria-label={t("Console navigation")}>
          {items.map(({ href, label, icon: Icon, tab: itemTab }) => (
            <a href={href} aria-current={tab === itemTab ? "page" : undefined} key={href}>
              <Icon aria-hidden="true" />
              {t(label)}
            </a>
          ))}
        </nav>
        {/* oxlint-disable-next-line react/iframe-missing-sandbox -- This fixed, trusted same-origin account application owns its existing session, native bridge and payment flows. A scripts+same-origin sandbox adds no isolation; preserve those flows and validate size messages separately. */}
        <iframe
          key={tab}
          ref={frame}
          style={{ height }}
          className="portal-account-frame"
          src={`/account-lite/index.html?tab=${tab}&embed=1`}
          title={t("PIKNO account management")}
        />
        <a className="portal-frame-fallback" href={`/account-lite/index.html?tab=${tab}`}>
          {t("Open account management in a full page")}
          <ExternalLink aria-hidden="true" />
        </a>
      </main>
    </div>
  );
}

export function PortalApp({ path = window.location.pathname }: { path?: string }) {
  const { t } = useTranslation();
  const page = portalPage(path) || "home";
  const data = usePublishedModels(page === "home" || page === "models" || page === "pricing");
  const titles = {
    home: "AI for every possibility",
    models: "Model library",
    pricing: "Pricing",
    docs: "Documentation",
    dashboard: "Developer console",
  };
  const title = titles[page];
  useEffect(() => {
    document.title = `${t(title)} · PIKNO`;
  }, [title, t]);
  let content: ReactNode;
  if (page === "home") {
    content = (
      <main id="portal-main">
        <HomePage models={data.catalog?.models || []} unverified={data.unverified} />
      </main>
    );
  } else if (page === "models" || page === "pricing") {
    content = <ModelLibrary data={data} pricing={page === "pricing"} />;
  } else if (page === "docs") {
    content = <Documentation />;
  } else {
    content = <DeveloperConsole path={path} />;
  }
  return (
    <div className="pikno-portal">
      <a className="portal-skip-link" href="#portal-main">
        {t("Skip to content")}
      </a>
      <PortalHeader path={path} />
      {content}
      <PortalFooter />
    </div>
  );
}
