    def test_every_strict_table_must_match_remaining_fingerprint(self):
        fingerprint={'count':1,'digest':'fixture-hash'}
        plan={'tables':{t:{'preserved':fingerprint} for t in D.STRICT_TABLES}}
        with mock.patch.object(D,'sql',return_value=fingerprint):D.assert_strict_fingerprints(plan)
        with mock.patch.object(D,'sql',return_value={'count':2,'digest':'changed'}):
            with self.assertRaisesRegex(RuntimeError,'PROTECTED_HISTORY_OR_FINANCIAL_STATE_CHANGED'):
                D.assert_strict_fingerprints(plan)
        plan['tables'].pop('users')
        with mock.patch.object(D,'sql',return_value=fingerprint):
            with self.assertRaisesRegex(RuntimeError,'PROTECTED_TABLE_MISSING'):
                D.assert_strict_fingerprints(plan)

