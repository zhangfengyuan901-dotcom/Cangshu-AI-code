    def test_cleanup_sql_uses_one_connection_stdin_and_stop_on_error(self):
        with mock.patch.object(D,'run',return_value=b'BEGIN\n{"committed":true}\nCOMMIT\n') as run:
            self.assertTrue(D.run_cleanup_sql('BEGIN; SELECT 1; COMMIT;')['committed'])
            args=run.call_args.args[0]
