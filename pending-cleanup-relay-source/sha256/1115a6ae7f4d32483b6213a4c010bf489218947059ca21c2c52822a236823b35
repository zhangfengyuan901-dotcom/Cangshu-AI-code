    def test_initial_busy_never_stops_or_calls_cleanup(self):
        with self.fixture() as f:
            D.assert_quiet.side_effect=RuntimeError('RECENT_OR_ACTIVE_WORK_DEFER_RELEASE')
            with self.assertRaisesRegex(RuntimeError,'RECENT_OR_ACTIVE_WORK'):
                D.apply()
            self.assertNotIn('stop',f['events']);f['engine'].apply.assert_not_called()
            D.cleanup_engine.assert_not_called();D.replace_compose_image.assert_not_called()

