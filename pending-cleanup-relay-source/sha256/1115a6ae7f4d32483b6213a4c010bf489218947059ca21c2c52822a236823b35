                    events.append('restart:'+runtime['image']);runtime['stopped']=False
                    return b''
                raise AssertionError('UNEXPECTED_COMMAND_IN_SYNTHETIC_TEST')

            def replace(old,new):
                self.assertEqual(runtime['image'],old)
                runtime['image']=new;events.append('image:'+new)

            def verified():
                events.append('verify')
                return {'verified':True,'financial_restore':False}

            with contextlib.ExitStack() as stack:
