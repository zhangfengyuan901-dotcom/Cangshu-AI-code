            engine.commit_catalog.side_effect=lambda *_a,**_k:(events.append('catalog-commit') or {'catalog_replaced':True,'removed':{'draft':2}})

            def run(args,**_):
                if args[:3]==['docker','image','inspect']:
                    return b'[{"Id":"fixture-image-id"}]'
                if 'stop' in args:
                    events.append('stop')
                    if runtime['fail_fence'] and events.count('stop')>1:
                        raise RuntimeError('FIXTURE_FENCE_FAILURE')
                    runtime['stopped']=True
                    return b''
                if 'up' in args:
                    events.append('up:'+runtime['image']);runtime['stopped']=False
                    return b''
