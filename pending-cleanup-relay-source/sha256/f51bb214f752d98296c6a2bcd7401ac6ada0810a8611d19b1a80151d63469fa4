import http from 'node:http';
import { readFile } from 'node:fs/promises';
import path from 'node:path';

const frontend = path.resolve('build/hamster-trim44-web/public');
const account = { id: 42, role: 1, username: 'payment-fixture' };
const orders = new Map();
let created = 0;
let cancelled = 0;
let balance = 0;

function json(res, value) {
  res.writeHead(200, { 'content-type': 'application/json', 'cache-control': 'no-store' });
  res.end(JSON.stringify(value));
}

function ok(res, data) { json(res, { success: true, data }); }

const server = http.createServer(async (req, res) => {
  try {
    const origin = 'http://127.0.0.1:18169';
    const url = new URL(req.url, origin);
    if (url.pathname === '/api/user/auth/refresh') return ok(res, {
      user: account, session: { sid: 'fixture-session' }, access_token: 'synthetic-only', access_expires_at: Math.floor(Date.now() / 1000) + 3600,
    });
    if (url.pathname === '/api/status') return ok(res, { quota_per_unit: 1000000, usd_exchange_rate: 1 });
    if (url.pathname === '/api/user/self') return ok(res, { ...account, quota: balance * 1000000, used_quota: 0, request_count: 0 });
    if (url.pathname === '/api/user/topup/info') return ok(res, { fixed_cny_topup: true, enable_online_topup: true,
      payment_compliance_confirmed: true, payment_cancel_supported: true, amount_options: [50], pay_methods: [{ type: 'alipay' }] });
    if (url.pathname === '/api/user/amount') return ok(res, 50);
    if (url.pathname === '/api/user/topup/self') return ok(res, { items: Array.from(orders.values()).reverse(), total: orders.size });
    if (url.pathname === '/api/user/pay' && req.method === 'POST') {
      const tradeNo = 'USR42NOfixture' + ++created;
      orders.set(tradeNo, { trade_no: tradeNo, money: 50, status: 'pending', payment_method: 'alipay', cancellable: true });
      return json(res, { message: 'success', url: origin + '/pay/lanjing/epay/submit.php', data: {
        pid: '1', type: 'alipay', out_trade_no: tradeNo, notify_url: origin + '/api/user/epay/notify',
        return_url: origin + '/account-lite/index.html?tab=topup&payment_return=1&trade_no=' + tradeNo,
        name: 'TUC50', money: '50.00', sign: '0'.repeat(32), sign_type: 'MD5',
      } });
    }
    if (url.pathname === '/api/user/topup/status') return ok(res, orders.get(url.searchParams.get('trade_no')));
    if (url.pathname === '/api/user/topup/cancel' && req.method === 'POST') {
      let body = '';
      for await (const chunk of req) body += chunk;
      const row = orders.get(JSON.parse(body).trade_no);
      if (!row || row.status !== 'pending') return json(res, { success: false });
      row.status = 'closing';
      row.cancellable = false;
      cancelled++;
      setTimeout(() => { row.status = 'cancelled'; }, 1300);
      return ok(res, row);
    }
    if (url.pathname === '/pay/lanjing/epay/submit.php' && req.method === 'POST') {
      let body = '';
      for await (const chunk of req) body += chunk;
      const row = orders.get(new URLSearchParams(body).get('out_trade_no'));
      if (!row) { res.writeHead(400); return res.end(); }
      const returned = '/account-lite/index.html?tab=topup&payment_return=1&trade_no=' + row.trade_no;
      res.writeHead(200, { 'content-type': 'text/html; charset=utf-8' });
      res.end('<!doctype html><a href="' + returned + '">模拟支付完成</a>');
      setTimeout(() => { row.status = 'success'; row.cancellable = false; balance += 50; }, 900);
      return;
    }
    if (url.pathname === '/fixture-result') return ok(res, { created, cancelled, balance });
    if (!/^\/account-lite\/[A-Za-z.-]+$/.test(url.pathname)) { res.writeHead(404); return res.end(); }
    const file = path.join(frontend, url.pathname.slice(1));
    const mime = { '.html': 'text/html', '.mjs': 'text/javascript', '.js': 'text/javascript', '.css': 'text/css' };
    res.writeHead(200, { 'content-type': mime[path.extname(file)] + '; charset=utf-8', 'cache-control': 'no-store' });
    res.end(await readFile(file));
  } catch {
    res.writeHead(500); res.end();
  }
});
server.listen(18169, '127.0.0.1', () => console.log('fixture ready'));
