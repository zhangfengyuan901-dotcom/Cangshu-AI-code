function mountGuide(root) {
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  let index = 0, playing = false, timer;
  root.innerHTML = `<div class="qs-topline"><span><i></i> 仓鼠AI · 新手上路</span><span>操作示意 / 约 35 秒</span></div>
    <nav class="qs-steps" aria-label="使用教程步骤">${steps.map((step, i) => `<button type="button" data-step="${i}" aria-pressed="${i === 0}"><span>0${i + 1}</span><b>${step.name}</b></button>`).join('')}</nav>
    <div class="qs-main"><div class="qs-text"><span class="qs-chapter"></span><h3></h3><p class="qs-description" hidden></p><a href="/#download" class="qs-download-link">前往下载 <span aria-hidden="true">↗</span></a></div>
      <div class="qs-stage"><div class="qs-window"><div class="qs-window-bar"><span><i></i><i></i><i></i></span><span>HAMSTER AI</span><span>✦</span></div><div class="qs-scene" aria-hidden="true"></div></div><span class="qs-stage-label">ILLUSTRATED WALKTHROUGH</span></div></div>
    <div class="qs-controls"><button type="button" class="qs-play">播放教程 <span aria-hidden="true">▷</span></button><div class="qs-progress" aria-hidden="true"><span></span></div><span class="qs-counter" aria-live="polite"></span><button type="button" class="qs-replay" aria-label="从第一步重新播放教程">重播 ↻</button></div>`;
  const play = root.querySelector('.qs-play'), scene = root.querySelector('.qs-scene');
  const buttons = [...root.querySelectorAll('[data-step]')];
  const clear = () => { clearTimeout(timer); timer = undefined; };
  function schedule() {
    clear();
    if (playing) timer = setTimeout(() => {
      if (index < steps.length - 1) { index++; render(); }
      else { playing = false; updatePlayback(); }
    }, 7000);
  }
  function updatePlayback() {
    root.classList.toggle('is-playing', playing);
    root.classList.toggle('is-animated', playing && !motion.matches);
    play.innerHTML = playing ? '暂停教程 <span aria-hidden="true">Ⅱ</span>' : index === 4 ? '再次播放 <span aria-hidden="true">▷</span>' : '播放教程 <span aria-hidden="true">▷</span>';
    play.setAttribute('aria-label', playing ? '暂停教程' : '播放教程');
    schedule();
  }
  function render() {
    const step = steps[index];
    root.dataset.currentStep = String(index);
    root.querySelector('.qs-chapter').textContent = `STEP 0${index + 1} / ${step.name}`;
    root.querySelector('h3').textContent = step.title;
    const description = root.querySelector('.qs-description');
    description.textContent = step.copy;
    description.hidden = !step.copy;
    root.querySelector('.qs-counter').textContent = `${index + 1} / 5`;
    buttons.forEach((button, i) => { button.setAttribute('aria-pressed', String(i === index)); button.classList.toggle('is-complete', i < index); });
    // Replace only the illustration: the focused control always stays in place.
    scene.innerHTML = step.scene;
    updatePlayback();
  }
  const pause = () => { playing = false; updatePlayback(); };
  buttons.forEach((button, i) => button.addEventListener('click', () => { index = i; playing = false; render(); }));
  play.addEventListener('click', () => { if (!playing && index === 4) index = 0; playing = !playing; render(); });
  root.querySelector('.qs-replay').addEventListener('click', () => { index = 0; playing = true; render(); });
  document.addEventListener('visibilitychange', () => { if (document.hidden) pause(); });
  const visibility = new IntersectionObserver(entries => { if (!entries[0].isIntersecting) pause(); }, { threshold: 0 });
  visibility.observe(root);
  motion.addEventListener('change', () => updatePlayback());
  render();
}

document.querySelectorAll('[data-quickstart]').forEach(mountGuide);
document.querySelectorAll('[data-copy-code]').forEach(button => button.addEventListener('click', async () => {
  const status = button.parentElement.querySelector('[data-copy-code-status]');
  try { await navigator.clipboard.writeText(button.dataset.copyCode); status.textContent = '已复制'; }
  catch { status.textContent = '请手动复制：' + button.dataset.copyCode; }
}));
