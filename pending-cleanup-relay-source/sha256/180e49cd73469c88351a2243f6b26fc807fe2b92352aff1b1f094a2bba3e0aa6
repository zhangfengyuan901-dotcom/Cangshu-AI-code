from pathlib import Path
import json
import subprocess
import sys
import uuid

here = Path(__file__).resolve().parent
root = here.parents[1]
binary = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else here / 'backend69-new-api'
scope = "codex.task=relay-payment-current"
network = "pikno-payment-flow-" + uuid.uuid4().hex[:8]
node = "node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402"
go = "golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039"

def docker(*args, timeout=90, check=True):
    return subprocess.run(["docker", *args], capture_output=True, check=check, timeout=timeout)

def bind(source, target):
    return ["--mount", "type=bind,source=" + str(source) + ",target=" + target + ",readonly"]

def main():
    backend = None
    docker("network", "create", "--internal", "--label", scope, network)
    try:
        backend = docker("run", "-d", "--name", network + "-backend", "--network", network,
                         "--network-alias", "backend", "--label", scope, "--read-only",
                         "--tmpfs", "/data:rw,nosuid,size=128m", "--tmpfs", "/tmp:rw,nosuid,size=128m",
                         *bind(binary, "/new-api"), "-w", "/data",
                         "-e", "SQLITE_PATH=/data/payment-fixture.db", "-e", "PIKNO_FIXED_CNY_TOPUP=true",
                         "-e", "PIKNO_LANJING_BRIDGE_INTERNAL_URL=http://bridge:8080",
                         "-e", "PIKNO_LINE_SYNC_ENABLED=false", "-e", "PIKNO_MEDIA_ENABLED=false",
                         "-e", "PIKNO_TOOLS_ENABLED=false", "-e", "PIKNO_REVERSE_ENABLED=false",
                         "-e", "SESSION_SECRET=only-for-this-isolated-payment-fixture",
                         "--entrypoint", "/new-api", go, "--port", "3000", "--log-dir", "/tmp/logs").stdout.decode().strip()
        result = docker("run", "--rm", "--network", network, "--network-alias", "bridge", "--label", scope,
                        "--read-only", "--user", "node",
                        *bind(root / "deploy/lanjing-bridge/server.mjs", "/app/server.mjs"),
                        *bind(here / "bridge-backend-fixture.mjs", "/app/fixture.mjs"),
                        node, "node", "/app/fixture.mjs", timeout=140, check=False)
        evidence = json.loads(result.stdout if result.returncode == 0 else result.stderr)
        (binary.parent / "bridge-backend-fixture-verification.json").write_text(json.dumps(evidence, indent=2) + "\n", encoding="utf-8")
        print(json.dumps(evidence))
        if result.returncode:
            raise SystemExit(result.returncode)
    finally:
        if backend:
            docker("rm", "-f", backend)
        docker("network", "rm", network)

if __name__ == "__main__":
    main()
