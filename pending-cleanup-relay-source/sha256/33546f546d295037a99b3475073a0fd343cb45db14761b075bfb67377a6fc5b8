async (page) => {
  const base = 'https://www.piknoai.com';
  const shots = 'D:/PIKNO/output/playwright/relay-portal-current/';
  const passed = [];
  let writeRequestsObserved = 0, anonymousSessionChecks = 0, pageErrors = 0;
  const anonymousSessionStatuses = [];
  const check = (condition, label) => { if (!condition) throw new Error('Public release check failed: '+label); passed.push(label); };
  page.on('pageerror', () => pageErrors++);
  await page.unroute('**/*');
  page.setDefaultTimeout(60000);
  page.setDefaultNavigationTimeout(60000);
  page.on('request', request => {
    if (['GET','HEAD','OPTIONS'].includes(request.method())) return;
    const url = new URL(request.url());
    if (url.origin === base && url.pathname === '/api/user/auth/refresh') anonymousSessionChecks++;
    else writeRequestsObserved++;
  });
  page.on('response', response => {
    const url = new URL(response.url());
    if (url.origin === base && url.pathname === '/api/user/auth/refresh') anonymousSessionStatuses.push(response.status());
  });
  await page.setViewportSize({width:1440,height:1000});
  await page.goto(base+'/', {waitUntil:'domcontentloaded'});
  await page.locator('.portal-header').waitFor();
  check(await page.locator('h1').count()===1, 'live_portal_home');
  check(await page.getByRole('button',{name:/立即生成|开始生成|Generate now|Run request/}).count()===0,'no_online_generation_action');
  await page.screenshot({path:shots+'live-home-desktop.png',fullPage:true});
  const response = await page.request.get(base+'/api/pikno/catalog');
  check(response.ok(),'live_public_catalog_response');
  const catalog = await response.json();
  check(Array.isArray(catalog?.data?.models),'live_catalog_contract');
  const modelCount = catalog.data.models.length;
  await page.goto(base+'/hub/models', {waitUntil:'domcontentloaded'});
  await page.locator('.portal-header').waitFor();
  if (modelCount > 0) {
    await page.locator('.portal-model-card').first().waitFor();
    check(await page.locator('.portal-model-card').count()===Math.min(modelCount,12),'live_catalog_pagination');
    await page.getByRole('textbox',{name:/搜索模型|Search models/}).fill(catalog.data.models[0].id);
    await page.locator('.portal-model-card').first().waitFor();
    check(await page.locator('.portal-model-card').count()===1,'live_model_search');
    await page.locator('.portal-model-card button').first().click();
    await page.getByRole('dialog').waitFor();
    check(true,'live_model_details');
    await page.keyboard.press('Escape');
    await page.getByRole('dialog').waitFor({state:'hidden'});
  }
  await page.screenshot({path:shots+'live-models-desktop.png',fullPage:true});
  await page.goto(base+'/hub/pricing', {waitUntil:'domcontentloaded'});
  await page.locator('.portal-header').waitFor();
  check(await page.locator('h1').count()===1,'live_pricing_route');
  await page.goto(base+'/hub/docs', {waitUntil:'domcontentloaded'});
  await page.locator('.portal-code code').first().waitFor();
  check((await page.locator('.portal-code code').first().innerText()).includes('/v1/models'),'live_readonly_documentation_example');
  await page.goto(base+'/hub/dashboard', {waitUntil:'domcontentloaded'});
  await page.locator('.portal-account-frame').waitFor();
  const account=page.frameLocator('.portal-account-frame');
  await account.locator('#login-panel').waitFor({state:'visible'});
  check(true,'live_anonymous_account_login_panel');
  check(await account.locator('#login-panel a[target=_top]').count()===3,'live_fixed_authentication_navigation');
  await page.setViewportSize({width:390,height:844});
  await page.goto(base+'/', {waitUntil:'domcontentloaded'});
  await page.locator('.portal-header').waitFor();
  check(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1),'live_mobile_no_horizontal_overflow');
  await page.screenshot({path:shots+'live-home-mobile.png',fullPage:true});
  check(writeRequestsObserved===0,'live_no_business_write_requests');
  check(anonymousSessionChecks>0 && anonymousSessionStatuses.length>0 && anonymousSessionStatuses.every(status=>status===401),'live_anonymous_session_check_only');
  check(pageErrors===0,'live_no_browser_page_errors');
  return {ok:true,checks:passed.length,passed,published_model_count:modelCount,pageErrors,writeRequestsObserved,anonymousSessionChecks,anonymousSessionStatuses,real_generation_calls:0,real_payment_calls:0,customer_login:false,http_cache:'normal_browser_cache'};
}
