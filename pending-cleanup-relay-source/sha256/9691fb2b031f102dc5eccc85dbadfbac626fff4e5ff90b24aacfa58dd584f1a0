STAGE = Path('/opt/piknoai-relay/account71-20261112')
PRIVATE = STAGE / 'private'
APP = 'piknoai-relay-new-api-1'
PG = 'piknoai-relay-postgres-1'
OLD_APP_IMAGE = 'sha256:700408ccd8d1b60c2423bf861dd6ee531b1eba2a4d8207d10526ddeae48fefca'
OLD_APP_BINARY = '84a3c0b9500d9816b15d4fd8b10b3a2a24ca82a31e68885215fd93301ad13f92'
OLD_BRIDGE_IMAGE = 'sha256:3235aff517c6151ae11fb5e5557f4a2365f16f1b89f801e8f318f5592c63fef2'
OLD_BRIDGE_SOURCE = '8aab7808ccd2964c27b683bd0dcbcb723ccf34b43c34fce1a76f46a1f7ea1719'
