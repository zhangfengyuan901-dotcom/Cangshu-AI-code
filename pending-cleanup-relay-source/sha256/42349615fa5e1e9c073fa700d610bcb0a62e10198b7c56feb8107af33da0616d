async (page) => {
 page.setDefaultTimeout(60000);
 const checks=[];const check=(n,v)=>{if(!v)throw new Error(n);checks.push(n)};
 const menu=page.getByRole('menu',{name:'打开菜单'});
 check('dropdown_inherits_popover_color',await menu.evaluate(e=>getComputedStyle(e).backgroundColor)==='rgb(25, 27, 36)');
 await page.getByRole('menuitem',{name:'删除',exact:true}).click();
 const confirm=page.locator('[data-slot="alert-dialog-content"]');
 await confirm.waitFor();
 await page.waitForFunction(()=>{const e=document.querySelector('[data-slot="alert-dialog-content"]');return e&&getComputedStyle(e).opacity==='1'});
 check('confirmation_inherits_popover_color',await confirm.evaluate(e=>getComputedStyle(e).backgroundColor)==='rgb(25, 27, 36)');
 const danger=confirm.getByRole('button',{name:'删除',exact:true});
 check('destructive_action_stays_red',await danger.evaluate(e=>getComputedStyle(e).color)==='rgb(255, 139, 149)');
 await page.screenshot({path:'D:/PIKNO/output/playwright/relay-admin-theme-current/delete-confirmation.png',fullPage:true});
 await confirm.getByRole('button',{name:'取消',exact:true}).click();
 await confirm.waitFor({state:'hidden'});check('confirmation_cancel_closes',true);
 const rows=page.locator('[data-slot="table-body"] > tr');
 const disabled=rows.filter({hasText:'synthetic-ui-5'});
 await page.mouse.move(700,75);
 const readRow=()=>disabled.evaluate(e=>({row:getComputedStyle(e).backgroundColor,lastCell:getComputedStyle(e.lastElementChild).backgroundColor}));
 await page.waitForFunction(()=>{const row=[...document.querySelectorAll('[data-slot="table-body"] > tr')].find(e=>e.textContent.includes('synthetic-ui-5'));return row&&getComputedStyle(row).backgroundColor==='rgb(24, 26, 33)'});
 const before=await readRow();
 await disabled.getByRole('checkbox',{name:'选择行',exact:true}).check();
 await page.mouse.move(700,75);
 await page.waitForFunction(()=>{const row=[...document.querySelectorAll('[data-slot="table-body"] > tr')].find(e=>e.textContent.includes('synthetic-ui-5'));return row&&getComputedStyle(row).backgroundColor===getComputedStyle(row.lastElementChild).backgroundColor});
 const after=await readRow();
 check('disabled_selection_preserves_surface',before.row===after.row&&after.row===after.lastCell);
 await disabled.getByRole('checkbox',{name:'选择行',exact:true}).uncheck();
 const active=rows.filter({hasText:'synthetic-ui-4'});
 await active.getByRole('checkbox',{name:'选择行',exact:true}).check();
 await page.mouse.move(700,75);
 await page.waitForFunction(()=>{const row=[...document.querySelectorAll('[data-slot="table-body"] > tr')].find(e=>e.textContent.includes('synthetic-ui-4'));return row&&getComputedStyle(row).backgroundColor===getComputedStyle(row.lastElementChild).backgroundColor});
 const selected=await active.evaluate(e=>({row:getComputedStyle(e).backgroundColor,lastCell:getComputedStyle(e.lastElementChild).backgroundColor}));
 check('selected_pinned_column_matches_row',selected.row===selected.lastCell);
 await active.getByRole('checkbox',{name:'选择行',exact:true}).uncheck();
 await page.getByRole('link',{name:'线路管理',exact:true}).click();
 await page.getByRole('heading',{name:'线路管理',exact:true}).waitFor();
 await page.getByText('PIKNO 合成图像模型',{exact:true}).first().waitFor();
 await page.screenshot({path:'D:/PIKNO/output/playwright/relay-admin-theme-current/line-management.png',fullPage:true});
 check('line_management_shared_theme',await page.evaluate(()=>document.documentElement.dataset.adminTheme==='pikno'));
 return {passed:true,checks,disabled:{before,after},selected,synthetic:true};
}
