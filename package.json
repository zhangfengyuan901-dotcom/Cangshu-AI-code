{
  "name": "hamster-ai",
  "version": "1.7.5",
  "description": "仓鼠AI本地版",
  "author": "仓鼠AI",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "runtime:build": "node scripts/build-python-runtime.cjs",
    "dist": "node scripts/check-runtime.cjs && electron-builder",
    "test": "node --test tests/*.test.js tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.hamster.ai",
    "productName": "仓鼠AI",
    "files": [
      "server.js",
      "assets.cjs",
      "tasks.cjs",
      "diagnostics.cjs",
      "runtime.cjs",
      "public/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/python-runtime.zip",
        "to": "python-runtime.zip"
      },
      {
        "from": "build/python-runtime.json",
        "to": "python-runtime.json"
      },
      {
        "from": "public",
        "to": "smart-video-agent/studio-ui/shared",
        "filter": [
          "asset-library.mjs",
          "assets.css"
        ]
      },
      {
        "from": "smart-video-agent",
        "to": "smart-video-agent",
        "filter": [
          "**/*",
          "!.venv/**/*",
          "!bin/**/*",
          "!merged_videos/**/*",
          "!**/__pycache__/**/*",
          "!**/.adk/**/*",
          "!studio-data/**/*",
          "!creative-data/**/*",
          "!chat-data/**/*",
          "!.env",
          "!config.yaml"
        ]
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "仓鼠AI-${version}-便携版.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "lucide": "^1.45.0",
    "yauzl": "3.4.0"
  }
}
